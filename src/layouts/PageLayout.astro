---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';

import { getHeaderData, getFooterData } from '~/navigation';
import { defaultLocale, t, type Locale } from '~/i18n';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
  locale?: Locale;
}

const { metadata, locale = defaultLocale } = Astro.props;
---

<Layout metadata={metadata} locale={locale}>
  <a class="fluvio-skip-link" href="#main-content">{t(locale).common.skipToContent}</a>
  <slot name="announcement" />
  <slot name="header">
    <Header {...getHeaderData(locale)} locale={locale} isSticky showToggleTheme />
  </slot>
  <main id="main-content">
    <slot />
  </main>
  <slot name="footer">
    <Footer {...getFooterData(locale)} />
  </slot>
</Layout>
