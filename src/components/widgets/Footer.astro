---
import LinkedInMark from '~/components/common/LinkedInMark.astro';
import Logo from '~/components/Logo.astro';
import { defaultLocale, localeHref, type Locale } from '~/i18n';

export interface Props {
  description: string;
  linkedin: { label: string; href: string };
  copyright: string;
  locale?: Locale;
}

const { description, linkedin, copyright, locale = defaultLocale } = Astro.props;
---

<footer class="site-footer">
  <div class="fluvio-shell footer-inner">
    <a class="footer-brand" href={localeHref('/', locale)}><Logo /></a>
    <p class="footer-description">{description}</p>
    <p class="footer-copyright">{copyright}</p>
    <a class="footer-social" href={linkedin.href} aria-label={linkedin.label} target="_blank" rel="noopener noreferrer">
      <LinkedInMark />
    </a>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--fluvio-footer-surface);
    color: rgb(var(--fluvio-paper));
    border-top: 1px solid rgb(154 205 220 / 0.35);
  }
  .site-footer::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgb(125 186 188), rgb(195 154 91), transparent);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.4rem 1rem;
    padding-block: clamp(1.75rem, 3vw, 2.5rem);
  }

  .footer-brand {
    justify-self: start;
  }

  .footer-brand :global(img) {
    width: auto;
    height: 2.5rem;
    filter: grayscale(1) brightness(0) invert(1);
  }

  .footer-description,
  .footer-copyright {
    grid-column: 1 / -1;
    margin: 0;
    color: rgb(205 224 231);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .footer-social {
    grid-column: 2;
    grid-row: 1;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    color: rgb(205 224 231);
    border-radius: 50%;
    border: 1px solid rgb(205 224 231 / 0.3);
    background: rgb(255 255 255 / 0.06);
  }

  .footer-social:hover {
    color: white;
    background: rgb(125 186 188 / 0.25);
  }

  .footer-inner a:focus-visible {
    outline: 2px solid rgb(154 205 220);
    outline-offset: 3px;
  }

  @media (min-width: 960px) {
    .footer-inner {
      grid-template-columns: auto minmax(0, 1fr) auto auto;
      column-gap: 1.5rem;
    }

    .footer-description,
    .footer-copyright,
    .footer-social {
      grid-column: auto;
      grid-row: auto;
    }

    .footer-description {
      max-width: 52ch;
    }
  }
</style>
