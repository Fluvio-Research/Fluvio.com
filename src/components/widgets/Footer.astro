---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import { defaultLocale, localeHref, type Locale } from '~/i18n';

export interface Props {
  description: string;
  linkedin: { label: string; href: string };
  copyright: string;
  locale?: Locale;
}

const { description, linkedin, copyright, locale = defaultLocale } = Astro.props;
---

<footer class="border-t border-[rgb(var(--fluvio-ink)/0.12)] dark:border-[rgb(var(--fluvio-paper)/0.12)]">
  <div class="fluvio-shell footer-inner">
    <a class="footer-brand" href={localeHref('/', locale)}><Logo /></a>
    <p class="footer-description">{description}</p>
    <p class="footer-copyright">{copyright}</p>
    <a class="footer-social" href={linkedin.href} aria-label={linkedin.label} target="_blank" rel="noopener noreferrer">
      <Icon name="tabler:brand-linkedin" class="w-5 h-5" aria-hidden="true" />
    </a>
  </div>
</footer>

<style>
  .footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.4rem 1rem;
    padding-block: 1.15rem;
  }

  .footer-brand {
    justify-self: start;
  }

  .footer-brand :global(img) {
    width: auto;
    height: 2rem;
  }

  .footer-description,
  .footer-copyright {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--aw-color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .footer-social {
    grid-column: 2;
    grid-row: 1;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    color: var(--aw-color-text-muted);
    border-radius: 0.35rem;
  }

  .footer-social:hover {
    color: var(--aw-color-primary);
    background: rgb(var(--fluvio-river) / 0.08);
  }

  .footer-inner a:focus-visible {
    outline: 2px solid var(--aw-color-primary);
    outline-offset: 3px;
  }

  @media (min-width: 960px) {
    .footer-inner {
      grid-template-columns: auto minmax(0, 1fr) auto auto;
      column-gap: 1.5rem;
    }

    .footer-description,
    .footer-copyright,
    .footer-social {
      grid-column: auto;
      grid-row: auto;
    }

    .footer-description {
      max-width: 52ch;
    }
  }
</style>
