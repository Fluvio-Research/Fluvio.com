---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import LanguagePicker from '~/components/common/LanguagePicker.astro';
import { defaultLocale, localeHref, type Locale } from '~/i18n';
import { getUi } from '~/data/fluvio/store.ts';

interface Link {
  text: string;
  href: string;
}

interface Group extends Link {
  links: Link[];
}

interface Props {
  links: Array<Link | { text: string; groups: Group[] }>;
  contact: Link;
  isSticky?: boolean;
  showToggleTheme?: boolean;
  locale?: Locale;
}

const { links, contact, isSticky, showToggleTheme, locale = defaultLocale } = Astro.props;
const normalize = (path: string) => path.replace(/\/$/, '') || '/';
const current = (href: string) => normalize(Astro.url.pathname) === normalize(href);
const inGroup = (href: string) => current(href) || normalize(Astro.url.pathname).startsWith(`${normalize(href)}/`);
const labels = getUi(locale).header;
---

<fluvio-header>
  <header id="header" class:list={['site-header', { 'site-header--sticky': isSticky }]}>
    <div class="header-inner">
      <a class="brand" href={localeHref('/', locale)}><Logo /></a>

      <button
        class="menu-toggle"
        type="button"
        aria-label={labels.menu}
        aria-expanded="false"
        aria-controls="main-navigation header-preferences"
      >
        <Icon name="tabler:menu-2" class="open-icon" aria-hidden="true" />
        <Icon name="tabler:x" class="close-icon" aria-hidden="true" />
      </button>

      <nav id="main-navigation" class="main-nav" aria-label={labels.navigation}>
        <ul class="top-links">
          {
            links.map((link) => (
              <li>
                {'groups' in link ? (
                  <details
                    class:list={['solutions', { 'solutions--active': link.groups.some(({ href }) => inGroup(href)) }]}
                  >
                    <summary class="nav-link">
                      {link.text}
                      <Icon name="tabler:chevron-down" class="chevron" aria-hidden="true" />
                    </summary>
                    <div class="solutions-panel">
                      <div class="solutions-grid">
                        {link.groups.map((group) => (
                          <div class="solutions-group">
                            <a
                              class="group-link"
                              href={group.href}
                              aria-current={current(group.href) ? 'page' : undefined}
                            >
                              {group.text}
                              <Icon name="tabler:arrow-up-right" class="link-arrow" aria-hidden="true" />
                            </a>
                            <ul>
                              {group.links.map((item) => (
                                <li>
                                  <a
                                    class="solution-link"
                                    href={item.href}
                                    aria-current={current(item.href) ? 'page' : undefined}
                                  >
                                    {item.text}
                                    <Icon name="tabler:arrow-right" class="link-arrow" aria-hidden="true" />
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        ))}
                      </div>
                    </div>
                  </details>
                ) : (
                  <a class="nav-link" href={link.href} aria-current={current(link.href) ? 'page' : undefined}>
                    {link.text}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="header-tools" id="header-preferences">
        {showToggleTheme && <ToggleTheme label={labels.theme} iconClass="w-5 h-5 inline-block" />}
        <LanguagePicker locale={locale} />
      </div>

      <a class="contact-link" href={contact.href} aria-current={current(contact.href) ? 'page' : undefined}>
        {contact.text}
        <Icon name="tabler:arrow-up-right" class="contact-arrow" aria-hidden="true" />
      </a>
    </div>
  </header>
</fluvio-header>

<style>
  fluvio-header {
    display: contents;
  }

  .site-header {
    --header-border: rgb(var(--fluvio-ink) / 0.12);
    --header-surface: var(--fluvio-header-surface);
    --header-hover: rgb(var(--fluvio-river) / 0.1);
    --header-accent: rgb(var(--fluvio-river));
    --menu-surface: rgb(var(--fluvio-paper));
    position: relative;
    z-index: 45;
    color: var(--aw-color-text-heading);
    background: var(--header-surface);
    border-bottom: 1px solid var(--header-border);
    box-shadow: 0 4px 24px rgb(17 45 51 / 0.12);
    backdrop-filter: blur(16px) saturate(1.2);
  }

  :global(.dark) .site-header {
    --header-border: rgb(var(--fluvio-mist) / 0.18);
    --header-surface: var(--fluvio-header-surface);
    --header-hover: rgb(125 186 188 / 0.16);
    --header-accent: rgb(150 214 209);
    --menu-surface: rgb(var(--fluvio-ink));
    box-shadow: 0 8px 28px rgb(0 0 0 / 0.24);
  }

  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: linear-gradient(
      90deg,
      rgb(var(--fluvio-navy)),
      rgb(var(--fluvio-river)) 40%,
      rgb(var(--fluvio-teal)) 72%,
      rgb(var(--fluvio-silt))
    );
  }

  .site-header--sticky {
    position: sticky;
    top: 0;
  }

  .header-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0 0.5rem;
    max-width: 83rem;
    min-height: 4.5rem;
    margin-inline: auto;
    padding: 0.65rem clamp(0.75rem, 3vw, 2rem);
  }

  .brand {
    justify-self: start;
    border-radius: 0.4rem;
  }

  .brand :global(img) {
    height: clamp(2.15rem, 5vw, 3rem);
  }

  .main-nav,
  .header-tools {
    display: none;
  }

  .top-links,
  .solutions-group ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link,
  .group-link,
  .solution-link,
  .menu-toggle,
  .contact-link {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    border-radius: 0.75rem;
    font-size: 0.91rem;
    font-weight: 650;
    text-decoration: none;
  }

  .site-header :is(a, button, summary):focus-visible {
    outline: 2px solid var(--header-accent);
    outline-offset: 3px;
  }

  .nav-link,
  .menu-toggle {
    min-height: 2.75rem;
    padding-inline: 0.85rem;
    white-space: nowrap;
  }

  .nav-link:hover,
  .nav-link[aria-current],
  .solutions--active > summary,
  .solutions[open] > summary,
  .group-link:hover,
  .solution-link:hover,
  .menu-toggle:hover {
    color: var(--header-accent);
    background: var(--header-hover);
  }

  .solutions summary {
    cursor: pointer;
    list-style: none;
  }

  .solutions summary::-webkit-details-marker {
    display: none;
  }

  .chevron,
  .link-arrow,
  .contact-arrow {
    flex: none;
    width: 1rem;
    height: 1rem;
  }

  .solutions[open] .chevron {
    transform: rotate(180deg);
  }

  .solutions-panel {
    margin: 0.2rem 0 0.65rem 0.85rem;
    padding-inline-start: 0.6rem;
    border-inline-start: 1px solid var(--header-border);
  }

  .solutions-grid {
    display: grid;
    gap: 0.75rem;
  }

  .solutions-group {
    min-width: 0;
  }

  .group-link {
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    font-weight: 700;
  }

  .solution-link {
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    font-weight: 500;
  }

  .solution-link[aria-current] {
    color: var(--header-accent);
  }

  .link-arrow {
    margin-inline-start: auto;
    color: var(--header-accent);
  }

  .contact-link {
    justify-self: end;
    padding: 0.65rem clamp(0.65rem, 1.5vw, 1.1rem);
    min-height: 2.75rem;
    border-radius: 999px;
    background: linear-gradient(120deg, #12566a, #17434f);
    color: #fff;
    box-shadow: 0 3px 9px rgb(18 86 106 / 0.24);
    white-space: nowrap;
  }

  .contact-link:hover {
    background: linear-gradient(120deg, #106678, #17434f);
    box-shadow: 0 6px 15px rgb(18 86 106 / 0.34);
  }

  .contact-link[aria-current] {
    outline: 2px solid var(--header-accent);
    outline-offset: 2px;
  }

  .menu-toggle {
    justify-content: center;
    width: 2.75rem;
    padding: 0;
    border: 1px solid var(--header-border);
    cursor: pointer;
  }

  .menu-toggle :global(svg) {
    width: 1.35rem;
    height: 1.35rem;
  }

  .menu-toggle[aria-expanded='false'] .close-icon,
  .menu-toggle[aria-expanded='true'] .open-icon {
    display: none;
  }

  @media (max-width: 959px) {
    .contact-link {
      grid-column: 2;
      grid-row: 1;
    }

    .menu-toggle {
      grid-column: 3;
      grid-row: 1;
    }

    .site-header[data-menu-open] .main-nav {
      display: block;
      grid-row: 2;
      grid-column: 1 / -1;
      max-height: calc(100dvh - 9rem);
      overflow: auto;
      padding: 0.8rem 0.25rem 0.35rem;
      margin-top: 0.65rem;
      border-top: 1px solid var(--header-border);
    }

    .site-header[data-menu-open] .header-tools {
      display: flex;
      grid-row: 3;
      grid-column: 1 / -1;
      align-items: center;
      padding: 0.4rem 0.25rem;
    }

    .solutions summary {
      justify-content: space-between;
    }
  }

  @media (min-width: 960px) {
    .header-inner {
      display: flex;
      gap: clamp(0.45rem, 1.5vw, 1.4rem);
      min-height: 5rem;
    }

    .main-nav,
    .header-tools,
    .top-links {
      display: flex;
      align-items: center;
    }

    .main-nav {
      margin-inline: auto;
    }

    .top-links {
      gap: 0.15rem;
    }

    .solutions > summary {
      position: relative;
    }

    .solutions[open] > summary::after {
      content: '';
      position: absolute;
      inset: auto 0.85rem 0;
      height: 2px;
      background: var(--header-accent);
    }

    .solutions-panel {
      position: absolute;
      inset: 100% 0 auto;
      max-height: calc(100dvh - 5rem);
      overflow: auto;
      margin: 0;
      padding: 0;
      border: 0;
      border-block-end: 1px solid var(--header-border);
      background: var(--menu-surface);
      box-shadow: 0 22px 32px -18px rgb(0 0 0 / 0.28);
    }

    .solutions-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0;
      max-width: 51rem;
      margin-inline: auto;
      padding: 1.25rem 1rem 1.5rem;
    }

    .solutions-group {
      padding-inline: clamp(1rem, 3vw, 2rem);
    }

    .solutions-group + .solutions-group {
      border-inline-start: 1px solid var(--header-border);
    }

    .group-link {
      font-size: 1.125rem;
      margin-bottom: 0.35rem;
    }

    .solution-link {
      min-height: 2.75rem;
    }

    .menu-toggle {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav-link,
    .group-link,
    .solution-link,
    .menu-toggle,
    .contact-link {
      transition:
        background-color 180ms ease,
        color 180ms ease,
        box-shadow 180ms ease;
    }

    .chevron,
    .link-arrow,
    .contact-arrow {
      transition: transform 200ms ease;
    }

    .solutions[open] .solutions-panel,
    .site-header[data-menu-open] .main-nav {
      animation: header-enter 220ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .solution-link:hover .link-arrow {
      transform: translateX(0.2rem);
    }

    .contact-link:hover .contact-arrow {
      transform: translate(0.15rem, -0.15rem);
    }

    @keyframes header-enter {
      from {
        opacity: 0;
        transform: translateY(-0.45rem);
      }
    }
  }
</style>

<script>
  class FluvioHeader extends HTMLElement {
    private listeners?: AbortController;

    connectedCallback() {
      const header = this.querySelector('header')!;
      const solutions = this.querySelector<HTMLDetailsElement>('.solutions');
      const summary = solutions?.querySelector('summary');
      const toggle = this.querySelector<HTMLButtonElement>('.menu-toggle')!;
      const desktop = matchMedia('(min-width: 960px)');
      this.listeners = new AbortController();
      const { signal } = this.listeners;

      const setExpanded = (expanded: boolean) => {
        header.toggleAttribute('data-menu-open', expanded);
        toggle.setAttribute('aria-expanded', String(expanded));
        if (!expanded && solutions) solutions.open = false;
      };

      toggle.addEventListener('click', () => setExpanded(!header.hasAttribute('data-menu-open')), { signal });
      desktop.addEventListener('change', () => setExpanded(false), { signal });

      document.addEventListener(
        'click',
        (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          if (!header.contains(target) || target.closest('a')) {
            setExpanded(false);
          } else if (solutions && !solutions.contains(target)) {
            solutions.open = false;
          }
        },
        { signal }
      );

      solutions?.addEventListener(
        'focusout',
        (event) => {
          if (event.relatedTarget instanceof Node && !solutions.contains(event.relatedTarget)) solutions.open = false;
        },
        { signal }
      );

      header.addEventListener(
        'keydown',
        (event) => {
          if (event.key !== 'Escape') return;
          if (solutions?.open) {
            solutions.open = false;
            summary?.focus();
          } else if (header.hasAttribute('data-menu-open') && !header.querySelector('.fluvio-lang[open]')) {
            setExpanded(false);
            toggle.focus();
          }
        },
        { signal }
      );
    }

    disconnectedCallback() {
      this.listeners?.abort();
    }
  }

  if (!customElements.get('fluvio-header')) customElements.define('fluvio-header', FluvioHeader);
</script>
