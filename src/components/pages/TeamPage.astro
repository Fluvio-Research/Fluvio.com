---
import ArrowLink from '~/components/fluvio/ArrowLink.astro';
import ContactPanel from '~/components/fluvio/ContactPanel.astro';
import LargeImage from '~/components/fluvio/LargeImage.astro';
import PageHero from '~/components/fluvio/PageHero.astro';
import SectionFrame from '~/components/fluvio/SectionFrame.astro';
import SectionHeading from '~/components/fluvio/SectionHeading.astro';
import TeamCard from '~/components/fluvio/TeamCard.astro';
import { REVEAL } from '~/components/fluvio/reveal';
import { getSiteContent, getTeamMembers } from '~/data/fluvio/localized';
import { localeHref, t, type Locale } from '~/i18n';
import Layout from '~/layouts/PageLayout.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = t(locale).teamPage;
const nav = t(locale);
const teamMembers = getTeamMembers(locale);
const siteContent = getSiteContent(locale);

const metadata = {
  title: c.metaTitle,
  description: c.metaDescription,
};
---

<Layout metadata={metadata} locale={locale}>
  <PageHero locale={locale} eyebrow={c.eyebrow} title={c.title} lede={c.lede}>
    <LargeImage
      slot="aside"
      src="~/assets/images/fluvio/team-field-beach.jpeg"
      alt={c.heroImageAlt}
      aspect="wide"
      radius="lg"
      priority
      sizes="(min-width: 1280px) 760px, (min-width: 768px) 55vw, calc(100vw - 2rem)"
    />
  </PageHero>

  <SectionFrame
    tone="paper"
    rule="ink"
    motif="contour"
    labelledby="team-directory-heading"
    class="fluvio-team-directory"
  >
    <div class:list={['fluvio-team-heading', REVEAL]}>
      <SectionHeading id="team-directory-heading" title={c.directoryTitle} intro={c.directoryIntro} align="split" />
    </div>
    <div class="fluvio-team-grid">
      {
        teamMembers.map((member) => (
          <div class={REVEAL}>
            <TeamCard member={member} locale={locale} headingLevel="h2" showBio />
          </div>
        ))
      }
    </div>
  </SectionFrame>

  {/* The team's purpose, over its own photograph. */}
  <section class="fluvio-team-statement" aria-labelledby="team-statement-heading">
    <div class="fluvio-team-statement__media">
      <LargeImage src="~/assets/images/fluvio/team-field-boat.jpg" alt="" aspect="fill" sizes="100vw" />
    </div>
    <div class="fluvio-team-statement__scrim" aria-hidden="true"></div>
    <div class="fluvio-shell fluvio-team-statement__copy">
      <p class="fluvio-team-statement__eyebrow">{siteContent.name}</p>
      <h2 id="team-statement-heading" class={REVEAL}>{siteContent.summary}</h2>
      <div class={REVEAL}>
        <ArrowLink href={localeHref('/vision', locale)} variant="ghost" tone="paper"
          >{nav.visionPage.metaTitle}</ArrowLink
        >
      </div>
    </div>
  </section>

  <SectionFrame tone="warm">
    <div class={REVEAL}>
      <ContactPanel locale={locale} eyebrow="" title={c.contactTitle} intro={c.contactIntro} />
    </div>
  </SectionFrame>
</Layout>

<style>
  .fluvio-team-heading {
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .fluvio-team-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 4rem) clamp(1rem, 3vw, 2.5rem);
  }

  .fluvio-team-statement {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(26rem, 64vh, 40rem);
    overflow: hidden;
    color: rgb(var(--fluvio-paper));
  }

  .fluvio-team-statement__media {
    position: absolute;
    inset: 0;
  }

  .fluvio-team-statement__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      6deg,
      rgb(var(--fluvio-ink) / 0.84) 0%,
      rgb(var(--fluvio-ink) / 0.4) 45%,
      rgb(var(--fluvio-ink) / 0.05) 80%
    );
  }

  .fluvio-team-statement__copy {
    position: relative;
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    padding: clamp(5rem, 12vh, 8rem) 0 clamp(2.5rem, 6vw, 4.5rem);
  }

  .fluvio-team-statement__eyebrow {
    margin: 0;
    color: rgb(var(--fluvio-wash));
    font-family: var(--aw-font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .fluvio-team-statement h2 {
    margin: 0;
    max-width: 22ch;
    color: inherit;
    font-family: var(--aw-font-heading);
    font-size: clamp(1.8rem, 3.8vw, 3.4rem);
    font-weight: 520;
    letter-spacing: -0.025em;
    line-height: 1.1;
    text-wrap: balance;
  }

  .fluvio-team-statement :global(.fluvio-arrow-link) {
    backdrop-filter: blur(10px);
  }

  @media (min-width: 768px) {
    .fluvio-team-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
