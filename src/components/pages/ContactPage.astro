---
import Accent from '~/components/fluvio/Accent.astro';
import ArrowLink from '~/components/fluvio/ArrowLink.astro';
import LargeImage from '~/components/fluvio/LargeImage.astro';
import PageHero from '~/components/fluvio/PageHero.astro';
import SectionFrame from '~/components/fluvio/SectionFrame.astro';
import { REVEAL } from '~/components/fluvio/reveal';
import { getNavigation } from '~/data/fluvio/store.ts';
import { t, type Locale } from '~/i18n';
import Layout from '~/layouts/PageLayout.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = t(locale).contactPage;
const navigation = getNavigation(locale);

const metadata = {
  title: c.metaTitle,
  description: c.metaDescription,
};

const mailtoHref = `mailto:?subject=${encodeURIComponent(c.enquirySubject)}&body=${encodeURIComponent(c.enquiryTemplate)}`;
---

<Layout metadata={metadata} locale={locale}>
  <PageHero locale={locale} eyebrow={c.eyebrow} title={c.title} lede={c.lede}>
    <LargeImage
      slot="aside"
      src="~/assets/images/fluvio/contact-river-gorge.jpeg"
      alt={c.heroImageAlt}
      aspect="wide"
      radius="lg"
      priority
      sizes="(min-width: 1280px) 760px, (min-width: 768px) 55vw, calc(100vw - 2rem)"
    />
  </PageHero>

  <SectionFrame tone="paper" rule="ink" motif="contour" labelledby="contact-enquiry-heading">
    <div class="fluvio-contact-grid">
      <h2 id="contact-enquiry-heading" class:list={['fluvio-display', REVEAL]}><Accent text={c.enquiryTitle} /></h2>
      <div class:list={['fluvio-contact-body', REVEAL]}>
        <p>{c.enquiryBody}</p>
        <ArrowLink href={mailtoHref} variant="pill">{c.enquiryAction}</ArrowLink>
        <p class="fluvio-contact-note">{c.enquiryNote}</p>
      </div>
    </div>
  </SectionFrame>

  <SectionFrame tone="mist" rule="ink" labelledby="contact-social-heading">
    <div class="fluvio-contact-grid">
      <h2 id="contact-social-heading" class:list={['fluvio-display', REVEAL]}><Accent text={c.socialTitle} /></h2>
      <div class:list={['fluvio-contact-body', REVEAL]}>
        <p>{c.socialBody}</p>
        <ArrowLink href={navigation.linkedinUrl} external variant="ghost" tone="ink">{c.socialAction}</ArrowLink>
      </div>
    </div>
  </SectionFrame>
</Layout>

<style>
  .fluvio-contact-grid {
    display: grid;
    gap: 2rem;
  }

  .fluvio-contact-body {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .fluvio-contact-body > p:first-child {
    margin: 0;
    max-width: 42rem;
    color: var(--aw-color-text-muted);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .fluvio-contact-note {
    margin: 0.25rem 0 0;
    max-width: 42rem;
    color: var(--aw-color-text-muted);
    font-size: 0.82rem;
    line-height: 1.65;
  }

  @media (min-width: 768px) {
    .fluvio-contact-grid {
      grid-template-columns: minmax(15rem, 0.65fr) minmax(24rem, 1.35fr);
      gap: clamp(4rem, 10vw, 10rem);
      align-items: start;
    }
  }
</style>
