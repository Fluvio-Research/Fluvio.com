---
import EnquiryForm from '~/components/fluvio/EnquiryForm.astro';
import Accent from '~/components/fluvio/Accent.astro';
import floodVideo from '~/assets/images/fluvio/project-laidley-flood.mp4?url';
import floodPoster from '~/assets/images/fluvio/contact-flood-poster.jpg';
import SectionFrame from '~/components/fluvio/SectionFrame.astro';
import { REVEAL } from '~/components/fluvio/reveal';
import { t, type Locale } from '~/i18n';
import Layout from '~/layouts/PageLayout.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = t(locale).contactPage;

const metadata = {
  title: c.metaTitle,
  description: c.metaDescription,
};
---

<Layout metadata={metadata} locale={locale}>
  <fluvio-contact-hero class="contact-hero" data-play={t(locale).slider.resume} data-pause={t(locale).slider.pause}>
    <video
      class="contact-hero__video"
      muted
      loop
      playsinline
      preload="metadata"
      poster={floodPoster.src}
      aria-hidden="true"
      tabindex="-1"
    >
      <source src={floodVideo} type="video/mp4" />
    </video>
    <div class="contact-hero__shade" aria-hidden="true"></div>
    <div class="fluvio-shell contact-hero__content">
      <p class="fluvio-eyebrow">{c.eyebrow}</p>
      <h1 class="fluvio-title"><Accent text={c.title} /></h1>
      <p class="contact-hero__lede">{c.lede}</p>
      <button type="button" class="contact-hero__playback" hidden>{t(locale).slider.pause}</button>
    </div>
  </fluvio-contact-hero>

  <SectionFrame tone="paper" rule="ink" motif="contour" labelledby="contact-enquiry-heading">
    <div class="fluvio-contact-grid enquiry-layout">
      <div class="enquiry-intro">
        <p class="fluvio-eyebrow">{c.eyebrow}</p>
        <h2 id="contact-enquiry-heading" class="fluvio-display"><Accent text={c.enquiryTitle} /></h2>
        <p>{c.enquiryBody}</p>
        <p class="contact-office">{c.enquiryNote}</p>
      </div>
      <div class:list={['fluvio-contact-body', 'enquiry-card', REVEAL]}>
        <EnquiryForm locale={locale} />
      </div>
    </div>
  </SectionFrame>
</Layout>

<script>
  class FluvioContactHero extends HTMLElement {
    private cleanup?: () => void;
    connectedCallback() {
      const video = this.querySelector('video')!;
      const button = this.querySelector('button')!;
      video.muted = true;
      video.defaultMuted = true;
      const motion = matchMedia('(prefers-reduced-motion: reduce)');
      let paused = motion.matches;
      let visible = false;
      const update = () => {
        if (paused || !visible || document.hidden) video.pause();
        else if (video.paused)
          video.play().catch((error: DOMException) => {
            // Visibility changes and Astro navigation can interrupt a pending play.
            // An interrupted request must not become a persistent user pause.
            if (error.name === 'AbortError' || !this.isConnected) return;
            paused = true;
            render();
          });
        render();
      };
      const render = () => {
        button.textContent = paused ? this.dataset.play! : this.dataset.pause!;
      };
      const toggle = () => {
        paused = !paused;
        update();
      };
      const preference = () => {
        paused = motion.matches;
        update();
      };
      const observer = new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        update();
      });
      observer.observe(this);
      button.hidden = false;
      button.addEventListener('click', toggle);
      video.addEventListener('canplay', update);
      motion.addEventListener('change', preference);
      document.addEventListener('visibilitychange', update);
      this.cleanup = () => {
        observer.disconnect();
        video.pause();
        button.removeEventListener('click', toggle);
        video.removeEventListener('canplay', update);
        motion.removeEventListener('change', preference);
        document.removeEventListener('visibilitychange', update);
      };
      update();
    }
    disconnectedCallback() {
      this.cleanup?.();
    }
  }
  if (!customElements.get('fluvio-contact-hero')) customElements.define('fluvio-contact-hero', FluvioContactHero);
</script>

<style>
  .contact-hero {
    display: grid;
    align-items: center;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: clamp(29rem, 65svh, 43rem);
    background: rgb(var(--fluvio-ink));
    color: white;
  }
  .contact-hero__video,
  .contact-hero__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }
  .contact-hero__video {
    object-fit: cover;
  }
  .contact-hero__shade {
    background:
      linear-gradient(90deg, rgb(8 26 38 / 0.87), rgb(8 26 38 / 0.64) 52%, rgb(8 26 38 / 0.28)),
      linear-gradient(0deg, rgb(8 26 38 / 0.45), transparent 50%);
  }
  .contact-hero__content {
    padding-block: clamp(3rem, 7vw, 6rem);
  }
  .contact-hero .fluvio-eyebrow {
    color: rgb(174 225 231);
  }
  .contact-hero .fluvio-title {
    color: white;
    max-width: 18ch;
    text-wrap: balance;
  }
  .contact-hero__lede {
    max-width: 38rem;
    margin-top: 1.5rem;
    font-size: var(--fluvio-lede-size);
    line-height: var(--fluvio-body-leading);
    color: rgb(231 240 244);
  }
  .contact-hero__playback {
    margin-top: 2rem;
    padding: 0.55rem 1rem;
    border: 1px solid rgb(255 255 255 / 0.4);
    border-radius: 999px;
    background: rgb(8 26 38 / 0.4);
    color: white;
    font-size: 0.8rem;
    cursor: pointer;
  }
  .contact-hero__playback:hover {
    background: rgb(255 255 255 / 0.15);
  }
  .contact-hero__playback:focus-visible {
    outline: 2px solid white;
    outline-offset: 4px;
  }
  @media (max-width: 767px) {
    .contact-hero__shade {
      background: rgb(8 26 38 / 0.65);
    }
  }

  .fluvio-contact-grid {
    display: grid;
    gap: 2rem;
  }

  .fluvio-contact-body {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .fluvio-contact-body > p:first-child {
    margin: 0;
    max-width: 42rem;
    color: var(--aw-color-text-muted);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .enquiry-intro {
    display: grid;
    gap: 1.5rem;
    padding-top: 0.5rem;
  }
  .enquiry-intro h2 {
    max-width: 12ch;
  }
  .enquiry-intro > p:not(.fluvio-eyebrow) {
    color: var(--aw-color-text-muted);
    line-height: 1.75;
    max-width: 32ch;
  }
  .enquiry-intro > .contact-office {
    border-top: 1px solid rgb(var(--fluvio-river) / 0.25);
    padding-top: 1.25rem;
    font-weight: 600;
    color: var(--aw-color-text-default);
  }

  .enquiry-card {
    min-width: 0;
    padding: clamp(1rem, 4vw, 2.5rem);
    border: 1px solid rgb(var(--fluvio-river) / 0.24);
    border-radius: 1.25rem;
    background: var(--aw-color-bg-page);
    box-shadow: 0 20px 65px rgb(17 45 51 / 0.07);
    border-top: 3px solid rgb(var(--fluvio-river));
  }

  :global(.dark) .enquiry-card {
    border-color: rgb(var(--fluvio-mist) / 0.2);
  }

  @media (min-width: 768px) {
    .fluvio-contact-grid {
      grid-template-columns: minmax(15rem, 0.65fr) minmax(24rem, 1.35fr);
      gap: var(--fluvio-column-gap);
      align-items: start;
    }
  }
</style>
