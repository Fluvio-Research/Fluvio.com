---
import ArrowLink from '~/components/fluvio/ArrowLink.astro';
import Accent from '~/components/fluvio/Accent.astro';
import ContactPanel from '~/components/fluvio/ContactPanel.astro';
import ExpertiseCard from '~/components/fluvio/ExpertiseCard.astro';
import PageHero from '~/components/fluvio/PageHero.astro';
import SectionFrame from '~/components/fluvio/SectionFrame.astro';
import SectionHeading from '~/components/fluvio/SectionHeading.astro';
import { REVEAL } from '~/components/fluvio/reveal';
import { getExpertiseAreas } from '~/data/fluvio/localized';
import { localeHref, t, type Locale } from '~/i18n';
import Layout from '~/layouts/PageLayout.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = t(locale).expertisePage;
const expertiseAreas = getExpertiseAreas(locale);

const metadata = {
  title: c.metaTitle,
  description: c.metaDescription,
};
---

<Layout metadata={metadata} locale={locale}>
  <PageHero locale={locale} eyebrow={c.eyebrow} title={c.title} lede={c.lede} />

  <SectionFrame tone="paper" rule="ink" motif="contour" ariaLabel={c.areasLabel} class="fluvio-expertise-areas">
    <div class:list={['fluvio-expertise-heading', REVEAL]}>
      <SectionHeading title={c.introTitle} intro={c.introIntro} align="split" />
    </div>
    <div class="fluvio-expertise-grid">
      {
        expertiseAreas.map((area, index) => (
          <div class:list={['fluvio-expertise-grid__cell', REVEAL]}>
            <ExpertiseCard
              area={area}
              locale={locale}
              index={index}
              headingLevel="h2"
              projectCount={area.relatedProjects.length}
              priority={index < 2}
            />
          </div>
        ))
      }
    </div>
  </SectionFrame>

  <SectionFrame tone="water" rule="ink" motif="grid" labelledby="expertise-team-heading">
    <div class="fluvio-expertise-team">
      <h2 id="expertise-team-heading" class:list={['fluvio-display', REVEAL]}><Accent text={c.teamTitle} /></h2>
      <div class={REVEAL}>
        <p>{c.teamBody}</p>
        <ArrowLink href={localeHref('/team', locale)} variant="pill" tone="ink">{c.teamLink}</ArrowLink>
      </div>
    </div>
  </SectionFrame>

  <SectionFrame tone="warm">
    <div class={REVEAL}>
      <ContactPanel locale={locale} />
    </div>
  </SectionFrame>
</Layout>

<style>
  .fluvio-expertise-heading {
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .fluvio-expertise-grid {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .fluvio-expertise-team {
    display: grid;
    gap: 2.5rem;
  }

  .fluvio-expertise-team h2 {
    max-width: 15ch;
  }

  .fluvio-expertise-team p {
    margin: 0 0 1.75rem;
    max-width: 42rem;
    color: var(--aw-color-text-muted);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  @media (min-width: 768px) {
    .fluvio-expertise-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    /* A 7 / 5 rhythm so the grid reads as a composition, not a table. */
    .fluvio-expertise-grid__cell {
      grid-column: span 7;
    }

    .fluvio-expertise-grid__cell:nth-child(4n + 2),
    .fluvio-expertise-grid__cell:nth-child(4n + 3) {
      grid-column: span 5;
    }

    .fluvio-expertise-team {
      grid-template-columns: minmax(0, 0.9fr) minmax(24rem, 1.1fr);
      gap: clamp(4rem, 10vw, 10rem);
      align-items: end;
    }
  }
</style>
