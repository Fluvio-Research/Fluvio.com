---
import senseLogo from '~/assets/images/fluvio/fluviosense-logo.png';
import senseLogoDark from '~/assets/images/fluvio/fluviosense-logo-dark.png';
import Layout from '~/layouts/PageLayout.astro';
import OverviewHero from '~/components/fluvio/OverviewHero.astro';
import SectionFrame from '~/components/fluvio/SectionFrame.astro';
import LargeImage from '~/components/fluvio/LargeImage.astro';
import ArrowLink from '~/components/fluvio/ArrowLink.astro';
import FluxMedia from '~/components/fluvio/FluxMedia.astro';
import ProductAnalysisVideo from '~/components/fluvio/ProductAnalysisVideo.astro';
import PlatformFeature from '~/components/fluvio/PlatformFeature.astro';
import ScreenshotGallery from '~/components/fluvio/ScreenshotGallery.astro';
import TeamCard from '~/components/fluvio/TeamCard.astro';
import { getTeamMembers } from '~/data/fluvio/localized';
import ContactPanel from '~/components/fluvio/ContactPanel.astro';
import { getCatalog, getHomepage } from '~/data/fluvio/store.ts';
import { localeHref, t, type Locale } from '~/i18n';
export interface Props {
  locale: Locale;
  kind: 'products' | 'systems' | 'fluviosense';
}
const { locale, kind } = Astro.props;
const c = getCatalog(locale);
const louis = getTeamMembers(locale).find((member) => member.slug === 'louis-ray');
const products = kind === 'products';
const sense = kind === 'fluviosense';
const platforms = getHomepage(locale).platforms;
const title = products ? c.productsTitle : sense ? platforms.sense.title : c.systemsTitle;
const intro = products ? c.productsIntro : sense ? platforms.sense.description : c.systemsIntro;
const label = products ? c.productsLabel : sense ? platforms.sense.title : c.systemsLabel;
const items = products ? c.products : c.systems;
// Overview cards use isolated instruments; detail sections retain field photography.
const productCardImages: Record<string, string> = {
  'fs-halo': '~/assets/images/fluvio/fs-halo-cutout.png',
  'fs-flux': '~/assets/images/fluvio/fs-flux-cutout.png',
};
const systemPlatforms = [
  { id: 'fluviosense', platform: platforms.sense },
  { id: 'reef', platform: platforms.reef },
  { id: 'pulse', platform: platforms.cascade },
];
---

<Layout locale={locale} metadata={{ title: label, description: intro }}>
  <OverviewHero
    eyebrow={`Fluvio / ${label}`}
    title={title}
    titleLogo={sense ? { light: senseLogo, dark: senseLogoDark } : undefined}
    intro={intro}
    label={label}
    items={products || sense
      ? items.map((item, index) => ({
          name: item.name,
          href: `#${item.slug}`,
          image: products ? (productCardImages[item.slug] ?? item.image) : item.image,
          contain: products || index < 2,
        }))
      : systemPlatforms.map(({ id, platform }) => ({
          name: platform.title,
          href: `#${id}`,
          image: platform.image,
          contain: true,
        }))}
  />
  {
    !products &&
      !sense &&
      systemPlatforms.map(({ id, platform }, index) => (
        <SectionFrame tone={index === 1 ? 'mist' : 'paper'} rule="ink">
          <div class="catalog-platform" id={id}>
            <PlatformFeature
              {...platform}
              href={id === 'fluviosense' ? localeHref('/systems/fluviosense', locale) : platform.href}
              imageHref={id === 'fluviosense' ? localeHref('/systems/fluviosense', locale) : platform.href}
              actionLabel={id === 'fluviosense' ? platform.title : platform.action}
              highlights={
                id === 'fluviosense'
                  ? platform.highlights?.filter((line) => !/FlowSense|FloodSense|NodeSense/i.test(line))
                  : platform.highlights
              }
              locale={locale}
              index={index}
            />
          </div>
        </SectionFrame>
      ))
  }
  {
    (products || sense) &&
      items.map((item, index) => (
        <SectionFrame tone={index === 1 ? 'water' : 'paper'} rule="ink" labelledby={`${item.slug}-heading`}>
          <article
            id={item.slug}
            class:list={[
              'catalog-feature',
              { 'catalog-feature--reverse': products && index % 2 === 1, 'catalog-feature--module': sense },
            ]}
          >
            <div class="catalog-feature__media">
              {sense ? (
                <ScreenshotGallery
                  screens={[{ image: item.image, imageAlt: item.imageAlt }, ...(item.screens ?? [])]}
                  label={item.name}
                />
              ) : products && (item.slug === 'fs-spot' || item.slug === 'fs-halo') ? (
                <ProductAnalysisVideo product={item.slug} locale={locale} />
              ) : (
                <LargeImage
                  src={item.image}
                  alt={item.imageAlt}
                  aspect="landscape"
                  radius="lg"
                  sizes="(min-width:900px) 50vw, 95vw"
                />
              )}
            </div>
            <div class="catalog-feature__copy">
              <p class="fluvio-label">
                0{index + 1} / {label}
              </p>
              <h2 id={`${item.slug}-heading`}>{item.name}</h2>
              <>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </>
              <ul>
                {item.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
              <div class="catalog-actions">
                <ArrowLink href={localeHref('/contact', locale)}>{c.contactLabel}</ArrowLink>
                {(!products || (item.slug !== 'fs-spot' && item.slug !== 'fs-halo')) && (
                  <ArrowLink href={localeHref(item.href, locale)}>{c.fieldAction}</ArrowLink>
                )}
              </div>
            </div>
          </article>
          {products && item.slug === 'fs-flux' && <FluxMedia locale={locale} />}
          {products && item.slug === 'fs-flux' && louis && (
            <div class="catalog-specialist">
              <h3>{t(locale).expertiseDetail.teamTitle}</h3>
              <TeamCard member={louis} locale={locale} variant="compact" headingLevel="h4" />
            </div>
          )}
        </SectionFrame>
      ))
  }
  <SectionFrame tone="mist" spacing="compact"
    ><ArrowLink href={localeHref(products || sense ? '/systems' : '/products', locale)}
      >{products || sense ? c.systemsAction : c.productsAction}</ArrowLink
    ></SectionFrame
  >
  <SectionFrame tone="warm"><ContactPanel locale={locale} /></SectionFrame>
</Layout>
<style>
  .catalog-specialist {
    margin-top: 3rem;
    max-width: 20rem;
  }
  .catalog-specialist h3 {
    margin-bottom: 1.5rem;
    font-size: 1.4rem;
  }
  .catalog-platform {
    scroll-margin-top: 7rem;
  }

  .catalog-feature {
    display: grid;
    gap: var(--fluvio-column-gap);
    align-items: center;
    scroll-margin-top: 7rem;
  }
  .catalog-feature__copy h2 {
    font-family: var(--aw-font-heading);
    font-size: var(--fluvio-section-size);
    font-weight: var(--fluvio-section-weight);
    letter-spacing: var(--fluvio-heading-tracking);
    line-height: var(--fluvio-heading-leading);
    margin: 1rem 0;
  }
  .catalog-feature__copy h3 {
    font-family: var(--aw-font-heading);
    font-size: var(--fluvio-feature-size);
    line-height: 1.25;
    margin: 1.5rem 0 1rem;
  }
  .catalog-feature__copy p:not(.fluvio-label) {
    color: var(--aw-color-text-muted);
    font-size: 1rem;
    line-height: 1.75;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 1.75rem 0;
  }
  li {
    border-top: 1px solid rgb(var(--fluvio-ink) / 0.15);
    padding: 0.8rem 0;
    font-size: 0.9rem;
  }
  .catalog-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }
  @media (min-width: 900px) {
    .catalog-feature {
      grid-template-columns: 1.1fr 1fr;
    }
    .catalog-feature--reverse .catalog-feature__media {
      order: 2;
    }
  }
</style>

<style>
  .catalog-feature--module {
    grid-template-columns: minmax(0, 1fr);
  }
  .catalog-feature--module .catalog-feature__media {
    order: 2;
    min-width: 0;
  }
  .catalog-feature--module .catalog-feature__copy {
    max-width: none;
  }
  @media (min-width: 900px) {
    .catalog-feature--module .catalog-feature__copy {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 3rem;
    }
    .catalog-feature--module .catalog-feature__copy > .fluvio-label,
    .catalog-feature--module h2 {
      grid-column: 1 / -1;
    }
    .catalog-feature--module ul {
      grid-column: 2;
      grid-row: 3 / 5;
      margin-top: 1.5rem;
    }
  }
</style>
