---
import ArrowLink from '~/components/fluvio/ArrowLink.astro';
import HeroSlider from '~/components/fluvio/HeroSlider.astro';
import LargeImage from '~/components/fluvio/LargeImage.astro';
import { getCatalog, getHomepage, getSiteContent, getUi } from '~/data/fluvio/store.ts';
import { localeHref, type Locale } from '~/i18n';
import Layout from '~/layouts/PageLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const home = getHomepage(locale);
const catalog = getCatalog(locale);
const metadata = {
  title: getSiteContent(locale).name,
  description: home.metaDescription,
  ignoreTitleTemplate: true,
};

const copy = getUi(locale).overview;

const imageBase = '~/assets/images/fluvio/';
const views = [
  {
    title: home.expertiseEyebrow,
    description: copy.expertise,
    href: '/expertise',
    action: home.expertiseMore,
    kind: 'field',
    images: ['project-bina-gauging.png', 'home-expertise-camera-scan.png', 'team-field-boat.jpg'].map(
      (name) => imageBase + name
    ),
  },
  {
    title: catalog.productsLabel,
    description: copy.products,
    href: '/products',
    action: catalog.productsAction,
    imageAlts: ['FS-Spot', 'FS-Flux', 'FS-Halo'],
    kind: 'hardware',
    images: ['fs-spot.png', 'fs-flux-cutout.png', 'fs-halo-cutout.png'].map((name) => imageBase + name),
  },
  {
    title: catalog.systemsLabel,
    description: copy.systems,
    href: '/systems',
    action: catalog.systemsAction,
    kind: 'dashboard',
    images: [home.platforms.sense.image, home.platforms.cascade.image, home.platforms.reef.image],
    imageAlts: [home.platforms.sense.title, home.platforms.cascade.title, home.platforms.reef.title],
  },
];
---

<Layout metadata={metadata} locale={locale}>
  <HeroSlider locale={locale} />

  <fluvio-overview>
    <section class="home-overview" aria-labelledby="home-overview-title">
      <div class="overview-inner">
        <header class="overview-intro">
          <h2 id="home-overview-title" class="fluvio-display">{copy.title}</h2>
          <p>{copy.intro}</p>
        </header>

        <div class="overview-grid">
          {
            views.map((view) => (
              <section
                class:list={['overview-view', `overview-view--${view.kind}`]}
                id={`overview-${view.kind}`}
                data-panel={view.kind}
              >
                <div class="view-copy">
                  <h3 class="view-heading">{view.title}</h3>
                  <p>{view.description}</p>
                  <ArrowLink href={localeHref(view.href, locale)} variant="text" size="sm">
                    {view.action}
                  </ArrowLink>
                </div>

                <div class="visual-stage">
                  {view.images.map((image, index) => (
                    <button
                      type="button"
                      class="image-control"
                      aria-label={view.imageAlts?.[index] ?? `${view.title} ${index + 1}`}
                      aria-pressed={index === 1}
                    >
                      <LargeImage
                        src={image}
                        alt={view.imageAlts?.[index] ?? ''}
                        aspect="fill"
                        radius="none"
                        sizes="(min-width: 800px) 360px, 75vw"
                      />
                      {view.kind === 'hardware' && <span class="product-caption">{view.imageAlts?.[index]}</span>}
                    </button>
                  ))}
                </div>
              </section>
            ))
          }
        </div>
      </div>
    </section>
  </fluvio-overview>
</Layout>

<style>
  fluvio-overview {
    display: block;
  }
  .home-overview {
    padding-block: var(--fluvio-section-standard);
  }
  .overview-inner {
    width: min(80rem, calc(100% - 2rem));
    margin: auto;
  }
  .overview-intro {
    max-width: 52rem;
    margin: 0 auto 2rem;
    text-align: center;
  }
  .overview-intro p {
    max-width: 43rem;
    margin: 1rem auto;
    color: var(--aw-color-text-muted);
    font-size: 1.1rem;
    line-height: 1.6;
  }
  .overview-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 4rem);
  }
  .overview-view {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 2;
    min-width: 0;
    gap: 1.5rem;
    text-align: center;
  }
  .view-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .view-copy :global(a) {
    margin-top: auto;
  }
  .view-heading {
    margin: 0;
    font-family: var(--aw-font-heading);
    font-size: var(--fluvio-section-size);
    font-weight: var(--fluvio-section-weight);
    letter-spacing: var(--fluvio-heading-tracking);
    line-height: 1;
  }
  .view-copy p {
    max-width: 29ch;
    margin: 0.85rem 0 1.25rem;
    color: var(--aw-color-text-muted);
    font-size: clamp(0.9rem, 1.3vw, 1.05rem);
    line-height: 1.6;
  }
  .visual-stage {
    position: relative;
    height: clamp(13rem, 23vw, 20rem);
    margin: 0 0.5rem;
    isolation: isolate;
    perspective: 1000px;
  }
  .visual-stage :global(.image-control) {
    position: absolute;
    width: 40%;
    height: 64%;
    top: 12%;
    left: 2%;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 12px 28px rgb(16 37 48 / 0.18);
    transform: rotate(-7deg);
  }
  .visual-stage :global(.image-control:nth-child(2)) {
    z-index: 2;
    width: 48%;
    height: 74%;
    top: 24%;
    left: 26%;
    transform: rotate(2deg);
  }
  .visual-stage :global(.image-control:nth-child(3)) {
    width: 43%;
    left: 55%;
    top: 4%;
    transform: rotate(7deg);
  }
  /* Separate display bays keep every silhouette clear, including during motion. */
  .overview-view--hardware .visual-stage {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: 1fr 1fr;
    gap: 1rem 0.75rem;
    margin: 0;
    animation: none !important;
    transform: none;
  }
  .overview-view--hardware .visual-stage :global(.image-control) {
    position: relative;
    inset: auto;
    width: 100%;
    height: 100%;
    min-height: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 0.4rem;
    padding: 0.65rem 0.6rem 0;
    transform: none;
    overflow: visible;
    border-radius: 0.75rem;
    box-shadow: none;
    z-index: auto;
  }
  .overview-view--hardware .visual-stage :global(.image-control:nth-child(1)) {
    grid-column: 1;
    grid-row: 1;
  }
  .overview-view--hardware .visual-stage :global(.image-control:nth-child(3)) {
    grid-column: 2;
    grid-row: 1;
  }
  .overview-view--hardware .visual-stage :global(.image-control:nth-child(2)) {
    grid-column: 1 / -1;
    grid-row: 2;
    width: 65%;
    justify-self: center;
  }
  .overview-view--hardware .visual-stage :global(.fluvio-image__frame) {
    overflow: visible;
    background: transparent;
  }
  .overview-view--hardware .visual-stage :global(figure) {
    min-height: 0;

    transform-origin: 50% 75%;
  }
  .overview-view--hardware .visual-stage :global(img) {
    object-fit: contain !important;
  }
  .product-caption {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--aw-color-text-muted);
    transition: color 0.3s ease;
  }
  .image-control[aria-pressed='true'] .product-caption {
    color: rgb(var(--fluvio-river));
  }
  @media (prefers-reduced-motion: no-preference) {
    .overview-view--hardware .image-control :global(figure) {
      animation: product-hover 7s ease-in-out infinite paused;
      transition: filter 0.5s ease;
    }
    fluvio-overview[data-visible] .overview-view--hardware .image-control :global(figure) {
      animation-play-state: running;
    }
    .overview-view--hardware .image-control:nth-child(2) :global(figure) {
      animation-delay: -2.3s;
    }
    .overview-view--hardware .image-control:nth-child(3) :global(figure) {
      animation-delay: -4.6s;
    }
    .overview-view--hardware .image-control:is(:hover, :focus-visible) :global(figure) {
      animation-play-state: paused;
    }
    @keyframes product-hover {
      0%,
      100% {
        transform: perspective(900px) translateY(0) rotateX(1deg) rotateY(-3deg);
      }
      50% {
        transform: perspective(900px) translateY(-6px) rotateX(-1deg) rotateY(3deg);
      }
    }
  }
  .overview-view--dashboard .visual-stage :global(.image-control) {
    border: 3px solid var(--fluvio-screen-border);
    width: 65%;
    height: 60%;
    left: 0;
    top: 0;
    transform: rotate(-5deg);
  }
  .overview-view--dashboard .visual-stage :global(.image-control:nth-child(2)) {
    width: 68%;
    height: 62%;
    top: 20%;
    left: 16%;
    transform: rotate(1deg);
  }
  .overview-view--dashboard .visual-stage :global(.image-control:nth-child(3)) {
    width: 62%;
    height: 55%;
    top: 45%;
    left: 36%;
    transform: rotate(6deg);
  }
  .overview-view--field .image-control:nth-child(2) :global(img) {
    object-position: 72% center;
  }

  .overview-view--dashboard .visual-stage :global(img) {
    object-position: top center;
  }
  .visual-stage :global(.image-control) {
    cursor: pointer;
    padding: 0;
    background: transparent;
    color: inherit;
    border: 0;
  }
  .image-control :global(figure) {
    height: 100%;
  }
  .image-control:focus-visible {
    outline: 3px solid rgb(var(--fluvio-river));
    outline-offset: 5px;
  }
  .visual-stage :global(.image-control[data-position]) {
    inset: 12% auto auto 50% !important;
    width: 60% !important;
    height: 76% !important;
    transform-origin: center;
    backface-visibility: hidden;
  }
  .visual-stage :global(.image-control[data-position='front']) {
    z-index: 3;
    transform: translate(-50%, 8%) rotateY(0deg) scale(1) !important;
  }
  .visual-stage :global(.image-control[data-position='left']) {
    z-index: 1;
    transform: translate(-81%, -7%) rotateY(24deg) scale(0.78) !important;
  }
  .visual-stage :global(.image-control[data-position='right']) {
    z-index: 2;
    transform: translate(-19%, -7%) rotateY(-24deg) scale(0.78) !important;
  }
  .overview-view--dashboard .visual-stage :global(.image-control[data-position]) {
    width: 80% !important;
    height: auto !important;
    aspect-ratio: 16 / 9;
    top: 25% !important;
    border: 2px solid var(--fluvio-screen-border);
    border-radius: 12px;
    background: var(--fluvio-screen-surface);
    box-shadow: 0 18px 35px rgb(10 35 50 / 0.18);
  }
  .overview-view--dashboard .visual-stage :global(img) {
    object-fit: contain !important;
    object-position: center;
  }
  @media (prefers-reduced-motion: no-preference) {
    .visual-stage :global(.image-control[data-position]) {
      transition:
        transform 800ms cubic-bezier(0.22, 0.68, 0.12, 1),
        z-index 800ms step-end;
    }
    .visual-stage :global(.image-control[data-position='front']) {
      transition:
        transform 800ms cubic-bezier(0.22, 0.68, 0.12, 1),
        z-index 400ms step-start;
    }
  }
  @media (max-width: 799px) {
    .overview-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .overview-view {
      width: min(100%, 30rem);
      margin-inline: auto;
    }
    .visual-stage {
      height: 18rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .visual-stage {
      animation: showcase-turn 10s ease-in-out infinite paused;
    }
    fluvio-overview[data-visible] .visual-stage {
      animation-play-state: running;
    }
    .overview-view:nth-child(2) .visual-stage {
      animation-delay: -3s;
    }
    .overview-view:nth-child(3) .visual-stage {
      animation-delay: -6s;
    }
    @keyframes showcase-turn {
      0%,
      100% {
        transform: perspective(1000px) rotateY(-5deg) translateY(0);
      }
      50% {
        transform: perspective(1000px) rotateY(5deg) translateY(-6px);
      }
    }
  }
</style>
<script>
  class FluvioOverview extends HTMLElement {
    private listeners?: AbortController;
    private observer?: IntersectionObserver;
    connectedCallback() {
      this.listeners = new AbortController();
      this.querySelectorAll<HTMLElement>('.visual-stage').forEach((stage) => {
        const images = [...stage.querySelectorAll<HTMLButtonElement>('.image-control')];
        const hardware = stage.closest('[data-panel="hardware"]') !== null;
        let selected = 1;
        let movingUntil = 0;
        const bringForward = (index: number) => {
          selected = index;
          movingUntil = performance.now() + 850;
          images.forEach((image, imageIndex) => {
            const position = (imageIndex - selected + images.length) % images.length;
            if (!hardware) image.dataset.position = ['front', 'right', 'left'][position];
            image.setAttribute('aria-pressed', String(position === 0));
          });
        };
        bringForward(1);
        images.forEach((image, index) => {
          image.addEventListener(
            'pointerenter',
            (event) => {
              if (event.pointerType !== 'touch' && performance.now() > movingUntil && index !== selected)
                bringForward(index);
            },
            { signal: this.listeners!.signal }
          );
          image.addEventListener(
            'focus',
            () => {
              if (index !== selected) bringForward(index);
            },
            { signal: this.listeners!.signal }
          );
          image.addEventListener(
            'click',
            () => {
              if (index !== selected) bringForward(index);
            },
            { signal: this.listeners!.signal }
          );
        });
        stage.addEventListener(
          'keydown',
          (event) => {
            if (!['ArrowLeft', 'ArrowRight', 'Escape'].includes(event.key)) return;
            event.preventDefault();
            const index =
              event.key === 'Escape' ? 1 : (selected + (event.key === 'ArrowRight' ? 1 : 2)) % images.length;
            bringForward(index);
            images[index].focus();
          },
          { signal: this.listeners!.signal }
        );
      });
      this.observer = new IntersectionObserver(([entry]) => {
        this.toggleAttribute('data-visible', entry.isIntersecting);
      });
      this.observer.observe(this.querySelector('.overview-grid')!);
    }
    disconnectedCallback() {
      this.listeners?.abort();
      this.observer?.disconnect();
    }
  }
  if (!customElements.get('fluvio-overview')) customElements.define('fluvio-overview', FluvioOverview);
</script>
