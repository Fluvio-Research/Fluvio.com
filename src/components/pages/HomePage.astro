---
import ContactPanel from '~/components/fluvio/ContactPanel.astro';
import HeroSlider from '~/components/fluvio/HeroSlider.astro';
import LargeImage from '~/components/fluvio/LargeImage.astro';
import PlatformFeature from '~/components/fluvio/PlatformFeature.astro';
import ProjectFeature from '~/components/fluvio/ProjectFeature.astro';
import SectionFrame from '~/components/fluvio/SectionFrame.astro';
import SectionHeading from '~/components/fluvio/SectionHeading.astro';
import TeamProfile from '~/components/fluvio/TeamProfile.astro';
import { getExpertiseAreas, getFeaturedProjects, getSiteContent, getTeamMembers } from '~/data/fluvio/localized';
import { localeHref, t, type Locale } from '~/i18n';
import Layout from '~/layouts/PageLayout.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = t(locale);
const siteContent = getSiteContent(locale);

const metadata = {
  title: siteContent.name,
  description: c.home.metaDescription,
  ignoreTitleTemplate: true,
};

const reveal = 'intersect-once intersect-quarter motion-safe:intersect:animate-fade';

const selectedExpertise = getExpertiseAreas(locale).slice(0, 4);
const selectedTeam = getTeamMembers(locale).slice(0, 3);
const featuredProjects = getFeaturedProjects(locale);
---

<Layout metadata={metadata} locale={locale}>
  <HeroSlider locale={locale} />

  {/* 1. Hero -> capability strip: soft mist field, one water-blue rule. */}
  <SectionFrame tone="mist" rule="river" motif="contour" spacing="compact" ariaLabel={c.home.capabilitiesLabel}>
    <div class="fluvio-home-capability-grid">
      {
        c.home.capabilities.map((capability) => (
          <article class={reveal}>
            <h2>{capability.title}</h2>
            <p>{capability.description}</p>
          </article>
        ))
      }
    </div>
  </SectionFrame>

  {/* 2. Capabilities -> Expertise: quiet paper, mineral field from the outer gutter. */}
  <SectionFrame tone="paper" motif="wash-right" labelledby="home-expertise-heading">
    <div id="home-expertise-heading" class:list={['fluvio-home-heading', reveal]}>
      <SectionHeading eyebrow={c.home.expertiseEyebrow} title={c.home.expertiseTitle} intro={c.home.expertiseIntro} />
    </div>
    <div class="fluvio-home-expertise-grid">
      {
        selectedExpertise.map((area, index) => (
          <a class:list={['fluvio-home-expertise-card', reveal]} href={localeHref(`/expertise#${area.slug}`, locale)}>
            <LargeImage
              src={area.image}
              alt={area.imageAlt}
              aspect="landscape"
              sizes="(min-width: 1280px) 616px, (min-width: 768px) 45vw, calc(100vw - 2rem)"
            />
            <span class="fluvio-home-expertise-card__meta">
              <span class="fluvio-home-expertise-card__number">{String(index + 1).padStart(2, '0')}</span>
              <span class="fluvio-home-expertise-card__title">{area.title}</span>
              <span class="fluvio-home-expertise-card__arrow" aria-hidden="true">
                →
              </span>
            </span>
          </a>
        ))
      }
    </div>
    <a class="fluvio-link fluvio-home-more" href={localeHref('/expertise', locale)}
      >{c.home.expertiseMore} <span aria-hidden="true">→</span></a
    >
  </SectionFrame>

  {/* 3. Expertise -> Projects: strongest editorial handoff, contour whitespace. */}
  <SectionFrame tone="paper" motif="contour" labelledby="home-projects-heading">
    <header class:list={['fluvio-home-project-heading', reveal]}>
      <h2 id="home-projects-heading" class="fluvio-display">{c.home.projectsTitle}</h2>
      <p>{c.home.projectsIntro}</p>
    </header>
    <div class="fluvio-home-project-list">
      {
        featuredProjects.map((project, index) => (
          <div class={reveal}>
            <ProjectFeature project={project} locale={locale} eyebrow={index === 0 ? c.home.projectsFeatured : ''} />
          </div>
        ))
      }
    </div>
    <a class="fluvio-link fluvio-home-more" href={localeHref('/projects', locale)}
      >{c.home.projectsMore} <span aria-hidden="true">→</span></a
    >
  </SectionFrame>

  {/* 4. Projects -> Platforms: field evidence to operational technology. */}
  <SectionFrame tone="water" rule="ink" motif="grid" labelledby="home-platforms-heading" class="fluvio-home-platforms">
    <header class:list={['fluvio-home-platform-heading', reveal]}>
      <h2 id="home-platforms-heading" class="fluvio-display">{c.home.platformsTitle}</h2>
      <p>{c.home.platformsIntro}</p>
    </header>
    <div class="fluvio-home-platform-grid">
      <div class={reveal}>
        <PlatformFeature
          title={c.platforms.sense.title}
          description={c.platforms.sense.description}
          href="https://sense.fluvio.com.au/"
          actionLabel={c.platforms.sense.action}
          locale={locale}
        />
      </div>
      <div class={reveal}>
        <PlatformFeature
          title={c.platforms.cascade.title}
          description={c.platforms.cascade.description}
          locale={locale}
        />
      </div>
    </div>
  </SectionFrame>

  {/* 5. Platforms -> Team: back to paper and people, with more air. */}
  <SectionFrame tone="paper" spacing="wide" labelledby="home-team-heading">
    <div id="home-team-heading" class:list={['fluvio-home-heading', reveal]}>
      <SectionHeading title={c.home.teamTitle} intro={c.home.teamIntro} />
    </div>
    <div class="fluvio-home-team-grid">
      {
        selectedTeam.map((member) => (
          <div class:list={['fluvio-home-team-cell', reveal]}>
            <TeamProfile member={member} locale={locale} />
          </div>
        ))
      }
    </div>
    <a class="fluvio-link fluvio-home-more" href={localeHref('/team', locale)}
      >{c.home.teamMore} <span aria-hidden="true">→</span></a
    >
  </SectionFrame>

  {/* 6. Team -> Impact: deep navy chapter break with a coral rule. */}
  <SectionFrame tone="navy" rule="coral" spacing="wide" labelledby="home-impact-heading">
    <div class="fluvio-home-impact-grid">
      <h2 id="home-impact-heading" class:list={['fluvio-display', reveal]}>{c.home.impactTitle}</h2>
      <div class={reveal}>
        {c.home.impactBody.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </SectionFrame>

  {/* 7. Impact -> Contact: warm closing handoff. */}
  <SectionFrame tone="warm">
    <div class={reveal}>
      <ContactPanel locale={locale} />
    </div>
  </SectionFrame>
</Layout>

<style>
  .fluvio-home-heading {
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }

  .fluvio-home-capability-grid {
    display: grid;
    gap: 2rem;
  }

  .fluvio-home-capability-grid article {
    display: grid;
    gap: 0.75rem;
  }

  .fluvio-home-capability-grid h2 {
    margin: 0;
    color: var(--aw-color-text-heading);
    font-family: var(--aw-font-heading);
    font-size: 1.1rem;
    font-weight: 620;
    letter-spacing: -0.015em;
  }

  .fluvio-home-capability-grid p {
    margin: 0;
    max-width: 31rem;
    color: var(--aw-color-text-muted);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .fluvio-home-expertise-grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem) clamp(2rem, 4vw, 4rem);
  }

  .fluvio-home-expertise-card {
    display: grid;
    gap: 1.1rem;
    color: inherit;
    text-decoration: none;
  }

  .fluvio-home-expertise-card__meta {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: baseline;
    padding-top: 1rem;
    border-top: 1px solid rgb(var(--fluvio-ink) / 0.15);
  }

  .fluvio-home-expertise-card__number {
    color: rgb(var(--fluvio-river));
    font-family: var(--aw-font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .fluvio-home-expertise-card__title {
    color: var(--aw-color-text-heading);
    font-family: var(--aw-font-heading);
    font-size: clamp(1.25rem, 2vw, 1.7rem);
    font-weight: 550;
    letter-spacing: -0.025em;
    line-height: 1.15;
    transition: color 250ms ease;
  }

  .fluvio-home-expertise-card__arrow {
    color: rgb(var(--fluvio-river));
    font-size: 1.1rem;
    transition: transform 250ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .fluvio-home-expertise-card:hover .fluvio-home-expertise-card__title {
    color: rgb(var(--fluvio-river));
  }

  .fluvio-home-expertise-card:hover .fluvio-home-expertise-card__arrow {
    transform: translateX(0.35rem);
  }

  .fluvio-home-more {
    margin-top: 2rem;
  }

  .fluvio-home-project-heading,
  .fluvio-home-platform-heading {
    max-width: 54rem;
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }

  .fluvio-home-project-heading p,
  .fluvio-home-platform-heading p {
    margin: 1.5rem 0 0;
    max-width: 42rem;
    color: var(--aw-color-text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .fluvio-home-project-list {
    display: grid;
    gap: clamp(5rem, 11vw, 10rem);
  }

  .fluvio-home-project-list > div:nth-child(2) {
    width: min(100%, 70rem);
    margin-left: auto;
  }

  .fluvio-home-project-list > div:nth-child(3) {
    width: min(100%, 74rem);
  }

  /* Silt is the platforms section's single supporting accent. */
  .fluvio-home-platforms :global(.fluvio-platform-feature__eyebrow) {
    color: rgb(var(--fluvio-silt-deep));
  }

  .fluvio-home-platform-grid {
    display: grid;
    gap: 2rem;
  }

  .fluvio-home-team-grid {
    display: grid;
    gap: 3rem;
  }

  .fluvio-home-impact-grid {
    display: grid;
    gap: 2.5rem;
  }

  .fluvio-home-impact-grid h2 {
    max-width: 15ch;
  }

  .fluvio-home-impact-grid p {
    margin: 0 0 1.2rem;
    max-width: 45rem;
    color: var(--aw-color-text-muted);
    font-size: clamp(1.05rem, 1.7vw, 1.25rem);
    line-height: 1.75;
  }

  :global(.dark) .fluvio-home-expertise-card__meta {
    border-color: rgb(var(--fluvio-mist) / 0.16);
  }

  @media (min-width: 768px) {
    .fluvio-home-expertise-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .fluvio-home-capability-grid {
      grid-template-columns: 1.15fr 0.85fr 1fr;
      gap: clamp(2rem, 5vw, 5rem);
    }

    .fluvio-home-platform-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: clamp(3rem, 8vw, 8rem);
    }

    .fluvio-home-team-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1.5rem, 3vw, 3rem);
      align-items: start;
    }

    .fluvio-home-impact-grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(24rem, 1.1fr);
      gap: clamp(4rem, 10vw, 10rem);
      align-items: start;
    }
  }
</style>
