---
import ArrowIcon from '~/components/fluvio/ArrowIcon.astro';
import ArrowLink from '~/components/fluvio/ArrowLink.astro';
import Accent from '~/components/fluvio/Accent.astro';
import ContactPanel from '~/components/fluvio/ContactPanel.astro';
import DisciplineTicker from '~/components/fluvio/DisciplineTicker.astro';
import ExpertiseMedia from '~/components/fluvio/ExpertiseMedia.astro';
import HeroSlider from '~/components/fluvio/HeroSlider.astro';
import PlatformFeature from '~/components/fluvio/PlatformFeature.astro';
import ProjectCard from '~/components/fluvio/ProjectCard.astro';
import ProjectFeature from '~/components/fluvio/ProjectFeature.astro';
import SectionFrame from '~/components/fluvio/SectionFrame.astro';
import SectionHeading from '~/components/fluvio/SectionHeading.astro';
import TeamCard from '~/components/fluvio/TeamCard.astro';
import { REVEAL } from '~/components/fluvio/reveal';
import {
  getExpertiseAreas,
  getFeaturedProjects,
  getProjects,
  getSiteContent,
  getTeamMembers,
} from '~/data/fluvio/localized';
import { getDisciplines, getLocations } from '~/data/fluvio/relations';
import { expertiseHref } from '~/data/fluvio/routes';
import { getHomepage } from '~/data/fluvio/store.ts';
import { localeHref, type Locale } from '~/i18n';
import Layout from '~/layouts/PageLayout.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const home = getHomepage(locale);
const siteContent = getSiteContent(locale);

const metadata = {
  title: siteContent.name,
  description: home.metaDescription,
  ignoreTitleTemplate: true,
};

const expertiseAreas = getExpertiseAreas(locale);
const team = getTeamMembers(locale);
const [leadProject, ...moreFeatured] = getFeaturedProjects(locale);
const disciplines = getDisciplines(locale);
const locations = getLocations(locale);
const platforms = [home.platforms.sense, home.platforms.cascade, home.platforms.reef];

/* Counts come from the content store, so they stay honest as records are added. */
const glance = [
  { value: getProjects(locale).length, label: home.glance.projects },
  { value: expertiseAreas.length, label: home.glance.expertise },
  { value: team.length, label: home.glance.team },
  { value: platforms.length, label: home.glance.platforms },
];
---

<Layout metadata={metadata} locale={locale}>
  <HeroSlider locale={locale} />

  {/* 1. Hero -> disciplines in motion, then the three capability columns. */}
  <SectionFrame tone="mist" rule="river" motif="contour" spacing="compact" ariaLabel={home.capabilitiesLabel}>
    <DisciplineTicker items={disciplines} label={home.disciplinesLabel} class="fluvio-home-ticker" />
    <div class="fluvio-home-capability-grid">
      {
        home.capabilities.map((capability, index) => (
          <article class={REVEAL}>
            <p class="fluvio-label">{String(index + 1).padStart(2, '0')}</p>
            <h2>{capability.title}</h2>
            <p>{capability.description}</p>
          </article>
        ))
      }
    </div>
  </SectionFrame>

  {/* 2. Expertise index: hover a row and its photography answers on the right. */}
  <SectionFrame tone="paper" motif="wash-right" labelledby="home-expertise-heading">
    <div class:list={['fluvio-home-heading', REVEAL]}>
      <SectionHeading
        id="home-expertise-heading"
        eyebrow={home.expertiseEyebrow}
        title={home.expertiseTitle}
        intro={home.expertiseIntro}
        align="split"
      >
        <ArrowLink slot="action" href={localeHref('/expertise', locale)}>{home.expertiseMore}</ArrowLink>
      </SectionHeading>
    </div>
    <div class:list={['fluvio-home-index', REVEAL]}>
      <ol class="fluvio-home-index__list">
        {
          expertiseAreas.map((area, index) => (
            <li class="fluvio-home-index__item">
              <a class="fluvio-home-index__row fluvio-arrow-host" href={expertiseHref(area.slug, locale)}>
                <span class="fluvio-home-index__number">{String(index + 1).padStart(2, '0')}</span>
                <span class="fluvio-home-index__text">
                  <span class="fluvio-home-index__title">{area.title}</span>
                  <span class="fluvio-home-index__summary">{area.summary}</span>
                </span>
                <ArrowIcon />
                <span class="fluvio-home-index__media" aria-hidden="true">
                  <ExpertiseMedia area={area} aspect="landscape" radius="lg" sizes="(min-width: 1280px) 600px, 46vw" />
                </span>
              </a>
            </li>
          ))
        }
      </ol>
      <div class="fluvio-home-index__stage" aria-hidden="true"></div>
    </div>
  </SectionFrame>

  {/* 3. Selected projects: one lead feature, then the rest of the selection. */}
  <SectionFrame tone="paper" motif="contour" labelledby="home-projects-heading">
    <div class:list={['fluvio-home-heading', REVEAL]}>
      <SectionHeading
        id="home-projects-heading"
        eyebrow={home.projectsFeatured}
        title={home.projectsTitle}
        intro={home.projectsIntro}
        align="split"
      >
        <ArrowLink slot="action" href={localeHref('/projects', locale)}>{home.projectsMore}</ArrowLink>
      </SectionHeading>
    </div>
    {
      leadProject && (
        <div class:list={['fluvio-home-lead', REVEAL]}>
          <ProjectFeature project={leadProject} locale={locale} eyebrow="" />
        </div>
      )
    }
    {
      moreFeatured.length > 0 && (
        <div class="fluvio-home-project-grid">
          {moreFeatured.map((project) => (
            <div class={REVEAL}>
              <ProjectCard project={project} locale={locale} />
            </div>
          ))}
        </div>
      )
    }
  </SectionFrame>

  {/* 4. Platforms: field evidence to operational technology. */}
  <SectionFrame tone="water" rule="ink" motif="grid" labelledby="home-platforms-heading" class="fluvio-home-platforms">
    <div class:list={['fluvio-home-heading', REVEAL]}>
      <SectionHeading
        id="home-platforms-heading"
        eyebrow={home.platforms.label}
        title={home.platformsTitle}
        intro={home.platformsIntro}
        align="split"
      />
    </div>
    <div class="fluvio-home-platform-grid">
      {
        platforms.map((platform, index) => (
          <div class={REVEAL}>
            <PlatformFeature
              title={platform.title}
              description={platform.description}
              href={platform.href}
              actionLabel={platform.action}
              image={platform.image}
              imageAlt={platform.imageAlt}
              imageHref={platform.imageHref}
              index={index}
              locale={locale}
            />
          </div>
        ))
      }
    </div>
  </SectionFrame>

  {/* 5. The whole team, at a glance. */}
  <SectionFrame tone="paper" spacing="wide" labelledby="home-team-heading">
    <div class:list={['fluvio-home-heading', REVEAL]}>
      <SectionHeading id="home-team-heading" title={home.teamTitle} intro={home.teamIntro} align="split">
        <ArrowLink slot="action" href={localeHref('/team', locale)}>{home.teamMore}</ArrowLink>
      </SectionHeading>
    </div>
    <div class="fluvio-home-team-grid">
      {
        team.map((member) => (
          <div class={REVEAL}>
            <TeamCard member={member} locale={locale} variant="compact" />
          </div>
        ))
      }
    </div>
  </SectionFrame>

  {/* 6. Impact: deep navy chapter with the numbers the content itself supports. */}
  <SectionFrame tone="navy" rule="coral" spacing="wide" labelledby="home-impact-heading">
    <div class="fluvio-home-impact">
      <div class={REVEAL}>
        <h2 id="home-impact-heading" class="fluvio-display"><Accent text={home.impactTitle} /></h2>
      </div>
      <div class:list={['fluvio-home-impact__body', REVEAL]}>
        {home.impactBody.map((paragraph) => <p>{paragraph}</p>)}
        <ul class="fluvio-home-impact__places" aria-label={home.projectsTitle}>
          {locations.map((place) => <li>{place}</li>)}
        </ul>
      </div>
    </div>
    <dl class:list={['fluvio-home-glance', REVEAL]} aria-label={home.glance.eyebrow}>
      {
        glance.map(({ value, label }) => (
          <div>
            <dd>{String(value).padStart(2, '0')}</dd>
            <dt>{label}</dt>
          </div>
        ))
      }
    </dl>
  </SectionFrame>

  {/* 7. Warm closing handoff. */}
  <SectionFrame tone="warm">
    <div class={REVEAL}>
      <ContactPanel locale={locale} />
    </div>
  </SectionFrame>
</Layout>

<style>
  .fluvio-home-heading {
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .fluvio-home-ticker {
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .fluvio-home-capability-grid {
    display: grid;
    gap: 2rem;
  }

  .fluvio-home-capability-grid article {
    display: grid;
    gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(var(--fluvio-ink) / 0.14);
  }

  .fluvio-home-capability-grid h2 {
    margin: 0;
    color: var(--aw-color-text-heading);
    font-family: var(--aw-font-heading);
    font-size: 1.25rem;
    font-weight: 580;
    letter-spacing: -0.02em;
  }

  .fluvio-home-capability-grid p:not(.fluvio-label) {
    margin: 0;
    max-width: 31rem;
    color: var(--aw-color-text-muted);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  /* Expertise index */
  .fluvio-home-index {
    position: relative;
    display: grid;
    gap: 2rem;
  }

  .fluvio-home-index__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgb(var(--fluvio-ink) / 0.14);
  }

  .fluvio-home-index__item {
    border-bottom: 1px solid rgb(var(--fluvio-ink) / 0.14);
  }

  .fluvio-home-index__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1.25rem;
    align-items: center;
    padding: 1.25rem 0;
    color: inherit;
    text-decoration: none;
  }

  .fluvio-home-index__number {
    min-width: 1.75rem;
    color: rgb(var(--fluvio-river));
    font-family: var(--aw-font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .fluvio-home-index__text {
    display: grid;
    gap: 0.35rem;
  }

  .fluvio-home-index__title {
    color: var(--aw-color-text-heading);
    font-family: var(--aw-font-heading);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-weight: 560;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .fluvio-home-index__summary {
    max-width: 44ch;
    color: var(--aw-color-text-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  /* The media lives inside its row for hover, but is drawn in the stage column. */
  .fluvio-home-index__media {
    display: none;
  }

  .fluvio-home-index__stage {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .fluvio-home-index__title {
      transition: color 220ms ease;
    }
  }

  .fluvio-home-index__row:hover .fluvio-home-index__title,
  .fluvio-home-index__row:focus-visible .fluvio-home-index__title {
    color: rgb(var(--fluvio-river));
  }

  .fluvio-home-index__row:focus-visible {
    border-radius: 12px;
    outline: 2px solid rgb(var(--fluvio-river));
    outline-offset: 4px;
  }

  @media (min-width: 900px) {
    .fluvio-home-index {
      grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.9fr);
      gap: clamp(3rem, 7vw, 7rem);
      align-items: start;
    }

    .fluvio-home-index__stage {
      display: block;
      aspect-ratio: 4 / 3;
      border-radius: 20px;
      background: rgb(var(--fluvio-wash) / 0.4);
    }

    .fluvio-home-index__media {
      position: absolute;
      top: 0;
      right: 0;
      display: block;
      width: calc((100% - clamp(3rem, 7vw, 7rem)) * 0.9 / 1.9);
      opacity: 0;
      pointer-events: none;
    }

    .fluvio-home-index__item:first-child .fluvio-home-index__media {
      opacity: 1;
    }

    .fluvio-home-index:has(.fluvio-home-index__row:hover, .fluvio-home-index__row:focus-visible)
      .fluvio-home-index__item:first-child
      .fluvio-home-index__row:not(:hover, :focus-visible)
      .fluvio-home-index__media {
      opacity: 0;
    }

    .fluvio-home-index__row:hover .fluvio-home-index__media,
    .fluvio-home-index__row:focus-visible .fluvio-home-index__media {
      opacity: 1;
    }

    @media (prefers-reduced-motion: no-preference) {
      .fluvio-home-index__media {
        transform: scale(0.98);
        transition:
          opacity 420ms cubic-bezier(0.22, 1, 0.36, 1),
          transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      .fluvio-home-index__row:hover .fluvio-home-index__media,
      .fluvio-home-index__row:focus-visible .fluvio-home-index__media,
      .fluvio-home-index__item:first-child .fluvio-home-index__media {
        transform: scale(1);
      }
    }
  }

  /* Projects */
  .fluvio-home-lead {
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }

  .fluvio-home-project-grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  /* Silt is the platforms section's single supporting accent. */
  .fluvio-home-platforms :global(.fluvio-platform-feature__eyebrow) {
    color: rgb(var(--fluvio-silt-deep));
  }

  .fluvio-home-platform-grid {
    display: grid;
    gap: 2rem;
  }

  /* A wall of faces: the whole team fits one row at desktop widths and
     wraps as it grows. */
  .fluvio-home-team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(6.75rem, 1fr));
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  /* Impact */
  .fluvio-home-impact {
    display: grid;
    gap: 2.5rem;
  }

  .fluvio-home-impact h2 {
    max-width: 15ch;
  }

  .fluvio-home-impact__body p {
    margin: 0 0 1.2rem;
    max-width: 45rem;
    color: var(--aw-color-text-muted);
    font-size: clamp(1.05rem, 1.7vw, 1.2rem);
    line-height: 1.75;
  }

  .fluvio-home-impact__places {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .fluvio-home-impact__places li {
    padding: 0.4rem 0.85rem;
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: 999px;
    color: rgb(var(--fluvio-paper) / 0.86);
    font-size: 0.8rem;
    font-weight: 500;
  }

  .fluvio-home-glance {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.5rem;
    margin: clamp(3rem, 7vw, 6rem) 0 0;
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid rgb(255 255 255 / 0.16);
  }

  .fluvio-home-glance dd {
    margin: 0;
    color: rgb(var(--fluvio-paper));
    font-family: var(--aw-font-heading);
    font-size: clamp(2.6rem, 5vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .fluvio-home-glance dt {
    margin-top: 0.6rem;
    color: rgb(var(--fluvio-paper) / 0.7);
    font-family: var(--aw-font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  :global(.dark) .fluvio-home-capability-grid article,
  :global(.dark) .fluvio-home-index__list,
  :global(.dark) .fluvio-home-index__item {
    border-color: rgb(var(--fluvio-mist) / 0.16);
  }

  :global(.dark) .fluvio-home-index__number,
  :global(.dark) .fluvio-home-index__row:hover .fluvio-home-index__title {
    color: rgb(125 186 188);
  }

  @media (min-width: 768px) {
    .fluvio-home-capability-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(2rem, 5vw, 5rem);
    }

    .fluvio-home-project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .fluvio-home-platform-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1.5rem, 3vw, 3.5rem);
      align-items: start;
    }

    .fluvio-home-impact {
      grid-template-columns: minmax(0, 0.9fr) minmax(24rem, 1.1fr);
      gap: clamp(4rem, 10vw, 10rem);
      align-items: start;
    }

    .fluvio-home-glance {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
