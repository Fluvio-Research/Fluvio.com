---
import AdjacentNav from '~/components/fluvio/AdjacentNav.astro';
import Breadcrumbs from '~/components/fluvio/Breadcrumbs.astro';
import ContactPanel from '~/components/fluvio/ContactPanel.astro';
import ExpertiseCard from '~/components/fluvio/ExpertiseCard.astro';
import LargeImage from '~/components/fluvio/LargeImage.astro';
import ProjectCard from '~/components/fluvio/ProjectCard.astro';
import ProjectGallery from '~/components/fluvio/ProjectGallery.astro';
import ProjectMeta from '~/components/fluvio/ProjectMeta.astro';
import SectionFrame from '~/components/fluvio/SectionFrame.astro';
import SectionHeading from '~/components/fluvio/SectionHeading.astro';
import { REVEAL } from '~/components/fluvio/reveal';
import { getProjects } from '~/data/fluvio/localized';
import { getAdjacent, getExpertiseForProject, getRelatedProjects, withoutImages } from '~/data/fluvio/relations';
import { projectHref } from '~/data/fluvio/routes';
import type { Project } from '~/data/fluvio/types';
import { localeHref, t, type Locale } from '~/i18n';
import Layout from '~/layouts/PageLayout.astro';
import { findVideo } from '~/utils/images';

export interface Props {
  locale: Locale;
  project: Project;
}

const { locale, project } = Astro.props;
const c = t(locale).projectDetail;

const projects = getProjects(locale);
const relatedExpertise = getExpertiseForProject(locale, project);
/* Photography already on this page never returns in the related grid. */
const usedImages = [project.heroImage, ...(project.gallery ?? []).map(({ src }) => src)];
const relatedProjects = withoutImages(getRelatedProjects(locale, project), usedImages, (item) => item.heroImage);
const adjacent = getAdjacent(projects, project.slug);
const videoUrl = findVideo(project.video);

const metadata = {
  title: project.title,
  description: project.summary,
};

const story = [
  { id: 'challenge', number: '01', title: c.challenge, paragraphs: project.challenge },
  { id: 'approach', number: '02', title: c.approach, paragraphs: project.approach },
  { id: 'outcome', number: '03', title: c.outcome, paragraphs: project.outcome },
];
const position = `${String(adjacent.index + 1).padStart(2, '0')} / ${String(adjacent.total).padStart(2, '0')}`;
---

<Layout metadata={metadata} locale={locale}>
  <article class="fluvio-project">
    <div class="fluvio-project__progress" aria-hidden="true"></div>
    <header class:list={['fluvio-project-hero', { 'fluvio-project-hero--video': Boolean(videoUrl) }]}>
      <fluvio-project-hero class="fluvio-project-hero__media">
        <LargeImage
          src={project.heroImage}
          alt={project.heroAlt}
          aspect="fill"
          priority
          sizes="100vw"
          transitionName={`project-${project.slug}`}
        />
        {
          videoUrl && (
            <video
              class="fluvio-project-hero__video"
              data-project-video
              src={videoUrl}
              muted
              loop
              playsinline
              preload="metadata"
              aria-hidden="true"
              tabindex="-1"
            />
          )
        }
      </fluvio-project-hero>
      <div class="fluvio-project-hero__scrim" aria-hidden="true"></div>
      <div class="fluvio-shell fluvio-project-hero__copy">
        <Breadcrumbs
          locale={locale}
          tone="inverse"
          crumbs={[{ label: c.back, href: localeHref('/projects', locale) }, { label: project.title }]}
        />
        <div class="fluvio-project-hero__text">
          <p class="fluvio-project-hero__eyebrow">
            <span>{c.eyebrow}</span>
            <span aria-hidden="true">{position}</span>
          </p>
          <h1>{project.title}</h1>
          <p class="fluvio-project-hero__summary">{project.summary}</p>
          <ul class="fluvio-project-hero__tags" aria-label={t(locale).project.disciplines}>
            {project.disciplines.map((discipline) => <li>{discipline}</li>)}
          </ul>
        </div>
      </div>
    </header>

    <div class="fluvio-shell fluvio-project-facts" aria-label={c.factsLabel}>
      <ProjectMeta project={project} locale={locale} />
    </div>

    <SectionFrame tone="paper" motif="contour" ariaLabel={c.storyLabel} class="fluvio-project-story">
      <fluvio-project-rail class="fluvio-project-story__grid">
        <aside class="fluvio-project-story__rail">
          <p class="fluvio-label">{c.contents}</p>
          <ol>
            {
              story.map((section) => (
                <li>
                  <a href={`#${section.id}`} data-rail-link={section.id}>
                    <span class="fluvio-project-story__rail-number">{section.number}</span>
                    <span>{section.title}</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </aside>
        <div class="fluvio-project-story__sections">
          {
            story.map((section) => (
              <section id={section.id} class:list={['fluvio-project-story__section', REVEAL]} data-rail-section>
                <p class="fluvio-project-story__number" aria-hidden="true">
                  {section.number}
                </p>
                <h2>{section.title}</h2>
                <div class="fluvio-project-story__body">
                  {section.paragraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
              </section>
            ))
          }
        </div>
      </fluvio-project-rail>
    </SectionFrame>

    {
      project.gallery && project.gallery.length > 0 && (
        <SectionFrame tone="mist" spacing="standard" shell="wide" ariaLabel={c.galleryLabel}>
          <div class={REVEAL}>
            <ProjectGallery
              images={project.gallery}
              labels={{
                open: c.galleryOpen,
                close: c.galleryClose,
                previous: c.galleryPrevious,
                next: c.galleryNext,
                gallery: c.galleryLabel,
              }}
            />
          </div>
        </SectionFrame>
      )
    }

    {
      relatedExpertise.length > 0 && (
        <SectionFrame tone="paper" rule="ink" labelledby="related-expertise-heading">
          <div class:list={['fluvio-project-related__heading', REVEAL]}>
            <SectionHeading
              id="related-expertise-heading"
              eyebrow={c.relatedExpertiseEyebrow}
              title={c.relatedExpertiseTitle}
            />
          </div>
          <div class="fluvio-project-related__expertise">
            {relatedExpertise.map((area, index) => (
              <div class={REVEAL}>
                <ExpertiseCard area={area} locale={locale} index={index} variant="compact" headingLevel="h3" />
              </div>
            ))}
          </div>
        </SectionFrame>
      )
    }

    {
      relatedProjects.length > 0 && (
        <SectionFrame tone="paper" motif="wash-left" labelledby="related-projects-heading">
          <div class:list={['fluvio-project-related__heading', REVEAL]}>
            <SectionHeading
              id="related-projects-heading"
              eyebrow={c.relatedProjectsEyebrow}
              title={c.relatedProjectsTitle}
            />
          </div>
          <div class="fluvio-project-related__projects">
            {relatedProjects.map((related) => (
              <div class={REVEAL}>
                <ProjectCard project={related} locale={locale} headingLevel="h3" />
              </div>
            ))}
          </div>
        </SectionFrame>
      )
    }

    <div class="fluvio-shell fluvio-project-adjacent">
      <AdjacentNav
        label={c.relatedProjectsEyebrow}
        previousLabel={c.previousProject}
        nextLabel={c.nextProject}
        previous={adjacent.previous && {
          href: projectHref(adjacent.previous.slug, locale),
          title: adjacent.previous.title,
          meta: adjacent.previous.location,
        }}
        next={adjacent.next && {
          href: projectHref(adjacent.next.slug, locale),
          title: adjacent.next.title,
          meta: adjacent.next.location,
        }}
      />
    </div>

    <SectionFrame tone="warm">
      <div class={REVEAL}>
        <ContactPanel locale={locale} eyebrow={c.contactEyebrow} title={c.contactTitle} intro={c.contactIntro} />
      </div>
    </SectionFrame>
  </article>
</Layout>

<script>
  /* The hero clip plays silently over the photograph once it can, pauses when
     the hero scrolls away, and never starts for visitors who prefer reduced
     motion: the photograph is the page for them. */
  class FluvioProjectHero extends HTMLElement {
    private observer?: IntersectionObserver;

    connectedCallback() {
      const video = this.querySelector<HTMLVideoElement>('[data-project-video]');
      if (!video || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      video.addEventListener('playing', () => this.classList.add('is-playing'));
      this.observer = new IntersectionObserver(
        (entries) =>
          entries.forEach((entry) => {
            if (entry.isIntersecting) video.play().catch(() => {});
            else video.pause();
          }),
        { threshold: 0.05 }
      );
      this.observer.observe(this);
    }

    disconnectedCallback() {
      this.observer?.disconnect();
    }
  }

  /* The contents rail follows the reader: the chapter in view is marked. */
  class FluvioProjectRail extends HTMLElement {
    private observer?: IntersectionObserver;

    connectedCallback() {
      const links = Array.from(this.querySelectorAll<HTMLAnchorElement>('[data-rail-link]'));
      const sections = Array.from(this.querySelectorAll<HTMLElement>('[data-rail-section]'));
      if (!links.length || !sections.length) return;
      this.observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (!visible) return;
          links.forEach((link) => {
            const active = link.dataset.railLink === visible.target.id;
            if (active) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });
        },
        { rootMargin: '-30% 0px -50% 0px', threshold: [0, 0.25, 0.5, 1] }
      );
      sections.forEach((section) => this.observer?.observe(section));
    }

    disconnectedCallback() {
      this.observer?.disconnect();
    }
  }

  if (!customElements.get('fluvio-project-hero')) customElements.define('fluvio-project-hero', FluvioProjectHero);
  if (!customElements.get('fluvio-project-rail')) customElements.define('fluvio-project-rail', FluvioProjectRail);
</script>

<style>
  /* Reading progress: a hairline of river blue that fills as the reader
     scrolls, driven by the scroll position itself where supported. */
  .fluvio-project__progress {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .fluvio-project__progress {
        position: fixed;
        top: 0;
        left: 0;
        z-index: 50;
        display: block;
        width: 100%;
        height: 3px;
        background: linear-gradient(90deg, rgb(var(--fluvio-river)), rgb(var(--fluvio-teal)));
        transform: scaleX(0);
        transform-origin: left;
        animation: fluvio-progress linear both;
        animation-timeline: scroll(root);
      }
    }
  }

  @keyframes fluvio-progress {
    to {
      transform: scaleX(1);
    }
  }

  /* Cinematic opening: the photograph (or clip) carries the title. */
  .fluvio-project-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(32rem, 84vh, 52rem);
    overflow: hidden;
    color: rgb(var(--fluvio-paper));
  }

  .fluvio-project-hero__media {
    position: absolute;
    inset: 0;
    display: block;
  }

  .fluvio-project-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
  }

  .fluvio-project-hero__media.is-playing .fluvio-project-hero__video {
    opacity: 1;
  }

  /* Scroll-driven parallax where the browser supports it: the photograph
     drifts up at a third of the scroll speed as the hero leaves the screen. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .fluvio-project-hero__media {
        inset: -18% 0 0;
        animation: fluvio-hero-parallax linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
    }
  }

  @keyframes fluvio-hero-parallax {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(18%);
    }
  }

  .fluvio-project-hero__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgb(var(--fluvio-ink) / 0.5) 0%, rgb(var(--fluvio-ink) / 0) 30%),
      linear-gradient(
        8deg,
        rgb(var(--fluvio-ink) / 0.88) 0%,
        rgb(var(--fluvio-ink) / 0.55) 38%,
        rgb(var(--fluvio-ink) / 0.05) 72%
      );
  }

  .fluvio-project-hero__copy {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    min-height: inherit;
    padding: clamp(6rem, 12vh, 8rem) 0 clamp(2.5rem, 6vw, 4.5rem);
  }

  .fluvio-project-hero__text {
    display: grid;
    gap: 1.25rem;
  }

  .fluvio-project-hero__eyebrow {
    display: flex;
    gap: 1rem;
    margin: 0;
    color: rgb(var(--fluvio-wash));
    font-family: var(--aw-font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .fluvio-project-hero__eyebrow span + span {
    color: rgb(var(--fluvio-paper) / 0.6);
  }

  h1 {
    margin: 0;
    max-width: 16ch;
    color: inherit;
    font-family: var(--aw-font-heading);
    font-size: clamp(2.4rem, 5.6vw, 5.2rem);
    font-weight: 540;
    letter-spacing: -0.03em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .fluvio-project-hero__summary {
    margin: 0;
    max-width: 46rem;
    color: rgb(var(--fluvio-paper) / 0.86);
    font-size: clamp(1.02rem, 1.7vw, 1.25rem);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .fluvio-project-hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .fluvio-project-hero__tags li {
    padding: 0.35rem 0.75rem;
    border: 1px solid rgb(255 255 255 / 0.26);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.1);
    backdrop-filter: blur(8px);
    color: rgb(var(--fluvio-paper));
    font-size: 0.72rem;
    font-weight: 560;
    letter-spacing: 0.02em;
  }

  /* Copy rises softly on arrival. */
  @media (prefers-reduced-motion: no-preference) {
    .fluvio-project-hero__video {
      transition: opacity 1200ms ease;
    }

    .fluvio-project-hero__text > * {
      animation: fluvio-project-rise 900ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .fluvio-project-hero__text > :nth-child(2) {
      animation-delay: 90ms;
    }

    .fluvio-project-hero__text > :nth-child(3) {
      animation-delay: 180ms;
    }

    .fluvio-project-hero__text > :nth-child(4) {
      animation-delay: 270ms;
    }
  }

  @keyframes fluvio-project-rise {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Facts: a strip of quiet cards lifted over the hero's bottom edge. */
  .fluvio-project-facts {
    position: relative;
    z-index: 1;
    margin-top: clamp(-1.75rem, -3vw, -2.5rem);
  }

  .fluvio-project-facts :global(.fluvio-project-meta) {
    gap: 0.75rem;
    padding: 0;
    border-top: 0;
  }

  .fluvio-project-facts :global(.fluvio-project-meta > div) {
    padding: 1.1rem 1.25rem;
    border: 1px solid rgb(var(--fluvio-ink) / 0.1);
    border-radius: 16px;
    background: rgb(var(--fluvio-paper) / 0.82);
    backdrop-filter: blur(14px);
    box-shadow: 0 18px 40px -24px rgb(var(--fluvio-ink) / 0.35);
  }

  :global(.dark) .fluvio-project-facts :global(.fluvio-project-meta > div) {
    border-color: rgb(var(--fluvio-mist) / 0.12);
    background: rgb(var(--fluvio-navy) / 0.55);
    box-shadow: 0 18px 40px -24px rgb(0 0 0 / 0.6);
  }

  /* Story: a sticky rail and three numbered chapters. */
  .fluvio-project-story__grid {
    display: grid;
    gap: 3rem;
  }

  .fluvio-project-story__rail {
    display: none;
  }

  .fluvio-project-story__sections {
    display: grid;
  }

  .fluvio-project-story__section {
    display: grid;
    gap: 1.25rem;
    padding: clamp(2.5rem, 5vw, 4rem) 0;
    border-top: 1px solid rgb(var(--fluvio-ink) / 0.14);
    scroll-margin-top: 7rem;
  }

  .fluvio-project-story__number {
    margin: 0;
    color: rgb(var(--fluvio-river));
    font-family: var(--aw-font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .fluvio-project-story__section h2 {
    margin: 0;
    color: var(--aw-color-text-heading);
    font-family: var(--aw-font-heading);
    font-size: clamp(1.9rem, 3.6vw, 3.4rem);
    font-weight: 540;
    letter-spacing: -0.03em;
    line-height: 1.02;
  }

  .fluvio-project-story__body {
    max-width: 44rem;
  }

  .fluvio-project-story__body p {
    margin: 0 0 1.1rem;
    color: var(--aw-color-text-muted);
    font-size: 1.05rem;
    line-height: 1.75;
    text-wrap: pretty;
  }

  .fluvio-project-story__body p:first-child::first-letter {
    float: left;
    margin: 0.1em 0.12em 0 0;
    color: var(--aw-color-text-heading);
    font-family: var(--aw-font-heading);
    font-size: 3.2em;
    font-weight: 560;
    line-height: 0.82;
  }

  .fluvio-project-related__heading {
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .fluvio-project-related__expertise,
  .fluvio-project-related__projects {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .fluvio-project-adjacent {
    padding: clamp(3rem, 7vw, 6rem) 0 0;
  }

  :global(.dark) .fluvio-project-story__section {
    border-color: rgb(var(--fluvio-mist) / 0.15);
  }

  :global(.dark) .fluvio-project-story__number {
    color: rgb(125 186 188);
  }

  @media (min-width: 768px) {
    .fluvio-project-story__grid {
      grid-template-columns: minmax(12rem, 0.42fr) minmax(0, 1.58fr);
      gap: clamp(3rem, 7vw, 7rem);
      align-items: start;
    }

    .fluvio-project-story__rail {
      position: sticky;
      top: 7rem;
      display: grid;
      gap: 1.25rem;
    }

    .fluvio-project-story__rail ol {
      display: grid;
      gap: 0.35rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .fluvio-project-story__rail a {
      position: relative;
      display: flex;
      gap: 0.9rem;
      align-items: baseline;
      padding: 0.55rem 0;
      border-bottom: 1px solid rgb(var(--fluvio-ink) / 0.12);
      color: var(--aw-color-text-muted);
      font-family: var(--aw-font-heading);
      font-size: 1.1rem;
      font-weight: 560;
      letter-spacing: -0.015em;
      text-decoration: none;
      transition: color 200ms ease;
    }

    /* The chapter being read fills its rule in river blue. */
    .fluvio-project-story__rail a::after {
      content: '';
      position: absolute;
      right: 0;
      bottom: -1px;
      left: 0;
      height: 1px;
      background: rgb(var(--fluvio-river));
      transform: scaleX(0);
      transform-origin: left;
    }

    .fluvio-project-story__rail a:hover,
    .fluvio-project-story__rail a[aria-current] {
      color: var(--aw-color-text-heading);
    }

    .fluvio-project-story__rail a[aria-current]::after {
      transform: scaleX(1);
    }

    @media (prefers-reduced-motion: no-preference) {
      .fluvio-project-story__rail a::after {
        transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
      }
    }

    .fluvio-project-story__rail-number {
      color: rgb(var(--fluvio-river));
      font-family: var(--aw-font-mono);
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.12em;
    }

    :global(.dark) .fluvio-project-story__rail a {
      border-color: rgb(var(--fluvio-mist) / 0.15);
    }

    .fluvio-project-story__section {
      grid-template-columns: 3.5rem minmax(0, 1fr);
      column-gap: 1.5rem;
    }

    .fluvio-project-story__number {
      grid-row: 1 / span 2;
      padding-top: 0.6rem;
    }

    .fluvio-project-story__section:first-child {
      border-top: 0;
      padding-top: 0;
    }

    .fluvio-project-related__expertise {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    }

    /* Two or three related projects share one row; never an orphan card. */
    .fluvio-project-related__projects {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
      align-items: stretch;
    }
  }
</style>
