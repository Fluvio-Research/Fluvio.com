---
import { Image } from 'astro:assets';

import logo from '~/assets/images/fluvio/logo.png';
import { siteContent } from '~/data/fluvio/site';
---

<Image
  src={logo}
  alt={siteContent.name}
  width={1583}
  height={734}
  class="h-12 w-auto max-w-[9.75rem] object-contain object-left"
  loading="eager"
  decoding="async"
/>
