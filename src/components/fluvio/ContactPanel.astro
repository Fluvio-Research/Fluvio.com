---
import Accent from './Accent.astro';
import ArrowLink from './ArrowLink.astro';
import { defaultLocale, localeHref, t, type Locale } from '~/i18n';

export interface Props {
  locale?: Locale;
  eyebrow?: string;
  title?: string;
  intro?: string;
  href?: string;
  actionLabel?: string;
}

const { locale = defaultLocale } = Astro.props;
const strings = t(locale).contactPanel;

const {
  eyebrow = strings.eyebrow,
  title = strings.title,
  intro = strings.intro,
  href = localeHref('/contact', locale),
  actionLabel = strings.action,
} = Astro.props;
---

<section class="fluvio-contact-panel">
  <div class="fluvio-contact-panel__contour" aria-hidden="true"></div>
  <div class="fluvio-contact-panel__copy">
    {eyebrow && <p class="fluvio-contact-panel__eyebrow">{eyebrow}</p>}
    <h2><Accent text={title} /></h2>
  </div>
  <div class="fluvio-contact-panel__action">
    <p>{intro}</p>
    <ArrowLink href={href} variant="pill" tone="paper" size="lg">{actionLabel}</ArrowLink>
  </div>
</section>

<style>
  .fluvio-contact-panel {
    position: relative;
    display: grid;
    gap: 2rem;
    overflow: hidden;
    padding: clamp(2rem, 6vw, 5rem);
    border-radius: 20px;
    background:
      radial-gradient(120% 110% at 88% -10%, rgb(var(--fluvio-river) / 0.34), transparent 55%),
      radial-gradient(60% 80% at 0% 100%, rgb(var(--fluvio-teal) / 0.22), transparent 60%), rgb(var(--fluvio-navy));
    color: rgb(var(--fluvio-paper));
  }

  /* Topographic contours drift in from the corner: the site's hydrology motif. */
  .fluvio-contact-panel__contour {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-radial-gradient(
      ellipse 70rem 34rem at 104% 110%,
      transparent 0 30px,
      rgb(255 255 255 / 0.06) 31px 32px,
      transparent 33px 62px
    );
    mask-image: linear-gradient(200deg, rgb(0 0 0) 20%, transparent 75%);
  }

  /* Two soft lights drift behind the copy. */
  .fluvio-contact-panel::before,
  .fluvio-contact-panel::after {
    content: '';
    position: absolute;
    z-index: 0;
    width: 34rem;
    height: 34rem;
    border-radius: 999px;
    pointer-events: none;
    filter: blur(70px);
    opacity: 0.55;
  }

  .fluvio-contact-panel::before {
    top: -18rem;
    right: -10rem;
    background: rgb(var(--fluvio-river));
  }

  .fluvio-contact-panel::after {
    bottom: -20rem;
    left: -12rem;
    background: rgb(var(--fluvio-teal));
    opacity: 0.35;
  }

  @media (prefers-reduced-motion: no-preference) {
    .fluvio-contact-panel::before {
      animation: fluvio-contact-drift 22s ease-in-out infinite alternate;
    }

    .fluvio-contact-panel::after {
      animation: fluvio-contact-drift 26s ease-in-out infinite alternate-reverse;
    }
  }

  @keyframes fluvio-contact-drift {
    to {
      transform: translate3d(-8%, 10%, 0) scale(1.12);
    }
  }

  .fluvio-contact-panel__copy,
  .fluvio-contact-panel__action {
    position: relative;
    z-index: 1;
  }

  .fluvio-contact-panel__eyebrow {
    margin: 0 0 1rem;
    color: rgb(var(--fluvio-wash));
    font-family: var(--aw-font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    max-width: 17ch;
    color: inherit;
    font-family: var(--aw-font-heading);
    font-size: clamp(2.1rem, 4.6vw, 4.25rem);
    font-weight: 540;
    letter-spacing: -0.03em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .fluvio-contact-panel__action {
    display: grid;
    gap: 1.6rem;
    align-self: end;
    justify-items: start;
  }

  .fluvio-contact-panel__action p {
    margin: 0;
    max-width: 46ch;
    color: rgb(var(--fluvio-paper) / 0.74);
    line-height: 1.7;
  }

  @media (min-width: 768px) {
    .fluvio-contact-panel {
      grid-template-columns: minmax(0, 1.3fr) minmax(18rem, 0.7fr);
      gap: clamp(3rem, 8vw, 8rem);
    }
  }

  :global(.dark) .fluvio-contact-panel {
    background:
      radial-gradient(120% 110% at 88% -10%, rgb(var(--fluvio-river) / 0.24), transparent 55%),
      radial-gradient(60% 80% at 0% 100%, rgb(var(--fluvio-teal) / 0.16), transparent 60%), rgb(13 36 55);
  }
</style>
