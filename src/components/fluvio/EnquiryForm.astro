---
import ArrowIcon from '~/components/fluvio/ArrowIcon.astro';
import type { Locale } from '~/i18n';
import { getUi } from '~/data/fluvio/store.ts';
export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = getUi(locale).enquiry;
// Public website key; private verification credentials belong only on the enquiry server.
const siteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY || '6LcjiiIuAAAAAAVec0VSmoyKtrllkvtmuj5M6PZH';
---

<form
  class="enquiry-form"
  data-site-key={siteKey}
  data-enquiry-form
  data-sending={copy.sending}
  data-success={copy.success}
  data-error={copy.error}
>
  <div class="enquiry-fields">
    <label>{copy.name}<input name="name" autocomplete="name" maxlength="100" required /></label>
    <label>{copy.email}<input name="email" type="email" autocomplete="email" maxlength="254" required /></label>
    <label>{copy.organisation}<input name="organisation" autocomplete="organization" maxlength="150" /></label>
    <label>{copy.location}<input name="location" maxlength="200" /></label>
  </div>
  <label>{copy.message}<textarea name="message" rows="5" minlength="10" maxlength="4000" required></textarea></label>
  <div class="enquiry-trap" aria-hidden="true">
    <input name="website" tabindex="-1" autocomplete="off" />
  </div>
  <p class="enquiry-note">{copy.note}</p>
  <div class="enquiry-actions">
    <button type="submit" disabled><span>{copy.submit}</span><ArrowIcon /></button>
  </div>
  {
    siteKey && (
      <p class="enquiry-note captcha-note">
        reCAPTCHA ·{' '}
        <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">
          Google Privacy
        </a>{' '}
        ·{' '}
        <a href="https://policies.google.com/terms" target="_blank" rel="noopener noreferrer">
          Terms
        </a>
      </p>
    )
  }
  <p class="enquiry-status" role="status" aria-live="polite" tabindex="-1"></p>
  <noscript><p>{copy.emailOnly}</p></noscript>
</form>
<script>
  type Captcha = {
    enterprise: {
      ready: (callback: () => void) => void;
      execute: (key: string, options: { action: string }) => Promise<string>;
    };
  };
  let captchaLoad: Promise<Captcha> | undefined;
  function loadCaptcha(key: string): Promise<Captcha> {
    if (!captchaLoad)
      captchaLoad = new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = `https://www.google.com/recaptcha/enterprise.js?render=${encodeURIComponent(key)}`;
        script.async = true;
        script.onload = () => {
          const captcha = (window as unknown as { grecaptcha: Captcha }).grecaptcha;
          captcha.enterprise.ready(() => resolve(captcha));
        };
        script.onerror = () => {
          captchaLoad = undefined;
          script.remove();
          reject(new Error('CAPTCHA unavailable'));
        };
        document.head.append(script);
      });
    return captchaLoad;
  }
  function setupEnquiry() {
    document.querySelectorAll<HTMLFormElement>('[data-enquiry-form]').forEach((form) => {
      if (form.dataset.ready) return;
      form.dataset.ready = 'true';
      const button = form.querySelector<HTMLButtonElement>('button')!;
      const status = form.querySelector<HTMLParagraphElement>('[role="status"]')!;
      button.disabled = false;
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (button.disabled || !form.reportValidity()) return;
        const buttonLabel = button.querySelector('span')!;
        const label = buttonLabel.textContent;
        button.disabled = true;
        buttonLabel.textContent = form.dataset.sending!;
        status.textContent = '';
        const controller = new AbortController();
        const timeout = window.setTimeout(() => controller.abort(), 30000);
        try {
          const data: Record<string, FormDataEntryValue> = Object.fromEntries(new FormData(form));
          if (form.dataset.siteKey) {
            const token = await Promise.race([
              loadCaptcha(form.dataset.siteKey).then((captcha) =>
                captcha.enterprise.execute(form.dataset.siteKey!, { action: 'enquiry' })
              ),
              new Promise<never>((_, reject) =>
                controller.signal.addEventListener('abort', () => reject(new Error('CAPTCHA timed out')), {
                  once: true,
                })
              ),
            ]);
            data.recaptchaToken = token;
          }
          const response = await fetch('https://data.fluvio.com.au/api/website-enquiry', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
            signal: controller.signal,
          });
          const result = await response.json();
          if (!response.ok || result.success !== true) throw new Error('Send failed');
          status.textContent = form.dataset.success!;
          form.reset();
        } catch {
          status.textContent = form.dataset.error!;
        } finally {
          window.clearTimeout(timeout);
          button.disabled = false;
          buttonLabel.textContent = label;
          status.focus();
        }
      });
    });
  }
  setupEnquiry();
  document.addEventListener('astro:page-load', setupEnquiry);
</script>
<style>
  .enquiry-form {
    width: 100%;
    display: grid;
    gap: 1.35rem;
  }
  .enquiry-fields {
    display: grid;
    gap: 1.35rem;
  }
  label {
    display: grid;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 0.9rem;
  }
  input:hover,
  textarea:hover {
    border-color: rgb(var(--fluvio-river) / 0.6);
  }
  input,
  textarea {
    width: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid rgb(var(--fluvio-ink) / 0.18);
    border-radius: 10px;
    background: rgb(var(--fluvio-river) / 0.035);
    color: var(--aw-color-text-default);
    font: inherit;
    font-weight: 400;
    transition:
      border-color 0.2s,
      background 0.2s,
      box-shadow 0.2s;
  }
  textarea {
    resize: vertical;
  }
  input:focus-visible,
  textarea:focus-visible,
  button:focus-visible {
    outline: 3px solid rgb(var(--fluvio-river));
    outline-offset: 3px;
  }
  .enquiry-actions {
    display: flex;
  }
  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    cursor: pointer;
    transition:
      background 0.2s,
      box-shadow 0.2s;

    justify-self: start;
    border-radius: 99px;
    padding: 1rem 1.7rem;
    color: white;
    background: rgb(var(--fluvio-river));
    font-weight: 600;
  }
  button:hover:not(:disabled) {
    background: rgb(var(--fluvio-ink));
    box-shadow: 0 8px 20px rgb(var(--fluvio-river) / 0.18);
  }
  button :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }
  @media (max-width: 599px) {
    button {
      width: 100%;
    }
  }
  button:disabled {
    opacity: 0.6;
    cursor: wait;
  }
  a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .enquiry-note {
    font-size: 0.85rem;
    color: var(--aw-color-text-muted);
  }
  .enquiry-status:empty {
    display: none;
  }
  .enquiry-status {
    line-height: 1.6;
  }
  .enquiry-trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  @media (min-width: 600px) {
    .enquiry-fields {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
