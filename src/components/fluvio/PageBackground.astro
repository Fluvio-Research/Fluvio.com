---
/**
 * Site-wide hydrological and technology atmosphere, drawn from the Fluvio
 * logo mark: a mineral-blue sensor-network pattern, topographic contour
 * fields and soft river/silt colour washes. Every layer is fixed behind the
 * content, pointer-safe and static under reduced motion.
 */
export interface Props {
  variant?: 'default' | 'quiet' | 'deep';
}

const { variant = 'default' } = Astro.props;
---

<fluvio-page-background aria-hidden="true">
  <div class:list={['fluvio-atmosphere', `fluvio-atmosphere--${variant}`]}>
    <div class="fluvio-atmosphere__network"></div>
  </div>
</fluvio-page-background>

<style>
  fluvio-page-background {
    --fluvio-pointer-x: 0px;
    --fluvio-pointer-y: 0px;
    display: contents;
  }

  .fluvio-atmosphere {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .fluvio-atmosphere::before,
  .fluvio-atmosphere::after,
  .fluvio-atmosphere__network {
    position: absolute;
    inset: -12%;
    content: '';
    pointer-events: none;
    transform: translate3d(var(--fluvio-pointer-x), var(--fluvio-pointer-y), 0);
  }

  /* Soft water and landscape washes: mist, river, mineral and a hint of silt. */
  .fluvio-atmosphere::before {
    background:
      radial-gradient(circle at 12% 10%, rgb(var(--fluvio-wash) / 0.55), transparent 32%),
      radial-gradient(circle at 88% 30%, rgb(var(--fluvio-river) / 0.1), transparent 34%),
      radial-gradient(circle at 18% 78%, rgb(var(--fluvio-mineral) / 0.12), transparent 30%),
      radial-gradient(circle at 78% 92%, rgb(var(--fluvio-silt) / 0.08), transparent 30%);
    opacity: 0.6;
  }

  /* Topographic contour field in river blue. */
  .fluvio-atmosphere::after {
    background: repeating-radial-gradient(
      ellipse at 84% 16%,
      transparent 0 42px,
      rgb(var(--fluvio-river) / 0.07) 43px 44px,
      transparent 45px 82px
    );
    opacity: 0.5;
  }

  /* Sensor-network pattern from the logo mark, kept to outer gutters. */
  .fluvio-atmosphere__network {
    background-image: url('/patterns/fluvio-network.svg');
    background-size: 300px 300px;
    mask-image:
      radial-gradient(60rem 52rem at 98% 0%, rgb(0 0 0) 0%, transparent 72%),
      radial-gradient(52rem 46rem at 0% 96%, rgb(0 0 0 / 0.9) 0%, transparent 70%);
    opacity: 0.32;
  }

  .fluvio-atmosphere--quiet::before {
    opacity: 0.45;
  }

  .fluvio-atmosphere--quiet::after {
    opacity: 0.36;
  }

  .fluvio-atmosphere--quiet .fluvio-atmosphere__network {
    opacity: 0.2;
  }

  .fluvio-atmosphere--deep::before {
    background:
      radial-gradient(circle at 12% 14%, rgb(var(--fluvio-river) / 0.16), transparent 30%),
      radial-gradient(circle at 82% 42%, rgb(var(--fluvio-mineral) / 0.14), transparent 35%);
    opacity: 0.65;
  }

  .fluvio-atmosphere--deep::after {
    opacity: 0.55;
  }

  :global(.dark) .fluvio-atmosphere::before {
    background:
      radial-gradient(circle at 12% 10%, rgb(var(--fluvio-navy) / 0.5), transparent 34%),
      radial-gradient(circle at 88% 30%, rgb(var(--fluvio-river) / 0.14), transparent 34%),
      radial-gradient(circle at 18% 78%, rgb(var(--fluvio-mineral) / 0.1), transparent 30%),
      radial-gradient(circle at 78% 92%, rgb(var(--fluvio-silt) / 0.06), transparent 30%);
    opacity: 0.5;
  }

  :global(.dark) .fluvio-atmosphere::after {
    opacity: 0.3;
  }

  :global(.dark) .fluvio-atmosphere__network {
    opacity: 0.22;
  }

  @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
    .fluvio-atmosphere::before {
      animation: fluvio-water-drift 24s ease-in-out infinite alternate;
    }

    .fluvio-atmosphere::after {
      animation: fluvio-contour-drift 32s ease-in-out infinite alternate;
    }

    .fluvio-atmosphere__network {
      animation: fluvio-network-drift 40s ease-in-out infinite alternate;
    }
  }

  @keyframes fluvio-water-drift {
    to {
      transform: translate3d(calc(var(--fluvio-pointer-x) + 2.5%), calc(var(--fluvio-pointer-y) - 1.5%), 0) scale(1.025);
    }
  }

  @keyframes fluvio-contour-drift {
    to {
      transform: translate3d(calc(var(--fluvio-pointer-x) - 1.5%), calc(var(--fluvio-pointer-y) + 2%), 0);
    }
  }

  @keyframes fluvio-network-drift {
    to {
      transform: translate3d(calc(var(--fluvio-pointer-x) + 1.25%), calc(var(--fluvio-pointer-y) + 1.5%), 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fluvio-atmosphere::before,
    .fluvio-atmosphere::after,
    .fluvio-atmosphere__network {
      animation: none !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  class FluvioPageBackground extends HTMLElement {
    private media?: MediaQueryList;
    private abortController?: AbortController;
    private frame = 0;
    private pointerX = 0;
    private pointerY = 0;

    private updatePointer = () => {
      this.style.setProperty('--fluvio-pointer-x', `${this.pointerX}px`);
      this.style.setProperty('--fluvio-pointer-y', `${this.pointerY}px`);
      this.frame = 0;
    };

    private onPointerMove = (event: PointerEvent) => {
      this.pointerX = (event.clientX / window.innerWidth - 0.5) * 20;
      this.pointerY = (event.clientY / window.innerHeight - 0.5) * 16;
      if (!this.frame) this.frame = window.requestAnimationFrame(this.updatePointer);
    };

    private syncPointerTracking = () => {
      this.abortController?.abort();
      this.abortController = undefined;
      if (this.frame) {
        window.cancelAnimationFrame(this.frame);
        this.frame = 0;
      }

      if (!this.media?.matches) {
        this.style.removeProperty('--fluvio-pointer-x');
        this.style.removeProperty('--fluvio-pointer-y');
        return;
      }

      this.abortController = new AbortController();
      document.addEventListener('pointermove', this.onPointerMove, {
        passive: true,
        signal: this.abortController.signal,
      });
    };

    connectedCallback() {
      this.media = window.matchMedia(
        '(min-width: 768px) and (pointer: fine) and (prefers-reduced-motion: no-preference)'
      );
      this.media.addEventListener('change', this.syncPointerTracking);
      this.syncPointerTracking();
    }

    disconnectedCallback() {
      this.abortController?.abort();
      this.media?.removeEventListener('change', this.syncPointerTracking);
      if (this.frame) window.cancelAnimationFrame(this.frame);
    }
  }

  if (!customElements.get('fluvio-page-background')) {
    customElements.define('fluvio-page-background', FluvioPageBackground);
  }
</script>
