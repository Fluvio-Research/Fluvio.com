---
/**
 * The lead project on a page: a wide photograph, then title, summary, call
 * to action and the project facts. The photograph morphs into the project
 * page hero through its view-transition name.
 */
import ArrowLink from './ArrowLink.astro';
import LargeImage from './LargeImage.astro';
import ProjectMeta from './ProjectMeta.astro';
import { projectHref } from '~/data/fluvio/routes';
import type { Project } from '~/data/fluvio/types';
import { defaultLocale, t, type Locale } from '~/i18n';

export interface Props {
  project: Project;
  eyebrow?: string;
  priority?: boolean;
  locale?: Locale;
}

const { project, priority = false, locale = defaultLocale } = Astro.props;
const strings = t(locale).project;
const { eyebrow = strings.featuredEyebrow } = Astro.props;
const href = projectHref(project.slug, locale);
---

<article class="fluvio-project-feature">
  <a class="fluvio-project-feature__image" href={href} tabindex="-1" aria-hidden="true">
    <LargeImage
      src={project.heroImage}
      alt={project.heroAlt}
      aspect="hero"
      radius="lg"
      priority={priority}
      sizes="(min-width: 1280px) 1280px, (min-width: 768px) calc(100vw - 4rem), calc(100vw - 2rem)"
      transitionName={`project-${project.slug}`}
    />
  </a>
  <div class="fluvio-project-feature__body">
    <div>
      {eyebrow && <p class="fluvio-project-feature__eyebrow">{eyebrow}</p>}
      <h2><a href={href}>{project.title}</a></h2>
    </div>
    <div class="fluvio-project-feature__summary">
      <p>{project.summary}</p>
      <ArrowLink href={href} variant="pill">{strings.viewProject}</ArrowLink>
    </div>
  </div>
  <ProjectMeta project={project} locale={locale} compact />
</article>

<style>
  .fluvio-project-feature {
    display: grid;
    gap: 1.75rem;
  }

  .fluvio-project-feature__image {
    display: block;
    border-radius: 20px;
  }

  .fluvio-project-feature__body {
    display: grid;
    gap: 1.25rem;
  }

  .fluvio-project-feature__eyebrow {
    margin: 0 0 0.75rem;
    color: rgb(var(--fluvio-river));
    font-family: var(--aw-font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  :global(.dark) .fluvio-project-feature__eyebrow {
    color: rgb(125 186 188);
  }

  h2 {
    margin: 0;
    max-width: 20ch;
    font-family: var(--aw-font-heading);
    font-size: clamp(1.9rem, 4vw, 4rem);
    font-weight: 560;
    letter-spacing: -0.03em;
    line-height: 1.02;
    text-wrap: balance;
  }

  h2 a {
    color: var(--aw-color-text-heading);
    text-decoration: none;
  }

  h2 a:hover {
    color: rgb(var(--fluvio-river));
  }

  .fluvio-project-feature__summary {
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }

  .fluvio-project-feature__summary p {
    margin: 0;
    max-width: 48ch;
    color: var(--aw-color-text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  @media (prefers-reduced-motion: no-preference) {
    h2 a {
      transition: color 220ms ease;
    }
  }

  @media (min-width: 768px) {
    .fluvio-project-feature__body {
      grid-template-columns: minmax(0, 1.4fr) minmax(18rem, 0.6fr);
      align-items: end;
      gap: clamp(3rem, 8vw, 8rem);
    }
  }
</style>
