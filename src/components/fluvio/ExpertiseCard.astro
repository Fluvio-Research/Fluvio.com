---
/**
 * An expertise area as a card. `media` is a surface card: the area's clip or
 * photograph on top, then index, title, summary and a footer with the
 * project count and the arrow control. `compact` is text only, for pages
 * whose photography is already on screen (a project page listing the
 * capabilities behind it). One stretched link.
 */
import ArrowIcon from './ArrowIcon.astro';
import ExpertiseMedia from './ExpertiseMedia.astro';
import { expertiseHref } from '~/data/fluvio/routes';
import type { ExpertiseArea } from '~/data/fluvio/types';
import { defaultLocale, t, type Locale } from '~/i18n';

export interface Props {
  area: ExpertiseArea;
  locale?: Locale;
  index?: number;
  variant?: 'media' | 'compact';
  headingLevel?: 'h2' | 'h3';
  projectCount?: number;
  priority?: boolean;
  class?: string;
}

const {
  area,
  locale = defaultLocale,
  index,
  variant = 'media',
  headingLevel: Heading = 'h3',
  projectCount,
  priority = false,
  class: className,
  ...rest
} = Astro.props;
const strings = t(locale).expertisePage;
const href = expertiseHref(area.slug, locale);
const number = index === undefined ? undefined : String(index + 1).padStart(2, '0');
const count =
  projectCount === undefined
    ? undefined
    : projectCount === 1
      ? strings.projectCountOne
      : strings.projectCountTemplate.replace('{count}', String(projectCount));
---

<article
  {...rest}
  class:list={['fluvio-expertise-card fluvio-arrow-host', `fluvio-expertise-card--${variant}`, className]}
  id={variant === 'media' ? area.slug : undefined}
>
  {
    variant === 'media' && (
      <div class="fluvio-expertise-card__media">
        <ExpertiseMedia
          area={area}
          aspect="wide"
          radius="none"
          priority={priority}
          sizes="(min-width: 1280px) 640px, (min-width: 768px) 50vw, calc(100vw - 2rem)"
          transitionName={`expertise-${area.slug}`}
        />
        {number && <span class="fluvio-expertise-card__number">{number}</span>}
      </div>
    )
  }
  <div class="fluvio-expertise-card__body">
    {
      variant === 'compact' && (
        <p class="fluvio-label fluvio-expertise-card__label">
          {number && <span>{number}</span>}
          {count && <span class="fluvio-expertise-card__count">{count}</span>}
        </p>
      )
    }
    <Heading class="fluvio-expertise-card__title">
      <a href={href}>{area.title}</a>
    </Heading>
    <p class="fluvio-expertise-card__summary">{area.summary}</p>
    <div class="fluvio-expertise-card__foot">
      {variant === 'media' && count && <span class="fluvio-expertise-card__count">{count}</span>}
      <span class="fluvio-expertise-card__cta">
        <span>{strings.viewArea}</span>
        <ArrowIcon size="sm" />
      </span>
    </div>
  </div>
</article>

<style>
  .fluvio-expertise-card {
    --card-radius: 22px;
    --card-line: rgb(var(--fluvio-ink) / 0.1);
    --card-surface: rgb(var(--fluvio-paper) / 0.72);
    position: relative;
    display: grid;
    align-content: start;
    height: 100%;
  }

  :global(.dark) .fluvio-expertise-card {
    --card-line: rgb(var(--fluvio-mist) / 0.12);
    --card-surface: rgb(var(--fluvio-navy) / 0.28);
  }

  .fluvio-expertise-card--media {
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border: 1px solid var(--card-line);
    border-radius: var(--card-radius);
    background: var(--card-surface);
    backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.5) inset;
  }

  :global(.dark) .fluvio-expertise-card--media {
    box-shadow: none;
  }

  .fluvio-expertise-card--compact {
    --card-radius: 16px;
    padding: 1.6rem 1.5rem 1.5rem;
    border: 1px solid var(--card-line);
    border-radius: var(--card-radius);
    background: rgb(var(--fluvio-paper) / 0.6);
  }

  :global(.dark) .fluvio-expertise-card--compact {
    background: rgb(var(--fluvio-navy) / 0.22);
  }

  .fluvio-expertise-card__media {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .fluvio-expertise-card__media :global(.fluvio-image__frame),
  .fluvio-expertise-card__media :global(.fluvio-expertise-media__frame) {
    border-radius: 0;
  }

  .fluvio-expertise-card__number {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    z-index: 2;
    padding: 0.38rem 0.7rem;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 999px;
    background: rgb(var(--fluvio-ink) / 0.48);
    backdrop-filter: blur(12px);
    color: rgb(var(--fluvio-paper));
    font-family: var(--aw-font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    pointer-events: none;
  }

  .fluvio-expertise-card__body {
    display: grid;
    gap: 0.7rem;
    align-content: start;
    height: 100%;
    padding: 1.35rem 1.4rem 1.35rem;
  }

  .fluvio-expertise-card--media .fluvio-expertise-card__body {
    grid-template-rows: auto 1fr auto;
  }

  .fluvio-expertise-card--compact .fluvio-expertise-card__body {
    padding: 0;
  }

  .fluvio-expertise-card__label {
    display: flex;
    gap: 0.75rem;
    margin: 0;
  }

  .fluvio-expertise-card__count {
    color: var(--aw-color-text-muted);
    font-family: var(--aw-font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .fluvio-expertise-card__title {
    margin: 0;
    font-family: var(--aw-font-heading);
    font-size: clamp(1.35rem, 2.2vw, 1.85rem);
    font-weight: 560;
    letter-spacing: -0.025em;
    line-height: 1.12;
    text-wrap: balance;
  }

  .fluvio-expertise-card--compact .fluvio-expertise-card__title {
    font-size: clamp(1.15rem, 1.6vw, 1.4rem);
  }

  .fluvio-expertise-card__title a {
    color: var(--aw-color-text-heading);
    text-decoration: none;
  }

  .fluvio-expertise-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: var(--card-radius);
  }

  .fluvio-expertise-card__summary {
    margin: 0;
    max-width: 52ch;
    color: var(--aw-color-text-muted);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .fluvio-expertise-card--compact .fluvio-expertise-card__summary {
    font-size: 0.9rem;
  }

  .fluvio-expertise-card__foot {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.5rem;
  }

  .fluvio-expertise-card--media .fluvio-expertise-card__foot {
    padding-top: 0.9rem;
    border-top: 1px solid var(--card-line);
  }

  .fluvio-expertise-card--compact .fluvio-expertise-card__foot {
    margin-top: 1.25rem;
  }

  .fluvio-expertise-card__cta {
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
    margin-left: auto;
    color: var(--arrow-color);
    font-size: 0.84rem;
    font-weight: 600;
  }

  @media (prefers-reduced-motion: no-preference) {
    .fluvio-expertise-card__title a {
      transition: color 220ms ease;
    }

    .fluvio-expertise-card--media,
    .fluvio-expertise-card--compact {
      transition:
        border-color 240ms ease,
        transform 420ms cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 420ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    @media (hover: hover) {
      .fluvio-expertise-card--media:hover {
        transform: translateY(-5px);
        box-shadow:
          0 1px 0 rgb(255 255 255 / 0.5) inset,
          0 24px 48px -18px rgb(var(--fluvio-ink) / 0.28);
      }

      .fluvio-expertise-card--compact:hover {
        transform: translateY(-2px);
        box-shadow: 0 14px 34px rgb(var(--fluvio-ink) / 0.08);
      }

      :global(.dark) .fluvio-expertise-card--media:hover {
        box-shadow: 0 24px 48px -18px rgb(0 0 0 / 0.6);
      }
    }
  }

  .fluvio-expertise-card:hover {
    border-color: rgb(var(--fluvio-river) / 0.45);
  }

  .fluvio-expertise-card:hover .fluvio-expertise-card__title a {
    color: rgb(var(--fluvio-river));
  }

  :global(.dark) .fluvio-expertise-card:hover .fluvio-expertise-card__title a {
    color: rgb(125 186 188);
  }

  .fluvio-expertise-card:has(a:focus-visible) {
    outline: 2px solid rgb(var(--fluvio-river));
    outline-offset: 4px;
  }

  .fluvio-expertise-card__title a:focus-visible {
    outline: none;
  }
</style>
