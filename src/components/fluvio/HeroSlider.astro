---
import LargeImage from './LargeImage.astro';
import { defaultLocale, localeHref, t, type Locale } from '~/i18n';

export interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const strings = t(locale).slider;

const slideImages = [
  '~/assets/images/fluvio/home-river.jpg',
  '~/assets/images/fluvio/project-bina.jpeg',
  '~/assets/images/fluvio/project-honiara.jpeg',
  '~/assets/images/fluvio/project-advance-queensland.jpeg',
  '~/assets/images/fluvio/vision-field-team.jpeg',
];

const slides = strings.slides.map((slide, index) => ({ ...slide, image: slideImages[index] }));

/** Autoplay cycle length; the CSS countdown reads the same value. */
const INTERVAL_MS = 6000;
---

<fluvio-hero-slider
  class="fluvio-hero"
  role="region"
  aria-roledescription="carousel"
  aria-label={strings.regionLabel}
  tabindex="0"
  style={`--hero-interval: ${INTERVAL_MS}ms`}
  data-interval={INTERVAL_MS}
  data-label-pause={strings.pause}
  data-label-resume={strings.resume}
  data-label-pause-aria={strings.pauseAria}
  data-label-resume-aria={strings.resumeAria}
  data-label-autoplay-off={strings.autoplayOff}
  data-label-autoplay-off-aria={strings.autoplayOffAria}
  data-status-template={strings.statusTemplate}
>
  <div class="fluvio-hero__slides">
    {
      slides.map((slide, index) => (
        <article
          class:list={['fluvio-hero__slide', { 'is-active': index === 0 }]}
          data-hero-slide
          role="group"
          aria-roledescription="slide"
          aria-label={`${index + 1} ${strings.slideOf} ${slides.length}`}
          inert={index !== 0}
        >
          <div class="fluvio-hero__media">
            <LargeImage src={slide.image} alt={slide.imageAlt} aspect="fill" priority={index === 0} />
          </div>
          <div class="fluvio-hero__scrim" aria-hidden="true" />
          <div class="fluvio-hero__copy">
            <div class="fluvio-shell fluvio-hero__content">
              <p class="fluvio-hero__eyebrow">{slide.eyebrow}</p>
              <h1>{slide.title}</h1>
              <p class="fluvio-hero__description">{slide.description}</p>
              <a class="fluvio-hero__link" href={localeHref(slide.href, locale)}>
                {slide.action} <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <div class="fluvio-hero__navigation" aria-label="Slide controls">
    <div class="fluvio-shell fluvio-hero__navrow">
      <div class="fluvio-hero__count" aria-hidden="true">
        <span data-hero-current>01</span>
        <span>/</span>
        <span>{String(slides.length).padStart(2, '0')}</span>
      </div>
      <div class="fluvio-hero__progress" aria-hidden="true">
        <span data-hero-progress style={`--hero-progress: ${100 / slides.length}%`}></span>
      </div>
      <div class="fluvio-hero__buttons">
        <button class="fluvio-hero__playback" type="button" aria-label={strings.pauseAria} data-hero-playback>
          <span data-hero-playback-label>{strings.pause}</span>
        </button>
        <button type="button" aria-label={strings.previous} data-hero-previous>
          <span aria-hidden="true">←</span>
        </button>
        <button type="button" aria-label={strings.next} data-hero-next>
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </div>

  <p class="visually-hidden" aria-live="polite" aria-atomic="true" data-hero-status>
    {
      strings.statusTemplate
        .replace('{current}', '1')
        .replace('{total}', String(slides.length))
        .replace('{title}', slides[0].title)
    }
  </p>
</fluvio-hero-slider>

<script>
  class FluvioHeroSlider extends HTMLElement {
    private activeIndex = 0;
    private timer?: number;
    private slides: HTMLElement[] = [];
    private reducedMotion?: MediaQueryList;
    private manuallyPaused = false;

    connectedCallback() {
      this.slides = Array.from(this.querySelectorAll<HTMLElement>('[data-hero-slide]'));
      if (this.slides.length < 2) return;

      this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      this.querySelector('[data-hero-playback]')?.addEventListener('click', this.togglePlayback);
      this.querySelector('[data-hero-previous]')?.addEventListener('click', this.previous);
      this.querySelector('[data-hero-next]')?.addEventListener('click', this.next);
      this.addEventListener('keydown', this.handleKeydown);
      this.addEventListener('mouseenter', this.pause);
      this.addEventListener('mouseleave', this.resume);
      this.addEventListener('focusin', this.pause);
      this.addEventListener('focusout', this.handleFocusOut);
      this.reducedMotion.addEventListener('change', this.handleMotionChange);
      this.show(0, false);
      this.updatePlaybackControl();
      this.resume();
    }

    disconnectedCallback() {
      this.pause();
      this.querySelector('[data-hero-playback]')?.removeEventListener('click', this.togglePlayback);
      this.querySelector('[data-hero-previous]')?.removeEventListener('click', this.previous);
      this.querySelector('[data-hero-next]')?.removeEventListener('click', this.next);
      this.removeEventListener('keydown', this.handleKeydown);
      this.removeEventListener('mouseenter', this.pause);
      this.removeEventListener('mouseleave', this.resume);
      this.removeEventListener('focusin', this.pause);
      this.removeEventListener('focusout', this.handleFocusOut);
      this.reducedMotion?.removeEventListener('change', this.handleMotionChange);
    }

    private previous = () => this.show(this.activeIndex - 1);
    private next = () => this.show(this.activeIndex + 1);
    private advance = () => this.show(this.activeIndex + 1, false);

    private show(index: number, announce = true) {
      this.activeIndex = (index + this.slides.length) % this.slides.length;
      this.slides.forEach((slide, slideIndex) => {
        const active = slideIndex === this.activeIndex;
        slide.classList.toggle('is-active', active);
        slide.toggleAttribute('inert', !active);
      });

      const current = this.querySelector<HTMLElement>('[data-hero-current]');
      const progress = this.querySelector<HTMLElement>('[data-hero-progress]');
      const status = this.querySelector<HTMLElement>('[data-hero-status]');
      const title = this.slides[this.activeIndex]?.querySelector('h1')?.textContent?.trim() ?? '';

      if (current) current.textContent = String(this.activeIndex + 1).padStart(2, '0');
      progress?.style.setProperty('--hero-progress', `${((this.activeIndex + 1) / this.slides.length) * 100}%`);
      if (announce && status) {
        const template = this.dataset.statusTemplate ?? 'Slide {current} of {total}: {title}';
        status.textContent = template
          .replace('{current}', String(this.activeIndex + 1))
          .replace('{total}', String(this.slides.length))
          .replace('{title}', title);
      }
      if (this.timer) this.restartCountdown();
    }

    private handleKeydown = (event: KeyboardEvent) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        this.previous();
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        this.next();
      } else if (event.key === 'Home') {
        event.preventDefault();
        this.show(0);
      } else if (event.key === 'End') {
        event.preventDefault();
        this.show(this.slides.length - 1);
      }
    };

    private pause = () => {
      if (this.timer) window.clearInterval(this.timer);
      this.timer = undefined;
      this.classList.remove('is-playing');
    };

    private resume = () => {
      this.pause();
      if (
        this.manuallyPaused ||
        this.reducedMotion?.matches ||
        this.matches(':hover') ||
        this.contains(document.activeElement)
      )
        return;
      this.timer = window.setInterval(this.advance, Number(this.dataset.interval) || 6000);
      this.classList.add('is-playing');
      this.restartCountdown();
    };

    /* Restart the visual autoplay countdown so it stays in step with the timer. */
    private restartCountdown() {
      const bar = this.querySelector<HTMLElement>('[data-hero-progress]');
      if (!bar) return;
      bar.style.animation = 'none';
      void bar.offsetWidth;
      bar.style.animation = '';
    }

    private togglePlayback = () => {
      this.manuallyPaused = !this.manuallyPaused;
      this.updatePlaybackControl();
      if (this.manuallyPaused) this.pause();
      else this.resume();
    };

    private updatePlaybackControl() {
      const button = this.querySelector<HTMLButtonElement>('[data-hero-playback]');
      const label = button?.querySelector<HTMLElement>('[data-hero-playback-label]');
      if (!button || !label) return;

      if (this.reducedMotion?.matches) {
        button.disabled = true;
        button.setAttribute('aria-label', this.dataset.labelAutoplayOffAria ?? 'Autoplay off');
        label.textContent = this.dataset.labelAutoplayOff ?? 'Autoplay off';
        return;
      }

      button.disabled = false;
      button.setAttribute(
        'aria-label',
        (this.manuallyPaused ? this.dataset.labelResumeAria : this.dataset.labelPauseAria) ?? ''
      );
      label.textContent = (this.manuallyPaused ? this.dataset.labelResume : this.dataset.labelPause) ?? '';
    }

    private handleFocusOut = () => window.setTimeout(this.resume, 0);

    private handleMotionChange = () => {
      this.pause();
      if (this.reducedMotion?.matches) this.show(0, false);
      else this.resume();
      this.updatePlaybackControl();
    };
  }

  if (!customElements.get('fluvio-hero-slider')) customElements.define('fluvio-hero-slider', FluvioHeroSlider);
</script>

<style>
  .fluvio-hero {
    position: relative;
    display: block;
    width: 100%;
    outline: none;
  }

  .fluvio-hero:focus-visible {
    outline: 2px solid rgb(var(--fluvio-river));
    outline-offset: -4px;
  }

  .fluvio-hero__slides {
    display: grid;
  }

  .fluvio-hero__slide {
    position: relative;
    grid-area: 1 / 1;
    display: flex;
    align-items: flex-end;
    min-height: clamp(32rem, 92dvh, 56rem);
    overflow: hidden;
    z-index: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 800ms ease,
      visibility 0s linear 800ms;
  }

  .fluvio-hero__slide.is-active {
    z-index: 1;
    opacity: 1;
    visibility: visible;
    transition: opacity 800ms ease;
  }

  .fluvio-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  /* Slow settle-in zoom on the active photograph. */
  @media (prefers-reduced-motion: no-preference) {
    .fluvio-hero__slide.is-active .fluvio-hero__media :global(img) {
      animation: fluvio-hero-settle 11s cubic-bezier(0.2, 0.6, 0.35, 1) both;
    }
  }

  @keyframes fluvio-hero-settle {
    from {
      transform: scale(1.07);
    }
    to {
      transform: scale(1);
    }
  }

  /* Legibility scrim: deep ink from the copy corner, never a flat filter. */
  .fluvio-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(
        76deg,
        rgb(var(--fluvio-ink) / 0.82) 0%,
        rgb(var(--fluvio-ink) / 0.58) 38%,
        rgb(var(--fluvio-ink) / 0.14) 64%,
        rgb(var(--fluvio-ink) / 0) 82%
      ),
      linear-gradient(0deg, rgb(var(--fluvio-ink) / 0.68) 0%, rgb(var(--fluvio-ink) / 0) 42%);
  }

  .fluvio-hero__copy {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: clamp(6rem, 16vh, 9rem) 0 clamp(7.5rem, 14vh, 9.5rem);
  }

  .fluvio-hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .fluvio-hero__eyebrow {
    margin: 0 0 1.4rem;
    color: rgb(216 238 244);
    font-family: var(--aw-font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    max-width: 15ch;
    color: rgb(var(--fluvio-paper));
    font-family: var(--aw-font-heading);
    font-size: clamp(2.6rem, 6vw, 5.75rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
    text-wrap: balance;
  }

  .fluvio-hero__description {
    margin: clamp(1.25rem, 2.5vw, 2rem) 0 0;
    max-width: 34rem;
    color: rgb(226 236 242 / 0.92);
    font-size: clamp(1rem, 1.5vw, 1.18rem);
    line-height: 1.65;
  }

  .fluvio-hero__link {
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    padding: 0.85rem 1.6rem;
    border: 1px solid rgb(255 255 255 / 0.45);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.1);
    backdrop-filter: blur(10px);
    color: rgb(var(--fluvio-paper));
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 250ms ease,
      border-color 250ms ease;
  }

  .fluvio-hero__link:hover {
    border-color: rgb(255 255 255 / 0.75);
    background: rgb(255 255 255 / 0.22);
  }

  .fluvio-hero__link > span[aria-hidden] {
    transition: transform 250ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .fluvio-hero__link:hover > span[aria-hidden] {
    transform: translateX(0.3rem);
  }

  /* Copy rises softly as each slide becomes active. */
  @media (prefers-reduced-motion: no-preference) {
    .fluvio-hero__slide.is-active .fluvio-hero__content > * {
      animation: fluvio-hero-rise 900ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .fluvio-hero__slide.is-active .fluvio-hero__content > :nth-child(2) {
      animation-delay: 90ms;
    }

    .fluvio-hero__slide.is-active .fluvio-hero__content > :nth-child(3) {
      animation-delay: 180ms;
    }

    .fluvio-hero__slide.is-active .fluvio-hero__content > :nth-child(4) {
      animation-delay: 270ms;
    }
  }

  @keyframes fluvio-hero-rise {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Overlaid slide controls */
  .fluvio-hero__navigation {
    position: absolute;
    inset-inline: 0;
    bottom: clamp(1.5rem, 4vh, 2.75rem);
    z-index: 3;
  }

  .fluvio-hero__navrow {
    display: grid;
    grid-template-columns: auto minmax(3rem, 1fr) auto;
    gap: clamp(1rem, 3vw, 2rem);
    align-items: center;
  }

  .fluvio-hero__count {
    display: flex;
    gap: 0.4rem;
    color: rgb(255 255 255 / 0.65);
    font-family: var(--aw-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }

  .fluvio-hero__count [data-hero-current] {
    color: rgb(var(--fluvio-paper));
  }

  .fluvio-hero__progress {
    height: 2px;
    overflow: hidden;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.25);
  }

  .fluvio-hero__progress span {
    display: block;
    width: var(--hero-progress);
    height: 100%;
    border-radius: 999px;
    background: rgb(var(--fluvio-paper));
    transition: width 350ms ease;
  }

  /* Autoplay countdown: the bar fills across each 8 second cycle. */
  @media (prefers-reduced-motion: no-preference) {
    .fluvio-hero.is-playing .fluvio-hero__progress span {
      animation: fluvio-hero-countdown var(--hero-interval, 6s) linear both;
    }
  }

  @keyframes fluvio-hero-countdown {
    from {
      width: 0;
    }
    to {
      width: 100%;
    }
  }

  .fluvio-hero__buttons {
    display: flex;
    gap: 0.5rem;
  }

  button {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.4);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.08);
    backdrop-filter: blur(10px);
    color: rgb(var(--fluvio-paper));
    cursor: pointer;
    font-size: 1rem;
    place-items: center;
    transition:
      background-color 250ms ease,
      border-color 250ms ease;
  }

  button:hover:not(:disabled) {
    border-color: rgb(255 255 255 / 0.75);
    background: rgb(255 255 255 / 0.2);
  }

  .fluvio-hero__playback {
    width: auto;
    min-width: 5rem;
    padding-inline: 1rem;
    font-family: var(--aw-font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
  }

  button:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .fluvio-hero a:focus-visible,
  .fluvio-hero button:focus-visible {
    outline-color: rgb(255 255 255 / 0.9);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 767px) {
    .fluvio-hero__slide {
      min-height: clamp(30rem, 88dvh, 44rem);
    }

    .fluvio-hero__navrow {
      grid-template-columns: auto minmax(2rem, 1fr) auto;
    }

    .fluvio-hero__playback {
      min-width: 4.25rem;
      padding-inline: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fluvio-hero *,
    .fluvio-hero *::before,
    .fluvio-hero *::after {
      scroll-behavior: auto !important;
      transition: none !important;
      animation: none !important;
    }
  }
</style>
