---
/**
 * One live platform, presented like a product: the screenshot in a dark
 * device bezel on its own tinted stage, tilted a few degrees and settling
 * flat on hover, with further screens fanned in front of it. Then the name,
 * description, a feature list and the link to the deployment.
 */
import ArrowLink from './ArrowLink.astro';
import LargeImage from './LargeImage.astro';
import { getHomepage } from '~/data/fluvio/store.ts';
import { defaultLocale, type Locale } from '~/i18n';

export interface Props {
  title: string;
  description: string;
  href?: string;
  actionLabel?: string;
  image?: string;
  imageAlt?: string;
  /** Where the screenshot links to; falls back to `href`. */
  imageHref?: string;
  highlights?: string[];
  screens?: Array<{ image: string; imageAlt: string }>;
  index?: number;
  locale?: Locale;
}

const {
  title,
  description,
  href,
  actionLabel,
  image,
  imageAlt = '',
  imageHref,
  highlights = [],
  screens = [],
  index,
  locale = defaultLocale,
} = Astro.props;
const platformLabel = getHomepage(locale).platforms.label;

const shotHref = imageHref ?? href;
const shotHost = shotHref?.startsWith('http') ? new URL(shotHref).hostname : undefined;
const shotSizes = '(min-width: 1280px) 640px, (min-width: 768px) 48vw, calc(100vw - 2rem)';
const screenSizes = '(min-width: 1280px) 300px, (min-width: 768px) 24vw, calc(50vw - 1.5rem)';

/* Each stage takes a tint from the palette in turn: river, mineral, coral, teal. */
const stages = [
  ['var(--fluvio-river)', 'var(--fluvio-teal)'],
  ['var(--fluvio-navy)', 'var(--fluvio-mineral)'],
  ['var(--fluvio-navy)', 'var(--fluvio-coral)'],
  ['var(--fluvio-teal)', 'var(--fluvio-river)'],
] as const;
const [stageA, stageB] = stages[(index ?? 0) % stages.length];
---

<article class="fluvio-platform-feature" style={`--stage-a: ${stageA}; --stage-b: ${stageB}`}>
  {
    image && (
      <div
        class:list={['fluvio-platform-feature__stage', { 'fluvio-platform-feature__stage--fan': screens.length > 0 }]}
      >
        <div class="fluvio-platform-feature__glow" aria-hidden="true" />
        {shotHref ? (
          <a class="fluvio-platform-feature__shot" href={shotHref} rel="noopener">
            <div class="fluvio-platform-feature__chrome" aria-hidden="true">
              <span class="fluvio-platform-feature__dots">
                <span />
                <span />
                <span />
              </span>
              {shotHost && <span class="fluvio-platform-feature__host">{shotHost}</span>}
              <svg
                class="fluvio-platform-feature__open"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M7 17 17 7" />
                <path d="M8 7h9v9" />
              </svg>
            </div>
            <LargeImage src={image} alt={imageAlt} aspect="hero" sizes={shotSizes} />
            <span class="fluvio-platform-feature__sheen" aria-hidden="true" />
          </a>
        ) : (
          <div class="fluvio-platform-feature__shot">
            <div class="fluvio-platform-feature__chrome" aria-hidden="true">
              <span class="fluvio-platform-feature__dots">
                <span />
                <span />
                <span />
              </span>
            </div>
            <LargeImage src={image} alt={imageAlt} aspect="hero" sizes={shotSizes} />
            <span class="fluvio-platform-feature__sheen" aria-hidden="true" />
          </div>
        )}
        {screens.length > 0 && (
          <ul class="fluvio-platform-feature__screens">
            {screens.map((screen) => (
              <li>
                <LargeImage src={screen.image} alt={screen.imageAlt} aspect="hero" radius="sm" sizes={screenSizes} />
              </li>
            ))}
          </ul>
        )}
      </div>
    )
  }
  <div class="fluvio-platform-feature__body">
    <p class="fluvio-platform-feature__eyebrow">{platformLabel}{index !== undefined && ` / 0${index + 1}`}</p>
    <h3>{title}</h3>
    <p class="fluvio-platform-feature__description">{description}</p>
    {
      highlights.length > 0 && (
        <ul class="fluvio-platform-feature__highlights">
          {highlights.map((highlight) => (
            <li>{highlight}</li>
          ))}
        </ul>
      )
    }
    {
      href && (
        <ArrowLink class="fluvio-platform-feature__link" href={href} external size="sm">
          {actionLabel ?? title}
        </ArrowLink>
      )
    }
  </div>
</article>

<style>
  .fluvio-platform-feature {
    display: grid;
    align-content: start;
    gap: 1.5rem;
    height: 100%;
    padding: clamp(1.5rem, 4vw, 3.25rem) 0;
    border-top: 1px solid rgb(var(--fluvio-ink) / 0.16);
  }

  /* The stage: a tinted gradient panel the device sits on. */
  .fluvio-platform-feature__stage {
    position: relative;
    isolation: isolate;
    padding: clamp(1.25rem, 3vw, 2.25rem) clamp(1.25rem, 3vw, 2.25rem) clamp(1.25rem, 3vw, 2rem);
    border-radius: 24px;
    background:
      radial-gradient(120% 90% at 100% 0%, rgb(var(--stage-b) / 0.34), transparent 55%),
      radial-gradient(90% 80% at 0% 100%, rgb(var(--stage-a) / 0.28), transparent 60%),
      linear-gradient(160deg, rgb(var(--fluvio-mist)) 0%, rgb(var(--fluvio-wash) / 0.85) 100%);
    perspective: 1400px;
  }

  .fluvio-platform-feature__stage--fan {
    padding-bottom: clamp(5.5rem, 12vw, 8.5rem);
  }

  /* Fine contour lines echo the site's hydrology motif inside the stage. */
  .fluvio-platform-feature__stage::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: repeating-radial-gradient(
      ellipse 60rem 28rem at 110% -10%,
      transparent 0 26px,
      rgb(var(--fluvio-paper) / 0.35) 27px 28px,
      transparent 29px 54px
    );
    mask-image: linear-gradient(200deg, rgb(0 0 0) 0%, transparent 70%);
  }

  .fluvio-platform-feature__glow {
    position: absolute;
    inset: 12% 8% 0;
    z-index: -1;
    border-radius: 999px;
    background: rgb(var(--stage-b) / 0.45);
    filter: blur(48px);
    opacity: 0.7;
  }

  /* The device: a dark bezel with a browser chrome, tilted a touch. */
  .fluvio-platform-feature__shot {
    position: relative;
    display: block;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 14px;
    background: rgb(var(--fluvio-ink));
    box-shadow:
      0 0 0 1px rgb(var(--fluvio-ink) / 0.5),
      0 30px 60px -24px rgb(var(--fluvio-ink) / 0.55),
      0 12px 24px -14px rgb(var(--stage-a) / 0.5);
    text-decoration: none;
    transform: rotateX(5deg) rotateY(-5deg);
    transform-origin: 50% 60%;
  }

  a.fluvio-platform-feature__shot {
    cursor: pointer;
  }

  .fluvio-platform-feature__chrome {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    background: rgb(255 255 255 / 0.05);
  }

  .fluvio-platform-feature__dots {
    display: inline-flex;
    gap: 0.32rem;
  }

  .fluvio-platform-feature__dots span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.22);
  }

  .fluvio-platform-feature__dots span:first-child {
    background: rgb(var(--fluvio-coral) / 0.8);
  }

  .fluvio-platform-feature__dots span:nth-child(2) {
    background: rgb(var(--fluvio-silt) / 0.8);
  }

  .fluvio-platform-feature__dots span:last-child {
    background: rgb(125 226 200 / 0.8);
  }

  .fluvio-platform-feature__host {
    overflow: hidden;
    flex: 1;
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.3);
    border: 1px solid rgb(255 255 255 / 0.08);
    color: rgb(var(--fluvio-mist) / 0.75);
    font-family: var(--aw-font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .fluvio-platform-feature__open {
    width: 0.85rem;
    height: 0.85rem;
    color: rgb(125 226 200);
  }

  .fluvio-platform-feature__shot :global(.fluvio-image__frame) {
    border-radius: 0;
    background: rgb(var(--fluvio-ink));
  }

  /* A glass sheen across the screen. */
  .fluvio-platform-feature__sheen {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      115deg,
      rgb(255 255 255 / 0.14) 0%,
      rgb(255 255 255 / 0) 38%,
      rgb(255 255 255 / 0) 100%
    );
    mix-blend-mode: screen;
  }

  /* Further screens fan in front of the device's lower edge. */
  .fluvio-platform-feature__screens {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .fluvio-platform-feature__screens li {
    transform-origin: 50% 100%;
  }

  .fluvio-platform-feature__screens :global(.fluvio-image__frame) {
    border: 1px solid rgb(255 255 255 / 0.5);
    border-radius: 10px;
    background: rgb(var(--fluvio-ink));
    box-shadow:
      0 0 0 1px rgb(var(--fluvio-ink) / 0.35),
      0 22px 44px -18px rgb(var(--fluvio-ink) / 0.55);
  }

  @media (min-width: 640px) {
    .fluvio-platform-feature__stage--fan .fluvio-platform-feature__screens {
      position: absolute;
      right: clamp(1.25rem, 3vw, 2.25rem);
      bottom: clamp(-0.5rem, 0vw, 0.5rem);
      left: clamp(1.25rem, 3vw, 2.25rem);
      gap: 0;
      margin: 0;
      grid-template-columns: repeat(2, 46%);
      justify-content: space-between;
      pointer-events: none;
    }

    .fluvio-platform-feature__stage--fan .fluvio-platform-feature__screens li {
      pointer-events: auto;
    }

    .fluvio-platform-feature__stage--fan .fluvio-platform-feature__screens li:first-child {
      transform: translateY(0.75rem) rotate(-4deg);
    }

    .fluvio-platform-feature__stage--fan .fluvio-platform-feature__screens li:last-child {
      transform: translateY(1.5rem) rotate(4deg);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .fluvio-platform-feature__shot {
      transition:
        transform 700ms cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 700ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .fluvio-platform-feature__glow {
      transition: opacity 700ms ease;
    }

    .fluvio-platform-feature__screens li {
      transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .fluvio-platform-feature__stage:hover .fluvio-platform-feature__shot {
      transform: rotateX(0) rotateY(0) translateY(-4px);
      box-shadow:
        0 0 0 1px rgb(var(--fluvio-ink) / 0.5),
        0 40px 70px -26px rgb(var(--fluvio-ink) / 0.6),
        0 16px 30px -14px rgb(var(--stage-b) / 0.55);
    }

    .fluvio-platform-feature__stage:hover .fluvio-platform-feature__glow {
      opacity: 1;
    }

    @media (min-width: 640px) {
      .fluvio-platform-feature__stage--fan:hover .fluvio-platform-feature__screens li:first-child {
        transform: translateY(0.25rem) rotate(-2deg);
      }

      .fluvio-platform-feature__stage--fan:hover .fluvio-platform-feature__screens li:last-child {
        transform: translateY(0.9rem) rotate(2deg);
      }

      .fluvio-platform-feature__stage--fan .fluvio-platform-feature__screens li:hover {
        z-index: 1;
        transform: translateY(-0.5rem) rotate(0) scale(1.06);
      }
    }
  }

  a.fluvio-platform-feature__shot:focus-visible {
    outline: 2px solid rgb(var(--fluvio-river));
    outline-offset: 4px;
  }

  :global(.dark) .fluvio-platform-feature__stage {
    background:
      radial-gradient(120% 90% at 100% 0%, rgb(var(--stage-b) / 0.3), transparent 55%),
      radial-gradient(90% 80% at 0% 100%, rgb(var(--stage-a) / 0.35), transparent 60%),
      linear-gradient(160deg, rgb(var(--fluvio-navy) / 0.55) 0%, rgb(var(--fluvio-ink)) 100%);
  }

  :global(.dark) .fluvio-platform-feature__stage::before {
    background: repeating-radial-gradient(
      ellipse 60rem 28rem at 110% -10%,
      transparent 0 26px,
      rgb(var(--fluvio-mist) / 0.08) 27px 28px,
      transparent 29px 54px
    );
  }

  :global(.dark) .fluvio-platform-feature__shot {
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.6),
      0 30px 60px -24px rgb(0 0 0 / 0.8),
      0 12px 24px -14px rgb(var(--stage-b) / 0.4);
  }

  :global(.dark) .fluvio-platform-feature__screens :global(.fluvio-image__frame) {
    border-color: rgb(255 255 255 / 0.18);
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.5),
      0 22px 44px -18px rgb(0 0 0 / 0.8);
  }

  .fluvio-platform-feature__eyebrow {
    margin: 0.25rem 0 1.5rem;
    color: rgb(var(--fluvio-river));
    font-family: var(--aw-font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0;
    color: var(--aw-color-text-heading);
    font-family: var(--aw-font-heading);
    font-size: clamp(1.9rem, 3.4vw, 3.1rem);
    font-weight: 560;
    letter-spacing: -0.03em;
    line-height: 1.02;
  }

  .fluvio-platform-feature__description {
    margin: 1.2rem 0 0;
    max-width: 52ch;
    color: var(--aw-color-text-muted);
    line-height: 1.7;
  }

  /* Feature list: hairline rows with a river-blue tick. */
  .fluvio-platform-feature__highlights {
    display: grid;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgb(var(--fluvio-ink) / 0.12);
  }

  .fluvio-platform-feature__highlights li {
    position: relative;
    padding: 0.7rem 0 0.7rem 1.4rem;
    border-bottom: 1px solid rgb(var(--fluvio-ink) / 0.12);
    color: var(--aw-color-text-default);
    font-size: 0.9rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .fluvio-platform-feature__highlights li::before {
    content: '';
    position: absolute;
    top: 1.15rem;
    left: 0.15rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: rgb(var(--fluvio-river));
    box-shadow: 0 0 0 3px rgb(var(--fluvio-river) / 0.16);
  }

  :global(.dark) .fluvio-platform-feature__highlights,
  :global(.dark) .fluvio-platform-feature__highlights li {
    border-color: rgb(var(--fluvio-mist) / 0.14);
  }

  :global(.dark) .fluvio-platform-feature__highlights li::before {
    background: rgb(125 186 188);
    box-shadow: 0 0 0 3px rgb(125 186 188 / 0.18);
  }

  .fluvio-platform-feature__link {
    margin-top: 1.5rem;
  }

  :global(.dark) .fluvio-platform-feature {
    border-color: rgb(var(--fluvio-paper) / 0.16);
  }
</style>
