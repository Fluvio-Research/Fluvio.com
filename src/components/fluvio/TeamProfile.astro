---
import LargeImage from './LargeImage.astro';
import type { TeamMember } from '~/data/fluvio/types';
import { defaultLocale, t, type Locale } from '~/i18n';

export interface Props {
  member: TeamMember;
  headingLevel?: 'h2' | 'h3';
  locale?: Locale;
}

const { member, headingLevel = 'h3', locale = defaultLocale } = Astro.props;
const Heading = headingLevel;
---

<article class="fluvio-team-profile">
  <LargeImage
    src={member.portrait}
    alt={member.portraitAlt}
    aspect="portrait"
    sizes="(min-width: 1280px) 384px, (min-width: 768px) 40vw, calc(100vw - 2rem)"
  />
  <div class="fluvio-team-profile__body">
    <Heading>{member.name}</Heading>
    {member.role && <p class="fluvio-team-profile__role">{member.role}</p>}
    <p class="fluvio-team-profile__bio">{member.bio}</p>
    {
      member.specialties.length > 0 && (
        <ul class="fluvio-team-profile__specialties">
          {member.specialties.map((specialty) => (
            <li>{specialty}</li>
          ))}
        </ul>
      )
    }
    {
      member.profileUrl && (
        <a href={member.profileUrl} rel="noopener noreferrer">
          {t(locale).teamPage.viewProfile} <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .fluvio-team-profile {
    display: grid;
    gap: 1.35rem;
  }

  h2,
  h3 {
    margin: 0;
    color: var(--aw-color-text-heading);
    font-family: var(--aw-font-heading);
    font-size: clamp(1.6rem, 2.8vw, 2.5rem);
    font-weight: 520;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .fluvio-team-profile__role {
    margin: 0.6rem 0 1rem;
    color: rgb(var(--fluvio-river));
    font-family: var(--aw-font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .fluvio-team-profile__bio {
    margin: 0;
    color: var(--aw-color-text-muted);
    line-height: 1.7;
  }

  .fluvio-team-profile__specialties {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .fluvio-team-profile__specialties li {
    padding: 0.3rem 0.75rem;
    border: 1px solid rgb(var(--fluvio-river) / 0.3);
    border-radius: 999px;
    background: rgb(var(--fluvio-wash) / 0.35);
    color: var(--aw-color-text-default);
    font-family: var(--aw-font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  :global(.dark) .fluvio-team-profile__specialties li {
    border-color: rgb(125 186 188 / 0.35);
    background: rgb(var(--fluvio-navy) / 0.4);
  }

  a {
    display: inline-flex;
    gap: 0.4rem;
    margin-top: 1.15rem;
    border-bottom: 1px solid currentColor;
    color: rgb(var(--fluvio-river));
    font-size: 0.88rem;
    font-weight: 650;
    text-decoration: none;
  }

  a:focus-visible {
    border-radius: 4px;
    outline: 2px solid rgb(var(--fluvio-river));
  }
</style>
