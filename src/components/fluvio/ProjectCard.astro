---
/**
 * A project in a grid: a photograph with its location and index floating in
 * glass chips, the disciplines as tags, then title, summary and a footer
 * with the timeframe and the arrow control. One real link (the title) is
 * stretched over the whole card so it is a single tab stop; the photo carries
 * a view-transition name so it morphs into the project page hero.
 */
import ArrowIcon from './ArrowIcon.astro';
import LargeImage from './LargeImage.astro';
import { projectHref } from '~/data/fluvio/routes';
import type { Project } from '~/data/fluvio/types';
import { defaultLocale, t, type Locale } from '~/i18n';

export interface Props {
  project: Project;
  locale?: Locale;
  index?: number;
  size?: 'default' | 'large';
  headingLevel?: 'h2' | 'h3';
  /** Expertise slugs the project belongs to; drives the list filter. */
  areas?: string[];
  priority?: boolean;
  class?: string;
}

const {
  project,
  locale = defaultLocale,
  index,
  size = 'default',
  headingLevel: Heading = 'h3',
  areas = [],
  priority = false,
  class: className,
  ...rest
} = Astro.props;
const strings = t(locale).project;
const href = projectHref(project.slug, locale);
const number = index === undefined ? undefined : String(index + 1).padStart(2, '0');
const sizes =
  size === 'large'
    ? '(min-width: 1280px) 760px, (min-width: 768px) 58vw, calc(100vw - 2rem)'
    : '(min-width: 1280px) 420px, (min-width: 768px) 42vw, calc(100vw - 2rem)';
---

<article
  {...rest}
  class:list={['fluvio-project-card fluvio-arrow-host', `fluvio-project-card--${size}`, className]}
  data-project={project.slug}
  data-areas={areas.join(' ')}
>
  <div class="fluvio-project-card__media">
    <LargeImage
      src={project.heroImage}
      alt={project.heroAlt}
      aspect={size === 'large' ? 'wide' : 'landscape'}
      radius="none"
      sizes={sizes}
      priority={priority}
      transitionName={`project-${project.slug}`}
    />
    <div class="fluvio-project-card__scrim" aria-hidden="true"></div>
    <div class="fluvio-project-card__chips">
      {
        project.location && (
          <span class="fluvio-project-card__pin">
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 21s-6-5.3-6-10a6 6 0 1 1 12 0c0 4.7-6 10-6 10Z" />
              <circle cx="12" cy="11" r="2" />
            </svg>
            {project.location}
          </span>
        )
      }
      {number && <span class="fluvio-project-card__number">{number}</span>}
    </div>
    <ul class="fluvio-project-card__tags" aria-label={strings.disciplines}>
      {project.disciplines.map((discipline) => <li>{discipline}</li>)}
    </ul>
  </div>
  <div class="fluvio-project-card__body">
    <Heading class="fluvio-project-card__title">
      <a href={href}>{project.title}</a>
    </Heading>
    <p class="fluvio-project-card__summary">{project.summary}</p>
    <div class="fluvio-project-card__foot">
      {project.timeframe && <span class="fluvio-project-card__timeframe">{project.timeframe}</span>}
      <span class="fluvio-project-card__cta">
        <span>{strings.viewProject}</span>
        <ArrowIcon size="sm" />
      </span>
    </div>
  </div>
</article>

<style>
  .fluvio-project-card {
    --card-radius: 22px;
    --card-line: rgb(var(--fluvio-ink) / 0.1);
    --card-surface: rgb(var(--fluvio-paper) / 0.72);
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--card-line);
    border-radius: var(--card-radius);
    background: var(--card-surface);
    backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.5) inset;
  }

  :global(.dark) .fluvio-project-card {
    --card-line: rgb(var(--fluvio-mist) / 0.12);
    --card-surface: rgb(var(--fluvio-navy) / 0.28);
    box-shadow: none;
  }

  .fluvio-project-card__media {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .fluvio-project-card__media :global(.fluvio-image__frame) {
    border-radius: 0;
  }

  /* A low ink wash so the tags read on any photograph. */
  .fluvio-project-card__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgb(var(--fluvio-ink) / 0.16) 0%,
      transparent 34%,
      transparent 58%,
      rgb(var(--fluvio-ink) / 0.62) 100%
    );
  }

  .fluvio-project-card__chips {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    left: 0.9rem;
    z-index: 2;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
  }

  .fluvio-project-card__pin,
  .fluvio-project-card__number {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    padding: 0.38rem 0.75rem 0.38rem 0.6rem;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 999px;
    background: rgb(var(--fluvio-ink) / 0.48);
    backdrop-filter: blur(12px);
    color: rgb(var(--fluvio-paper));
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .fluvio-project-card__pin {
    overflow: hidden;
    min-width: 0;
    text-overflow: ellipsis;
  }

  .fluvio-project-card__pin svg {
    flex: none;
    width: 0.85rem;
    height: 0.85rem;
  }

  .fluvio-project-card__number {
    flex: none;
    padding-inline: 0.7rem;
    font-family: var(--aw-font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
  }

  .fluvio-project-card__tags {
    position: absolute;
    right: 1rem;
    bottom: 0.95rem;
    left: 1rem;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }

  .fluvio-project-card__tags li {
    padding: 0.3rem 0.65rem;
    border: 1px solid rgb(255 255 255 / 0.28);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.12);
    backdrop-filter: blur(8px);
    color: rgb(var(--fluvio-paper));
    font-size: 0.68rem;
    font-weight: 560;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  .fluvio-project-card__body {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.7rem;
    padding: 1.25rem 1.35rem 1.3rem;
  }

  .fluvio-project-card--large .fluvio-project-card__body {
    padding: clamp(1.4rem, 3vw, 2.25rem) clamp(1.35rem, 3vw, 2.25rem);
  }

  .fluvio-project-card__title {
    margin: 0;
    font-family: var(--aw-font-heading);
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    font-weight: 560;
    letter-spacing: -0.025em;
    line-height: 1.14;
    text-wrap: balance;
  }

  .fluvio-project-card--large .fluvio-project-card__title {
    max-width: 24ch;
    font-size: clamp(1.7rem, 3vw, 2.6rem);
  }

  .fluvio-project-card__title a {
    color: var(--aw-color-text-heading);
    text-decoration: none;
  }

  /* Stretched link: the whole card is clickable through one tab stop. */
  .fluvio-project-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: var(--card-radius);
  }

  .fluvio-project-card__summary {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    margin: 0;
    max-width: 52ch;
    color: var(--aw-color-text-muted);
    font-size: 0.93rem;
    line-height: 1.6;
  }

  .fluvio-project-card--large .fluvio-project-card__summary {
    -webkit-line-clamp: 4;
    font-size: 1rem;
  }

  .fluvio-project-card__foot {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.5rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--card-line);
  }

  .fluvio-project-card__timeframe {
    color: var(--aw-color-text-muted);
    font-family: var(--aw-font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .fluvio-project-card__cta {
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
    margin-left: auto;
    color: var(--arrow-color);
    font-size: 0.82rem;
    font-weight: 600;
  }

  @media (prefers-reduced-motion: no-preference) {
    .fluvio-project-card {
      transition:
        transform 420ms cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 420ms cubic-bezier(0.22, 1, 0.36, 1),
        border-color 300ms ease;
    }

    .fluvio-project-card__title a {
      transition: color 220ms ease;
    }

    .fluvio-project-card__tags li {
      transform: translateY(0.25rem);
      opacity: 0.92;
      transition:
        transform 420ms cubic-bezier(0.22, 1, 0.36, 1),
        opacity 320ms ease;
    }

    @media (hover: hover) {
      .fluvio-project-card:hover {
        transform: translateY(-5px);
        box-shadow:
          0 1px 0 rgb(255 255 255 / 0.5) inset,
          0 24px 48px -18px rgb(var(--fluvio-ink) / 0.28);
      }

      .fluvio-project-card:hover .fluvio-project-card__tags li {
        transform: translateY(0);
        opacity: 1;
      }

      :global(.dark) .fluvio-project-card:hover {
        box-shadow: 0 24px 48px -18px rgb(0 0 0 / 0.6);
      }
    }
  }

  .fluvio-project-card:hover {
    border-color: rgb(var(--fluvio-river) / 0.4);
  }

  .fluvio-project-card:hover .fluvio-project-card__title a {
    color: rgb(var(--fluvio-river));
  }

  :global(.dark) .fluvio-project-card:hover .fluvio-project-card__title a {
    color: rgb(125 186 188);
  }

  .fluvio-project-card:has(a:focus-visible) {
    outline: 2px solid rgb(var(--fluvio-river));
    outline-offset: 4px;
  }

  .fluvio-project-card__title a:focus-visible {
    outline: none;
  }
</style>
