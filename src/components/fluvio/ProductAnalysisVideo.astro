---
import { findVideo } from '~/utils/images';
import type { Locale } from '~/i18n';
import dischargePoster from '~/assets/images/fluvio/fs-spot-discharge-poster.jpg';
import velocityPoster from '~/assets/images/fluvio/fs-spot-analysis-poster.jpg';

// Both clips are FS-Spot recordings: the portrait discharge readout and the
// landscape surface velocity overlay. They sit side by side under one caption.
export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const label = {
  en: 'Flow analysis in action',
  pijin: 'Lukim flow analysis long waka',
  fr: 'Analyse du débit en action',
  es: 'Análisis del caudal en acción',
  de: 'Durchflussanalyse im Einsatz',
}[locale];
const clips = [
  { name: 'discharge', poster: dischargePoster, video: findVideo('/src/assets/images/fluvio/fs-spot-discharge.mp4') },
  { name: 'velocity', poster: velocityPoster, video: findVideo('/src/assets/images/fluvio/fs-spot-analysis.mp4') },
];
---

<figure class="product-analysis">
  <div class="product-analysis__clips">
    {
      clips.map((clip, index) => (
        <video
          class={`product-analysis__clip product-analysis__clip--${clip.name}`}
          src={clip.video}
          poster={clip.poster.src}
          width={clip.poster.width}
          height={clip.poster.height}
          controls
          playsinline
          preload="none"
          aria-label={`FS-Spot: ${label} (${index + 1}/${clips.length})`}
        />
      ))
    }
  </div>
  <figcaption>{label}</figcaption>
</figure>
<style>
  .product-analysis {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    min-width: 0;
  }
  .product-analysis__clips {
    display: grid;
    justify-items: center;
    align-items: center;
    gap: 1.25rem;
  }
  video {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    border-radius: 18px;
    box-shadow: 0 18px 45px rgb(var(--fluvio-ink) / 0.16);
    background: #10191e;
  }
  .product-analysis__clip--discharge {
    max-height: 560px;
  }
  figcaption {
    color: var(--aw-color-text-muted);
    font-size: 0.85rem;
    line-height: 1.5;
    text-align: center;
  }
  @media (min-width: 600px) {
    /* Column widths follow each clip's aspect ratio, so both clips share one
       height and line up along the top and bottom edges. */
    .product-analysis__clips {
      grid-template-columns: minmax(0, 758fr) minmax(0, 2276fr);
      align-items: stretch;
      gap: 1.25rem;
    }
    video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .product-analysis__clip--discharge {
      max-height: none;
      aspect-ratio: 758 / 1280;
    }
    .product-analysis__clip--velocity {
      aspect-ratio: 16 / 9;
    }
  }
</style>
