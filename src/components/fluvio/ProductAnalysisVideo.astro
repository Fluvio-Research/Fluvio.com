---
import { findVideo } from '~/utils/images';
import type { Locale } from '~/i18n';
import spotPoster from '~/assets/images/fluvio/fs-spot-analysis-poster.jpg';
import haloPoster from '~/assets/images/fluvio/fs-halo-analysis-poster.jpg';

export interface Props {
  product: 'fs-spot' | 'fs-halo';
  locale: Locale;
}
const { product, locale } = Astro.props;
const spot = product === 'fs-spot';
const label = {
  en: 'Flow analysis in action',
  pijin: 'Lukim flow analysis long waka',
  fr: 'Analyse du débit en action',
  es: 'Análisis del caudal en acción',
  de: 'Durchflussanalyse im Einsatz',
}[locale];
const poster = spot ? spotPoster : haloPoster;
const video = findVideo(`/src/assets/images/fluvio/${product}-analysis.mp4`);
---

<figure class="product-analysis">
  <video
    src={video}
    poster={poster.src}
    width={spot ? 622 : 758}
    height="1280"
    controls
    playsinline
    preload="none"
    aria-label={`${spot ? 'FS-Spot' : 'FS-Halo'} — ${label}`}></video>
  <figcaption>{label}</figcaption>
</figure>
<style>
  .product-analysis {
    display: grid;
    justify-items: center;
    gap: 0.85rem;
    margin: 0;
  }
  video {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 640px;
    border-radius: 18px;
    box-shadow: 0 18px 45px rgb(var(--fluvio-ink) / 0.16);
    background: #10191e;
  }
  figcaption {
    color: var(--aw-color-text-muted);
    font-size: 0.85rem;
    line-height: 1.5;
    text-align: center;
  }
  @media (max-width: 599px) {
    video {
      max-height: 560px;
    }
  }
</style>
