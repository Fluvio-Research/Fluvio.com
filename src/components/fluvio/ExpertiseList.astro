---
import LargeImage from './LargeImage.astro';
import type { ExpertiseArea } from '~/data/fluvio/types';

export interface Props {
  items: ExpertiseArea[];
  headingLevel?: 'h2' | 'h3';
}

const { items, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<div class="fluvio-expertise-list">
  {
    items.map((item, index) => (
      <article class="fluvio-expertise-list__item" id={item.slug}>
        <div class="fluvio-expertise-list__image">
          <LargeImage src={item.image} alt={item.imageAlt} aspect="landscape" />
        </div>
        <div class="fluvio-expertise-list__body">
          <p class="fluvio-expertise-list__number">{String(index + 1).padStart(2, '0')}</p>
          <Heading>{item.title}</Heading>
          <p class="fluvio-expertise-list__summary">{item.summary}</p>
          {item.description.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </article>
    ))
  }
</div>

<style>
  .fluvio-expertise-list {
    display: grid;
    gap: clamp(4rem, 9vw, 8rem);
  }

  .fluvio-expertise-list__item {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  .fluvio-expertise-list__body {
    max-width: 34rem;
  }

  .fluvio-expertise-list__number {
    margin: 0 0 1rem;
    color: rgb(var(--fluvio-water));
    font-family: var(--aw-font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  h2,
  h3 {
    margin: 0 0 1.15rem;
    color: var(--aw-color-text-heading);
    font-family: var(--aw-font-heading);
    font-size: clamp(1.8rem, 3.4vw, 3.2rem);
    font-weight: 520;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .fluvio-expertise-list__summary {
    color: var(--aw-color-text-default);
    font-size: 1.05rem;
  }

  .fluvio-expertise-list__body p:not(.fluvio-expertise-list__number) {
    margin: 0 0 0.85rem;
    color: var(--aw-color-text-muted);
    line-height: 1.7;
  }

  @media (min-width: 768px) {
    .fluvio-expertise-list__item {
      grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
      gap: clamp(2.5rem, 7vw, 7rem);
    }

    .fluvio-expertise-list__item:nth-child(even) {
      grid-template-columns: minmax(18rem, 0.85fr) minmax(0, 1.15fr);
    }

    .fluvio-expertise-list__item:nth-child(even) .fluvio-expertise-list__image {
      grid-column: 2;
    }

    .fluvio-expertise-list__item:nth-child(even) .fluvio-expertise-list__body {
      grid-row: 1;
      grid-column: 1;
    }
  }
</style>
