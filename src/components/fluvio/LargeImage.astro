---
import Image from '~/components/common/Image.astro';

export interface Props {
  src: string;
  alt: string;
  caption?: string;
  priority?: boolean;
  aspect?: 'hero' | 'landscape' | 'portrait';
}

const { src, alt, caption, priority = false, aspect = 'landscape' } = Astro.props;
---

<figure class:list={['fluvio-image', `fluvio-image--${aspect}`]}>
  <div class="fluvio-image__frame">
    <Image
      src={src}
      alt={alt}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      layout="cover"
      widths={[480, 768, 1080, 1440, 1920]}
      sizes="(min-width: 1280px) 1200px, 100vw"
    />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .fluvio-image {
    margin: 0;
    width: 100%;
  }

  .fluvio-image__frame {
    overflow: hidden;
    border-radius: 6px;
    background: rgb(var(--fluvio-water) / 0.08);
  }

  .fluvio-image--hero .fluvio-image__frame {
    aspect-ratio: 16 / 9;
  }

  .fluvio-image--landscape .fluvio-image__frame {
    aspect-ratio: 4 / 3;
  }

  .fluvio-image--portrait .fluvio-image__frame {
    aspect-ratio: 4 / 5;
  }

  .fluvio-image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  figcaption {
    margin-top: 0.75rem;
    color: var(--aw-color-text-muted);
    font-family: var(--aw-font-mono);
    font-size: 0.72rem;
    line-height: 1.5;
  }
</style>
