---
import LargeImage from './LargeImage.astro';
import ArrowLink from './ArrowLink.astro';
import { findVideo } from '~/utils/images';
import { getAsset } from '~/utils/permalinks';
import type { Locale } from '~/i18n';
export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const labels = {
  en: [
    'FS-Flux in the field',
    'Solar panels around the FS-Flux floating methane chamber',
    'Download the FS-Flux brochure (Word)',
    'FS-Flux floating on a pond during a field deployment',
  ],
  pijin: [
    'FS-Flux long field',
    'Olketa solar panel raonem FS-Flux chamber wea float fo measurem methane',
    'Downloadem FS-Flux brochure (Word)',
    'FS-Flux wea float long pond long field deployment',
  ],
  fr: [
    'FS-Flux sur le terrain',
    'Panneaux solaires autour de la chambre flottante de mesure du méthane FS-Flux',
    'Télécharger la brochure FS-Flux (Word)',
    'FS-Flux flottant sur un étang lors d’un déploiement',
  ],
  es: [
    'FS-Flux en campo',
    'Paneles solares alrededor de la cámara flotante de metano FS-Flux',
    'Descargar el folleto FS-Flux (Word)',
    'FS-Flux flotando en un estanque durante un despliegue',
  ],
}[locale];
const video = findVideo('/src/assets/images/fluvio/fs-flux-field.mp4');
import poster from '~/assets/images/fluvio/fs-flux-video-poster.jpg';
---

<section class="flux-media" aria-label={labels[0]}>
  <div class="flux-media__grid">
    <LargeImage src="/src/assets/images/fluvio/fs-flux-overhead.jpg" alt={labels[1]} aspect="landscape" radius="lg" />
    <figure>
      <video src={video} poster={poster.src} controls playsinline preload="none" aria-label={labels[3]}></video>
      <figcaption>{labels[0]}</figcaption>
    </figure>
  </div>
  <ArrowLink href={getAsset('/downloads/FS_Flux_Brochure.docx')}>{labels[2]}</ArrowLink>
</section>
<style>
  .flux-media {
    display: grid;
    gap: 1.5rem;
    margin-top: 3rem;
  }
  .flux-media__grid {
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }
  figure {
    margin: 0;
  }
  video {
    display: block;
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: 18px;
    background: #071f2a;
  }
  figcaption {
    padding: 0.75rem 0;
    color: var(--aw-color-text-muted);
    font-size: 0.85rem;
  }
  @media (min-width: 768px) {
    .flux-media__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
