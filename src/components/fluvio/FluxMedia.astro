---
import LargeImage from './LargeImage.astro';
import { findVideo } from '~/utils/images';
import type { Locale } from '~/i18n';
import { getUi } from '~/data/fluvio/store.ts';
export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const labels = getUi(locale).flux;
const video = findVideo('/src/assets/images/fluvio/fs-flux-field.mp4');
import poster from '~/assets/images/fluvio/fs-flux-video-poster.jpg';
---

<section class="flux-media" aria-label={labels.field}>
  <div class="flux-media__grid">
    <LargeImage
      src="/src/assets/images/fluvio/fs-flux-overhead.jpg"
      alt={labels.photo}
      caption={labels.photo}
      aspect="hero"
      radius="lg"
    />
    <figure>
      <video src={video} poster={poster.src} controls playsinline preload="none" aria-label={labels.video}></video>
      <figcaption>{labels.field}</figcaption>
    </figure>
  </div>
</section>
<style>
  .flux-media {
    display: grid;
    gap: 1.5rem;
    margin-top: 3rem;
  }
  .flux-media__grid {
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }
  figure {
    margin: 0;
  }
  video {
    display: block;
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: 20px;
    object-fit: contain;
    background: #071f2a;
  }
  .flux-media__grid :global(figcaption) {
    margin: 0.75rem 0 0;
    padding: 0;
    font-family: var(--aw-font-sans);
    line-height: 1.5;
    color: var(--aw-color-text-muted);
    font-size: 0.85rem;
  }
  @media (min-width: 768px) {
    .flux-media__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
