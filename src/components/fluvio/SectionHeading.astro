---
import Accent from './Accent.astro';

export interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'split';
  headingLevel?: 'h2' | 'h3';
  id?: string;
}

const { eyebrow, title, intro, align = 'left', headingLevel: Heading = 'h2', id } = Astro.props;
const hasAside = Boolean(intro) || Astro.slots.has('action');
---

<header class:list={['fluvio-section-heading', `fluvio-section-heading--${align}`]}>
  <div class="fluvio-section-heading__title">
    {eyebrow && <p class="fluvio-section-heading__eyebrow">{eyebrow}</p>}
    <Heading id={id}><Accent text={title} /></Heading>
  </div>
  {
    hasAside && (
      <div class="fluvio-section-heading__aside">
        {intro && <p class="fluvio-section-heading__intro">{intro}</p>}
        <slot name="action" />
      </div>
    )
  }
</header>

<style>
  .fluvio-section-heading {
    display: grid;
    gap: 1.25rem;
    max-width: 58rem;
  }

  .fluvio-section-heading--split {
    max-width: none;
  }

  .fluvio-section-heading__eyebrow {
    margin: 0 0 0.875rem;
    color: rgb(var(--fluvio-river));
    font-family: var(--aw-font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  :global(.dark) .fluvio-section-heading__eyebrow {
    color: rgb(125 186 188);
  }

  h2,
  h3 {
    margin: 0;
    max-width: 18ch;
    color: var(--aw-color-text-heading);
    font-family: var(--aw-font-heading);
    font-size: clamp(2.1rem, 4.4vw, 4rem);
    font-weight: 540;
    letter-spacing: -0.03em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .fluvio-section-heading__aside {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .fluvio-section-heading__intro {
    margin: 0;
    max-width: 58ch;
    color: var(--aw-color-text-muted);
    font-size: clamp(1rem, 1.7vw, 1.15rem);
    line-height: 1.65;
    text-wrap: pretty;
  }

  @media (min-width: 768px) {
    .fluvio-section-heading--split {
      grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr);
      align-items: end;
      gap: clamp(3rem, 8vw, 8rem);
    }
  }
</style>
