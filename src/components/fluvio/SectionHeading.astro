---
export interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'split';
}

const { eyebrow, title, intro, align = 'left' } = Astro.props;
---

<header class:list={['fluvio-section-heading', `fluvio-section-heading--${align}`]}>
  <div class="fluvio-section-heading__title">
    {eyebrow && <p class="fluvio-section-heading__eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
  </div>
  {intro && <p class="fluvio-section-heading__intro">{intro}</p>}
</header>

<style>
  .fluvio-section-heading {
    display: grid;
    gap: 1.25rem;
    max-width: 58rem;
  }

  .fluvio-section-heading--split {
    max-width: none;
  }

  .fluvio-section-heading__eyebrow {
    margin: 0 0 0.875rem;
    color: rgb(var(--fluvio-river));
    font-family: var(--aw-font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    max-width: 18ch;
    color: var(--aw-color-text-heading);
    font-family: var(--aw-font-heading);
    font-size: clamp(2.25rem, 5vw, 4.75rem);
    font-weight: 520;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .fluvio-section-heading__intro {
    margin: 0;
    max-width: 62ch;
    color: var(--aw-color-text-muted);
    font-size: clamp(1rem, 1.7vw, 1.2rem);
    line-height: 1.65;
  }

  @media (min-width: 768px) {
    .fluvio-section-heading--split {
      grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr);
      align-items: end;
      gap: clamp(3rem, 8vw, 8rem);
    }
  }
</style>
