---
/**
 * The illustration for one expertise area: a looping demonstration clip when
 * the record carries a video, otherwise the still photograph. The clip fills
 * its frame exactly like a photograph (same aspect ratios, radii and hover
 * zoom as LargeImage), only plays once it scrolls into view, and stays on its
 * poster frame for visitors who prefer reduced motion.
 */
import LargeImage from './LargeImage.astro';
import type { ExpertiseArea } from '~/data/fluvio/types';
import { findImage, findVideo } from '~/utils/images';

export interface Props {
  area: ExpertiseArea;
  aspect?: 'hero' | 'wide' | 'landscape' | 'square';
  radius?: 'none' | 'sm' | 'md' | 'lg';
  sizes?: string;
  priority?: boolean;
  transitionName?: string;
}

const { area, aspect = 'landscape', radius = 'md', sizes, priority = false, transitionName } = Astro.props;
const videoUrl = findVideo(area.video);
const poster = videoUrl ? await findImage(area.image) : null;
const posterUrl = poster && typeof poster === 'object' && 'src' in poster ? poster.src : undefined;
---

{
  videoUrl ? (
    <div
      class:list={[
        'fluvio-expertise-media',
        `fluvio-expertise-media--${aspect}`,
        `fluvio-expertise-media--radius-${radius}`,
      ]}
    >
      {transitionName ? (
        <div class="fluvio-expertise-media__frame" transition:name={transitionName}>
          <video
            class="fluvio-expertise-media__video"
            src={videoUrl}
            poster={posterUrl}
            muted
            loop
            playsinline
            preload={priority ? 'metadata' : 'none'}
            aria-label={area.imageAlt}
          />
          <span class="fluvio-expertise-media__badge" aria-hidden="true">
            <span class="fluvio-expertise-media__pulse" />
          </span>
        </div>
      ) : (
        <div class="fluvio-expertise-media__frame">
          <video
            class="fluvio-expertise-media__video"
            src={videoUrl}
            poster={posterUrl}
            muted
            loop
            playsinline
            preload={priority ? 'metadata' : 'none'}
            aria-label={area.imageAlt}
          />
          <span class="fluvio-expertise-media__badge" aria-hidden="true">
            <span class="fluvio-expertise-media__pulse" />
          </span>
        </div>
      )}
    </div>
  ) : (
    <LargeImage
      src={area.image}
      alt={area.imageAlt}
      aspect={aspect}
      radius={radius}
      sizes={sizes}
      priority={priority}
      transitionName={transitionName}
    />
  )
}

<style>
  .fluvio-expertise-media {
    width: 100%;
  }

  .fluvio-expertise-media__frame {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    background: rgb(var(--fluvio-river) / 0.08);
    isolation: isolate;
    transform: translateZ(0);
  }

  .fluvio-expertise-media--hero .fluvio-expertise-media__frame {
    aspect-ratio: 16 / 9;
  }

  .fluvio-expertise-media--wide .fluvio-expertise-media__frame {
    aspect-ratio: 3 / 2;
  }

  .fluvio-expertise-media--square .fluvio-expertise-media__frame {
    aspect-ratio: 1;
  }

  .fluvio-expertise-media--radius-none .fluvio-expertise-media__frame {
    border-radius: 0;
  }

  .fluvio-expertise-media--radius-sm .fluvio-expertise-media__frame {
    border-radius: 8px;
  }

  .fluvio-expertise-media--radius-lg .fluvio-expertise-media__frame {
    border-radius: 20px;
  }

  .fluvio-expertise-media__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* A quiet pulse in the corner: this frame is being computed, not filmed. */
  .fluvio-expertise-media__badge {
    position: absolute;
    top: 0.9rem;
    left: 0.9rem;
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 999px;
    background: rgb(var(--fluvio-ink) / 0.5);
    backdrop-filter: blur(10px);
    opacity: 0;
  }

  .fluvio-expertise-media__frame.is-playing .fluvio-expertise-media__badge {
    opacity: 1;
  }

  .fluvio-expertise-media__pulse {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: rgb(125 226 200);
    box-shadow: 0 0 0 0 rgb(125 226 200 / 0.7);
  }

  @media (prefers-reduced-motion: no-preference) {
    .fluvio-expertise-media__video {
      transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .fluvio-expertise-media__badge {
      transition: opacity 400ms ease;
    }

    .fluvio-expertise-media__pulse {
      animation: fluvio-media-pulse 1.8s ease-out infinite;
    }

    @media (hover: hover) {
      :global(article:has(a):hover) .fluvio-expertise-media__video,
      :global(a:hover) .fluvio-expertise-media__video {
        transform: scale(1.035);
      }
    }
  }

  @keyframes fluvio-media-pulse {
    to {
      box-shadow: 0 0 0 0.5rem rgb(125 226 200 / 0);
    }
  }
</style>

<script>
  /* Play only while on screen, and never when the visitor asks for less
     motion: the poster frame already carries the information. */
  const videos = document.querySelectorAll<HTMLVideoElement>('.fluvio-expertise-media__video');
  if (videos.length) {
    const stillPreferred = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (stillPreferred.matches) {
      videos.forEach((video) => video.setAttribute('controls', ''));
    } else {
      videos.forEach((video) => {
        video.addEventListener('playing', () => video.parentElement?.classList.add('is-playing'));
        video.addEventListener('pause', () => video.parentElement?.classList.remove('is-playing'));
      });
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const video = entry.target as HTMLVideoElement;
            if (entry.isIntersecting) video.play().catch(() => video.setAttribute('controls', ''));
            else video.pause();
          });
        },
        { rootMargin: '0px 0px -10% 0px' }
      );

      videos.forEach((video) => observer.observe(video));
    }
  }
</script>
