---
// All faces are self-hosted by Astro's native Fonts API (astro.config.ts).
// Inter carries body and interface text, Bricolage Grotesque carries display
// headings, and Instrument Serif italic marks the one accented phrase inside a
// heading. The mono stack is reserved for compact labels and readouts.
//
// Colour system: warm paper and soft mist lead the backgrounds, navy leads
// typography and dark chapters, river blue and teal carry water and
// technology, mineral blue supports technical detail, silt adds landscape
// warmth and coral is a rare high-attention accent. Green lives in the
// photography, not the interface.
---

<style is:inline>
  :root {
    --fluvio-paper: 251 252 250;
    --fluvio-mist: 241 246 248;
    --fluvio-ink: 19 32 42;
    --fluvio-navy: 23 59 87;
    --fluvio-river: 47 125 148;
    --fluvio-teal: 59 133 135;
    --fluvio-mineral: 112 137 173;
    --fluvio-silt: 195 154 91;
    --fluvio-coral: 217 118 91;

    /* Derived supporting tones */
    --fluvio-wash: 219 233 238; /* pale river wash for fields and selection */
    --fluvio-slate: 71 88 101; /* accessible muted text on paper */
    --fluvio-silt-deep: 138 100 44; /* silt darkened for small text accents */

    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-instrument-serif);
    --aw-font-heading: var(--font-bricolage);
    --aw-font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;

    --aw-color-primary: rgb(var(--fluvio-river));
    --aw-color-secondary: rgb(var(--fluvio-navy));
    --aw-color-accent: rgb(var(--fluvio-teal));

    --aw-color-text-heading: rgb(var(--fluvio-ink));
    --aw-color-text-default: rgb(var(--fluvio-ink));
    --aw-color-text-muted: rgb(var(--fluvio-slate));
    --aw-color-bg-page: rgb(var(--fluvio-paper));

    --aw-color-bg-page-dark: rgb(var(--fluvio-ink));

    ::selection {
      background-color: rgb(var(--fluvio-wash));
      color: rgb(var(--fluvio-ink));
    }
  }

  .dark {
    --fluvio-wash: 36 74 100; /* deep navy wash for dark fields */
    --fluvio-slate: 156 176 190; /* accessible muted text on ink */
    --fluvio-silt-deep: 214 178 122; /* silt lightened for dark-theme accents */

    --aw-color-primary: rgb(107 177 196);
    --aw-color-secondary: rgb(140 198 213);
    --aw-color-accent: rgb(125 186 188);

    --aw-color-text-heading: rgb(var(--fluvio-mist));
    --aw-color-text-default: rgb(215 227 234);
    --aw-color-text-muted: rgb(var(--fluvio-slate));
    --aw-color-bg-page: rgb(var(--fluvio-ink));

    ::selection {
      background-color: rgb(var(--fluvio-navy));
      color: rgb(var(--fluvio-mist));
    }
  }
</style>
