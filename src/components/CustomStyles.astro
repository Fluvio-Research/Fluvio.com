---
// Inter is self-hosted by Astro's native Fonts API and remains the single
// sans family for body and display text. Serif and mono stacks are reserved
// for occasional emphasis and compact labels.
---

<style is:inline>
  :root {
    --fluvio-ink: 23 37 31;
    --fluvio-paper: 245 248 245;
    --fluvio-water: 57 122 120;
    --fluvio-aqua: 220 235 231;
    --fluvio-mineral: 95 109 103;

    --aw-font-sans: var(--font-inter);
    --aw-font-serif: Georgia, 'Times New Roman', serif;
    --aw-font-heading: var(--font-inter);
    --aw-font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;

    --aw-color-primary: rgb(var(--fluvio-water));
    --aw-color-secondary: rgb(43 98 96);
    --aw-color-accent: rgb(var(--fluvio-water));

    --aw-color-text-heading: rgb(var(--fluvio-ink));
    --aw-color-text-default: rgb(var(--fluvio-ink));
    --aw-color-text-muted: rgb(var(--fluvio-mineral));
    --aw-color-bg-page: rgb(var(--fluvio-paper));

    --aw-color-bg-page-dark: rgb(var(--fluvio-ink));

    ::selection {
      background-color: rgb(var(--fluvio-aqua));
      color: rgb(var(--fluvio-ink));
    }
  }

  .dark {
    --aw-color-primary: rgb(122 183 178);
    --aw-color-secondary: rgb(145 201 196);
    --aw-color-accent: rgb(122 183 178);

    --aw-color-text-heading: rgb(var(--fluvio-paper));
    --aw-color-text-default: rgb(226 235 230);
    --aw-color-text-muted: rgb(173 188 181);
    --aw-color-bg-page: rgb(var(--fluvio-ink));

    ::selection {
      background-color: rgb(var(--fluvio-water));
      color: rgb(var(--fluvio-paper));
    }
  }
</style>
