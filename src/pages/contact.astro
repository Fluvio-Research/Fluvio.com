---
import LargeImage from '~/components/fluvio/LargeImage.astro';
import SectionFrame from '~/components/fluvio/SectionFrame.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Contact',
  description: 'Start a conversation with Fluvio about a water, environmental or climate project.',
};

const reveal = 'intersect-once intersect-quarter motion-safe:intersect:animate-fade';
---

<Layout metadata={metadata}>
  <header class="fluvio-contact-hero">
    <div class="fluvio-shell fluvio-contact-hero__grid">
      <div>
        <p class="fluvio-eyebrow">Contact</p>
        <h1 class="fluvio-title">Start with the place, problem and decision.</h1>
        <p class="fluvio-lede">
          Tell us about the water, environmental or climate challenge your team is working through.
        </p>
      </div>
      <LargeImage
        src="~/assets/images/fluvio/home-river.jpg"
        alt="A river landscape viewed from above"
        aspect="portrait"
        priority
      />
    </div>
  </header>

  <SectionFrame tone="paper" rule="ink" motif="contour" labelledby="contact-enquiry-heading">
    <div class="fluvio-contact-grid">
      <h2 id="contact-enquiry-heading" class:list={['fluvio-display', reveal]}>Project enquiry</h2>
      <div class:list={['fluvio-contact-body', reveal]}>
        <p>
          Include the project location, the environmental system involved and the decision or operational need you want
          to support.
        </p>
        <a
          class="fluvio-link"
          href="mailto:?subject=Project%20enquiry%20for%20Fluvio&body=Project%20location%3A%0A%0AEnvironmental%20system%3A%0A%0ADecision%20or%20operational%20need%3A%0A%0AProject%20context%3A"
        >
          Open a project enquiry <span aria-hidden="true">→</span>
        </a>
        <p class="fluvio-contact-note">
          This opens a draft in your email application. Nothing is submitted through this website, and the archived site
          does not provide a public direct email address.
        </p>
      </div>
    </div>
  </SectionFrame>

  <SectionFrame tone="mist" rule="ink" labelledby="contact-social-heading">
    <div class="fluvio-contact-grid">
      <h2 id="contact-social-heading" class:list={['fluvio-display', reveal]}>Follow Fluvio</h2>
      <div class:list={['fluvio-contact-body', reveal]}>
        <p>See company updates and current work through the verified Fluvio company page.</p>
        <a class="fluvio-link" href="https://www.linkedin.com/company/fluvioptyltd/" rel="noopener noreferrer">
          Fluvio on LinkedIn <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </SectionFrame>
</Layout>

<style>
  .fluvio-contact-hero {
    padding: clamp(3rem, 7vw, 6rem) 0 clamp(5rem, 11vw, 10rem);
  }

  .fluvio-contact-hero__grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .fluvio-contact-hero :global(h1) {
    max-width: 12ch;
  }

  .fluvio-contact-hero :global(.fluvio-lede) {
    max-width: 35rem;
  }

  .fluvio-contact-grid {
    display: grid;
    gap: 2rem;
  }

  .fluvio-contact-body > p:first-child {
    margin: 0 0 1.75rem;
    max-width: 42rem;
    color: var(--aw-color-text-muted);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .fluvio-contact-note {
    margin: 1.5rem 0 0;
    max-width: 42rem;
    color: var(--aw-color-text-muted);
    font-size: 0.82rem;
    line-height: 1.65;
  }

  @media (min-width: 768px) {
    .fluvio-contact-hero__grid {
      grid-template-columns: minmax(0, 0.86fr) minmax(24rem, 1.14fr);
      gap: clamp(3rem, 8vw, 8rem);
    }

    .fluvio-contact-grid {
      grid-template-columns: minmax(15rem, 0.65fr) minmax(24rem, 1.35fr);
      gap: clamp(4rem, 10vw, 10rem);
      align-items: start;
    }
  }
</style>
