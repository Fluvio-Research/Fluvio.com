---
import ContactPanel from '~/components/fluvio/ContactPanel.astro';
import LargeImage from '~/components/fluvio/LargeImage.astro';
import SectionFrame from '~/components/fluvio/SectionFrame.astro';
import SectionHeading from '~/components/fluvio/SectionHeading.astro';
import TeamProfile from '~/components/fluvio/TeamProfile.astro';
import { teamMembers } from '~/data/fluvio/team';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Team',
  description:
    'Meet the Fluvio team working across hydrology, environmental science, carbon, spatial analysis and data systems.',
};

const reveal = 'intersect-once intersect-quarter motion-safe:intersect:animate-fade';
---

<Layout metadata={metadata}>
  <header class="fluvio-team-hero">
    <div class="fluvio-shell fluvio-team-hero__grid">
      <div>
        <p class="fluvio-eyebrow">Team</p>
        <h1 class="fluvio-title">Many disciplines. One environmental practice.</h1>
        <p class="fluvio-lede">
          Specialists working together across field science, environmental systems and applied technology.
        </p>
      </div>
      <LargeImage
        src="~/assets/images/fluvio/vision-field-team.jpeg"
        alt="Fluvio specialists working together in the field"
        aspect="landscape"
        priority
      />
    </div>
  </header>

  <SectionFrame
    tone="paper"
    rule="ink"
    motif="contour"
    spacing="standard"
    labelledby="team-directory-heading"
    class="fluvio-team-directory"
  >
    <div id="team-directory-heading" class:list={['fluvio-team-heading', reveal]}>
      <SectionHeading
        title="People behind the work"
        intro="The team brings research, industry and regional experience to complex water, climate and environmental challenges."
      />
    </div>
    <div class="fluvio-team-grid">
      {
        teamMembers.map((member) => (
          <div class:list={['fluvio-team-cell', reveal]}>
            <TeamProfile member={member} headingLevel="h2" />
          </div>
        ))
      }
    </div>
  </SectionFrame>

  <SectionFrame tone="warm">
    <div class={reveal}>
      <ContactPanel
        eyebrow=""
        title="Bring the right mix of expertise to your project."
        intro="Tell us about the system, place or decision your team is working through."
      />
    </div>
  </SectionFrame>
</Layout>

<style>
  .fluvio-team-hero {
    padding: clamp(3rem, 7vw, 6rem) 0 clamp(4.5rem, 10vw, 9rem);
  }

  .fluvio-team-hero__grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .fluvio-team-hero :global(h1) {
    max-width: 12ch;
  }

  .fluvio-team-hero :global(.fluvio-lede) {
    max-width: 35rem;
  }

  .fluvio-team-directory {
    padding-bottom: clamp(5rem, 12vw, 11rem);
  }

  .fluvio-team-heading {
    margin-bottom: clamp(3.5rem, 8vw, 7rem);
  }

  .fluvio-team-grid {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem) clamp(2rem, 4vw, 3.5rem);
  }

  @media (min-width: 768px) {
    .fluvio-team-hero__grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(24rem, 1.15fr);
      gap: clamp(3rem, 8vw, 8rem);
    }

    .fluvio-team-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: start;
    }
  }
</style>
