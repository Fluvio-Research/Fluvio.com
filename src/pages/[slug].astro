---
import ProjectDetailPage from '~/components/pages/ProjectDetailPage.astro';
import { projects } from '~/data/fluvio/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

import type { Project } from '~/data/fluvio/types';

interface Props {
  project: Project;
}

const { project } = Astro.props as Props;
---

<ProjectDetailPage locale="en" project={project} />
