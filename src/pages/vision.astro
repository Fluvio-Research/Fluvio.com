---
import ContactPanel from '~/components/fluvio/ContactPanel.astro';
import LargeImage from '~/components/fluvio/LargeImage.astro';
import SectionHeading from '~/components/fluvio/SectionHeading.astro';
import { siteContent } from '~/data/fluvio/site';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Vision',
  description: siteContent.vision.description,
};
---

<Layout metadata={metadata}>
  <header class="fluvio-vision-hero">
    <div class="fluvio-vision-shell fluvio-vision-hero__copy">
      <p class="fluvio-vision-eyebrow">Vision</p>
      <h1>Healthier water systems. More resilient communities.</h1>
      <p>Knowledge and technology can help secure a thriving planet for current and future generations.</p>
    </div>
    <div class="fluvio-vision-shell fluvio-vision-shell--wide">
      <LargeImage
        src={siteContent.vision.image}
        alt={siteContent.vision.imageAlt}
        aspect="hero"
        priority
        sizes="(min-width: 1440px) 1408px, (min-width: 768px) calc(100vw - 4rem), calc(100vw - 2rem)"
      />
    </div>
  </header>

  <section class="fluvio-vision-statement" aria-labelledby="vision-statement-heading">
    <div class="fluvio-vision-shell fluvio-vision-statement__grid">
      <h2 id="vision-statement-heading">Why Fluvio exists</h2>
      <p>{siteContent.vision.description}</p>
    </div>
  </section>

  <section class="fluvio-vision-values" aria-labelledby="vision-values-heading">
    <div class="fluvio-vision-shell">
      <div id="vision-values-heading" class="fluvio-vision-section-heading">
        <SectionHeading
          title="Five values guide the work"
          intro="They shape how Fluvio develops technology, works with partners and supports long-term environmental outcomes."
        />
      </div>
      <div class="fluvio-vision-values__grid">
        {
          siteContent.values.map((value) => (
            <article>
              <h3>{value.title}</h3>
              <p>{value.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="fluvio-vision-practice" aria-labelledby="vision-practice-heading">
    <div class="fluvio-vision-shell fluvio-vision-practice__grid">
      <div>
        <h2 id="vision-practice-heading">A regional practice, grounded in place</h2>
        <p>
          Fluvio works across Australian and Melanesian water systems, combining field evidence with tools that fit local
          conditions and operational needs.
        </p>
        <p>
          Collaboration is part of delivery. Monitoring, data management and training are developed with the people who
          will use and sustain them.
        </p>
      </div>
      <LargeImage
        src="~/assets/images/fluvio/vision-field-team.jpeg"
        alt="A Fluvio field team working together"
        aspect="landscape"
      />
    </div>
  </section>

  <section class="fluvio-vision-contact">
    <div class="fluvio-vision-shell">
      <ContactPanel
        eyebrow="Projects and partnerships"
        title="Work towards a more resilient water future with us."
        intro="Bring us the water, environmental or climate challenge you are working through."
      />
    </div>
  </section>
</Layout>

<style>
  .fluvio-vision-shell {
    width: min(100% - 2rem, 72rem);
    margin-inline: auto;
  }

  .fluvio-vision-shell--wide {
    width: min(100% - 2rem, 88rem);
  }

  .fluvio-vision-hero {
    padding: clamp(3rem, 7vw, 6rem) 0 clamp(4.5rem, 10vw, 9rem);
  }

  .fluvio-vision-hero__copy {
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }

  .fluvio-vision-eyebrow {
    margin: 0 0 1.25rem;
    color: rgb(var(--fluvio-water));
    font-family: var(--aw-font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    max-width: 14ch;
    color: var(--aw-color-text-heading);
    font-family: var(--aw-font-heading);
    font-size: clamp(3.25rem, 7.5vw, 7rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.94;
  }

  .fluvio-vision-hero__copy > p:last-child {
    margin: clamp(1.75rem, 4vw, 3rem) 0 0 auto;
    max-width: 38rem;
    color: var(--aw-color-text-muted);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.65;
  }

  .fluvio-vision-statement,
  .fluvio-vision-values,
  .fluvio-vision-practice {
    padding: clamp(4.5rem, 10vw, 9rem) 0;
  }

  .fluvio-vision-statement {
    border-top: 1px solid rgb(var(--fluvio-ink) / 0.15);
  }

  .fluvio-vision-statement__grid {
    display: grid;
    gap: 2rem;
  }

  .fluvio-vision-statement h2,
  .fluvio-vision-practice h2 {
    margin: 0;
    color: var(--aw-color-text-heading);
    font-family: var(--aw-font-heading);
    font-size: clamp(2.4rem, 5vw, 4.75rem);
    font-weight: 520;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .fluvio-vision-statement p {
    margin: 0;
    color: var(--aw-color-text-muted);
    font-size: clamp(1.2rem, 2.4vw, 1.65rem);
    line-height: 1.65;
  }

  .fluvio-vision-values {
    background: rgb(var(--fluvio-aqua) / 0.12);
  }

  .fluvio-vision-section-heading {
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }

  .fluvio-vision-values__grid {
    display: grid;
    gap: 0 2rem;
  }

  .fluvio-vision-values article {
    padding: 2rem 0;
    border-top: 1px solid rgb(var(--fluvio-ink) / 0.16);
  }

  .fluvio-vision-values h3 {
    margin: 0 0 1rem;
    color: var(--aw-color-text-heading);
    font-family: var(--aw-font-heading);
    font-size: clamp(1.6rem, 3vw, 2.5rem);
    font-weight: 540;
    letter-spacing: -0.035em;
  }

  .fluvio-vision-values p,
  .fluvio-vision-practice p {
    margin: 0;
    max-width: 38rem;
    color: var(--aw-color-text-muted);
    line-height: 1.75;
  }

  .fluvio-vision-practice__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .fluvio-vision-practice h2 {
    margin-bottom: 1.5rem;
  }

  .fluvio-vision-practice p + p {
    margin-top: 1rem;
  }

  .fluvio-vision-contact {
    padding: 0 0 clamp(4.5rem, 10vw, 9rem);
  }

  :global(.dark) .fluvio-vision-statement,
  :global(.dark) .fluvio-vision-values article {
    border-color: rgb(var(--fluvio-paper) / 0.16);
  }

  @media (min-width: 768px) {
    .fluvio-vision-shell {
      width: min(100% - 4rem, 72rem);
    }

    .fluvio-vision-shell--wide {
      width: min(100% - 4rem, 88rem);
    }

    .fluvio-vision-statement__grid {
      grid-template-columns: minmax(15rem, 0.6fr) minmax(0, 1.4fr);
      gap: clamp(4rem, 10vw, 10rem);
    }

    .fluvio-vision-values__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(3rem, 8vw, 8rem);
    }

    .fluvio-vision-values article:nth-child(5) {
      grid-column: 2;
    }

    .fluvio-vision-practice__grid {
      grid-template-columns: minmax(20rem, 0.78fr) minmax(0, 1.22fr);
      gap: clamp(4rem, 10vw, 10rem);
    }
  }
</style>
