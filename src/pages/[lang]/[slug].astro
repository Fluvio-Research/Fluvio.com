---
import ProjectDetailPage from '~/components/pages/ProjectDetailPage.astro';
import { getProjects } from '~/data/fluvio/localized';
import type { Project } from '~/data/fluvio/types';
import { localeRecordStaticPaths, type Locale } from '~/i18n';

export function getStaticPaths() {
  return localeRecordStaticPaths(getProjects, (project) => ({ slug: project.slug }));
}

const { lang } = Astro.params as { lang: Locale };
const { record } = Astro.props as { record: Project };
---

<ProjectDetailPage locale={lang} project={record} />
