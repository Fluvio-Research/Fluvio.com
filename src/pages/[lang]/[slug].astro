---
import ProjectDetailPage from '~/components/pages/ProjectDetailPage.astro';
import { getProjects } from '~/data/fluvio/localized';
import type { Project } from '~/data/fluvio/types';
import type { Locale } from '~/i18n';

export function getStaticPaths() {
  return (['pis', 'fr', 'es'] as const).flatMap((lang) =>
    getProjects(lang).map((project) => ({ params: { lang, slug: project.slug }, props: { project } }))
  );
}

const { lang } = Astro.params as { lang: Locale };
const { project } = Astro.props as { project: Project };
---

<ProjectDetailPage locale={lang} project={project} />
