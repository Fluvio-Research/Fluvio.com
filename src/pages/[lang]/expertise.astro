---
import ExpertisePage from '~/components/pages/ExpertisePage.astro';
import type { Locale } from '~/i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'fr' } }, { params: { lang: 'es' } }];
}

const { lang } = Astro.params as { lang: Locale };
---

<ExpertisePage locale={lang} />
