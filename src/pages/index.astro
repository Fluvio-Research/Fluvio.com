---
import ContactPanel from '~/components/fluvio/ContactPanel.astro';
import HeroSlider from '~/components/fluvio/HeroSlider.astro';
import PlatformFeature from '~/components/fluvio/PlatformFeature.astro';
import ProjectFeature from '~/components/fluvio/ProjectFeature.astro';
import SectionHeading from '~/components/fluvio/SectionHeading.astro';
import TeamProfile from '~/components/fluvio/TeamProfile.astro';
import { expertiseAreas } from '~/data/fluvio/expertise';
import { featuredProjects } from '~/data/fluvio/projects';
import { siteContent } from '~/data/fluvio/site';
import { teamMembers } from '~/data/fluvio/team';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: siteContent.name,
  description: siteContent.summary,
  ignoreTitleTemplate: true,
};

const capabilities = [
  {
    title: 'Monitoring systems',
    description: 'Non-contact sensing, real-time water quality networks and operational data tools.',
  },
  {
    title: 'Water modelling',
    description: 'Catchment, coastal pollution and resource models grounded in environmental evidence.',
  },
  {
    title: 'Project delivery',
    description: 'Field programs and practical systems developed alongside clients, communities and operators.',
  },
];

const selectedExpertise = expertiseAreas.slice(0, 4);
const selectedTeam = teamMembers.slice(0, 3);
---

<Layout metadata={metadata}>
  <HeroSlider />

  <section class="fluvio-home-capabilities" aria-label="Core capabilities">
    <div class="fluvio-home-shell fluvio-home-capability-grid">
      {
        capabilities.map((capability) => (
          <article>
            <h2>{capability.title}</h2>
            <p>{capability.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="fluvio-home-section" aria-labelledby="home-expertise-heading">
    <div class="fluvio-home-shell">
      <div id="home-expertise-heading" class="fluvio-home-heading">
        <SectionHeading
          eyebrow="Expertise"
          title="Evidence that moves from field conditions to decisions"
          intro="Our team combines water science, environmental monitoring and data systems around the needs of each place and project."
        />
      </div>
      <div class="fluvio-home-expertise-list">
        {
          selectedExpertise.map((area) => (
            <a href={`/expertise#${area.slug}`}>
              <span>{area.title}</span>
              <span aria-hidden="true">→</span>
            </a>
          ))
        }
      </div>
      <a class="fluvio-home-text-link" href="/expertise">View all six capability areas <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="fluvio-home-section fluvio-home-section--projects" aria-labelledby="home-projects-heading">
    <div class="fluvio-home-shell">
      <header class="fluvio-home-project-heading">
        <h2 id="home-projects-heading">Selected projects</h2>
        <p>Current work across hydrological monitoring, water supply and climate-resilient infrastructure.</p>
      </header>
      <div class="fluvio-home-project-list">
        {
          featuredProjects.map((project, index) => (
            <ProjectFeature project={project} eyebrow={index === 0 ? 'Featured work' : ''} />
          ))
        }
      </div>
      <a class="fluvio-home-text-link" href="/projects">Explore every project <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="fluvio-home-section fluvio-home-section--platforms" aria-labelledby="home-platforms-heading">
    <div class="fluvio-home-shell">
      <header class="fluvio-home-platform-heading">
        <h2 id="home-platforms-heading">Monitoring data, made operational</h2>
        <p>Purpose-built platforms connect environmental observations with analysis, reporting and action.</p>
      </header>
      <div class="fluvio-home-platform-grid">
        <PlatformFeature
          title="FluvioSense"
          description="A web-based platform to communicate stereo vision and real-time data analytics across flood and water camera networks."
          href="https://sense.fluvio.com.au/"
          actionLabel="Visit FluvioSense"
        />
        <PlatformFeature
          title="FluvioCascade"
          description="A web-based platform that ingests real-time environmental monitoring data to support analysis, reporting and alerts."
        />
      </div>
    </div>
  </section>

  <section class="fluvio-home-section" aria-labelledby="home-team-heading">
    <div class="fluvio-home-shell">
      <div id="home-team-heading" class="fluvio-home-heading">
        <SectionHeading
          title="Science, technology and delivery in one team"
          intro="Fluvio brings together specialists in hydrology, carbon, environmental science, spatial analysis and data systems."
        />
      </div>
      <div class="fluvio-home-team-grid">
        {selectedTeam.map((member) => <TeamProfile member={member} />)}
      </div>
      <a class="fluvio-home-text-link" href="/team">Meet the full team <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="fluvio-home-impact" aria-labelledby="home-impact-heading">
    <div class="fluvio-home-shell fluvio-home-impact-grid">
      <h2 id="home-impact-heading">Built with partners across Australia and Melanesia.</h2>
      <div>
        <p>
          Our work spans Queensland, Australian reservoirs, Honiara, the Tina River, Bina Harbour and Rennell Island.
          Programs are shaped with government, utilities, communities and regional organisations.
        </p>
        <p>
          Delivery includes field monitoring, operational data systems, training and environmental assessment, with a
          focus on lasting local capability.
        </p>
      </div>
    </div>
  </section>

  <section class="fluvio-home-contact">
    <div class="fluvio-home-shell">
      <ContactPanel />
    </div>
  </section>
</Layout>

<style>
  .fluvio-home-shell {
    width: min(100% - 2rem, 80rem);
    margin-inline: auto;
  }

  .fluvio-home-section {
    padding: clamp(4.5rem, 10vw, 9rem) 0;
  }

  .fluvio-home-heading {
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }

  .fluvio-home-capabilities {
    padding: clamp(2.25rem, 5vw, 4rem) 0;
    border-top: 1px solid rgb(var(--fluvio-ink) / 0.16);
    border-bottom: 1px solid rgb(var(--fluvio-ink) / 0.16);
  }

  .fluvio-home-capability-grid {
    display: grid;
    gap: 2rem;
  }

  .fluvio-home-capability-grid article {
    display: grid;
    gap: 0.75rem;
  }

  .fluvio-home-capability-grid h2 {
    margin: 0;
    color: var(--aw-color-text-heading);
    font-family: var(--aw-font-heading);
    font-size: 1.1rem;
    font-weight: 620;
    letter-spacing: -0.015em;
  }

  .fluvio-home-capability-grid p {
    margin: 0;
    max-width: 31rem;
    color: var(--aw-color-text-muted);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .fluvio-home-expertise-list {
    display: grid;
    max-width: 64rem;
    margin-left: auto;
  }

  .fluvio-home-expertise-list a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 1.35rem 0;
    border-bottom: 1px solid rgb(var(--fluvio-ink) / 0.15);
    color: var(--aw-color-text-heading);
    font-family: var(--aw-font-heading);
    font-size: clamp(1.3rem, 2.5vw, 2.15rem);
    font-weight: 520;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .fluvio-home-text-link {
    display: inline-flex;
    gap: 0.5rem;
    margin-top: 2rem;
    border-bottom: 1px solid currentColor;
    color: rgb(var(--fluvio-water));
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
  }

  .fluvio-home-project-heading,
  .fluvio-home-platform-heading {
    max-width: 54rem;
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }

  .fluvio-home-project-heading h2,
  .fluvio-home-platform-heading h2,
  .fluvio-home-impact h2 {
    margin: 0;
    color: var(--aw-color-text-heading);
    font-family: var(--aw-font-heading);
    font-size: clamp(2.5rem, 5vw, 4.75rem);
    font-weight: 520;
    letter-spacing: -0.05em;
    line-height: 0.98;
  }

  .fluvio-home-project-heading p,
  .fluvio-home-platform-heading p {
    margin: 1.5rem 0 0;
    max-width: 42rem;
    color: var(--aw-color-text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .fluvio-home-project-list {
    display: grid;
    gap: clamp(5rem, 11vw, 10rem);
  }

  .fluvio-home-project-list > :global(.fluvio-project-feature:nth-child(2)) {
    width: min(100%, 70rem);
    margin-left: auto;
  }

  .fluvio-home-project-list > :global(.fluvio-project-feature:nth-child(3)) {
    width: min(100%, 74rem);
  }

  .fluvio-home-section--platforms {
    background: rgb(var(--fluvio-aqua) / 0.12);
  }

  .fluvio-home-platform-grid {
    display: grid;
    gap: 2rem;
  }

  .fluvio-home-team-grid {
    display: grid;
    gap: 3rem;
  }

  .fluvio-home-impact {
    padding: clamp(5rem, 12vw, 11rem) 0;
    border-top: 1px solid rgb(var(--fluvio-ink) / 0.15);
  }

  .fluvio-home-impact-grid {
    display: grid;
    gap: 2.5rem;
  }

  .fluvio-home-impact h2 {
    max-width: 15ch;
  }

  .fluvio-home-impact p {
    margin: 0 0 1.2rem;
    max-width: 45rem;
    color: var(--aw-color-text-muted);
    font-size: clamp(1.05rem, 1.7vw, 1.25rem);
    line-height: 1.75;
  }

  .fluvio-home-contact {
    padding: 0 0 clamp(4.5rem, 10vw, 9rem);
  }

  a:focus-visible {
    border-radius: 4px;
    outline: 2px solid rgb(var(--fluvio-water));
    outline-offset: 4px;
  }

  :global(.dark) .fluvio-home-capabilities,
  :global(.dark) .fluvio-home-impact,
  :global(.dark) .fluvio-home-expertise-list a {
    border-color: rgb(var(--fluvio-paper) / 0.16);
  }

  @media (min-width: 768px) {
    .fluvio-home-shell {
      width: min(100% - 4rem, 80rem);
    }

    .fluvio-home-capability-grid {
      grid-template-columns: 1.15fr 0.85fr 1fr;
      gap: clamp(2rem, 5vw, 5rem);
    }

    .fluvio-home-platform-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: clamp(3rem, 8vw, 8rem);
    }

    .fluvio-home-team-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: clamp(1.5rem, 3vw, 3rem);
      align-items: start;
    }

    .fluvio-home-team-grid > :global(.fluvio-team-profile:nth-child(1)) {
      grid-column: span 5;
    }

    .fluvio-home-team-grid > :global(.fluvio-team-profile:nth-child(2)) {
      grid-column: span 3;
      margin-top: 5rem;
    }

    .fluvio-home-team-grid > :global(.fluvio-team-profile:nth-child(3)) {
      grid-column: span 4;
      margin-top: 1.5rem;
    }

    .fluvio-home-impact-grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(24rem, 1.1fr);
      gap: clamp(4rem, 10vw, 10rem);
      align-items: start;
    }
  }
</style>
