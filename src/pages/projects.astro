---
import Layout from '~/layouts/PageLayout.astro';
import ContactPanel from '~/components/fluvio/ContactPanel.astro';
import PlatformFeature from '~/components/fluvio/PlatformFeature.astro';
import ProjectFeature from '~/components/fluvio/ProjectFeature.astro';
import ProjectListItem from '~/components/fluvio/ProjectListItem.astro';
import SectionFrame from '~/components/fluvio/SectionFrame.astro';
import SectionHeading from '~/components/fluvio/SectionHeading.astro';
import { projects } from '~/data/fluvio/projects';

const featuredProject = projects.find(({ slug }) => slug === 'advance-queensland') ?? projects[0];
const remainingProjects = projects.filter(({ slug }) => slug !== featuredProject.slug);

const reveal = 'intersect-once intersect-quarter motion-safe:intersect:animate-fade';

const metadata = {
  title: 'Projects',
  description:
    'Explore Fluvio projects in hydrological monitoring, water resource management, environmental assessment and applied data systems.',
};
---

<Layout metadata={metadata}>
  <header class="fluvio-projects-hero">
    <div class="fluvio-shell">
      <p class="fluvio-eyebrow">Projects</p>
      <h1 class="fluvio-title">Field intelligence for complex environmental systems.</h1>
      <p class="fluvio-lede fluvio-projects-lede">
        We combine practical field science, monitoring technology and data systems to help communities, governments and
        industry make better decisions about water and climate.
      </p>
    </div>
  </header>

  <SectionFrame tone="paper" spacing="flush" ariaLabel="Featured project" class="fluvio-projects-featured">
    <ProjectFeature project={featuredProject} priority />
  </SectionFrame>

  <SectionFrame tone="paper" motif="contour" labelledby="project-list-heading">
    <div class:list={['fluvio-projects-section-heading', reveal]}>
      <SectionHeading
        eyebrow="Selected work"
        title="Across catchments, coastlines and communities"
        intro="Nine projects, each shaped by its place, partners and operational realities."
        align="split"
      />
    </div>
    <h2 id="project-list-heading" class="visually-hidden">All projects</h2>
    <div class="fluvio-projects-list">
      {
        remainingProjects.map((project, index) => (
          <div class={reveal}>
            <ProjectListItem project={project} index={index} reverse={index % 2 === 1} />
          </div>
        ))
      }
    </div>
  </SectionFrame>

  <SectionFrame tone="water" rule="ink" motif="grid" labelledby="platforms-heading" class="fluvio-projects-platforms">
    <div class:list={['fluvio-projects-section-heading', reveal]} id="platforms-heading">
      <SectionHeading
        eyebrow="Platforms"
        title="Environmental data, ready to use"
        intro="Purpose-built tools turn monitoring networks into information that teams can understand and act on."
        align="split"
      />
    </div>
    <div class="fluvio-platform-grid">
      <div class={reveal}>
        <PlatformFeature
          title="FluvioSense"
          description="A web-based platform to communicate stereo vision and real-time data analytics across flood and water camera networks."
          href="https://sense.fluvio.com.au/"
          actionLabel="Visit FluvioSense"
          index={0}
        />
      </div>
      <div class={reveal}>
        <PlatformFeature
          title="FluvioCascade"
          description="A web-based platform that ingests real-time environmental monitoring data to support analysis, reporting and alerts."
          index={1}
        />
      </div>
    </div>
  </SectionFrame>

  <SectionFrame tone="warm">
    <div class={reveal}>
      <ContactPanel />
    </div>
  </SectionFrame>
</Layout>

<style>
  .fluvio-projects-hero {
    padding: clamp(5rem, 12vw, 10rem) 0 clamp(4rem, 9vw, 8rem);
  }

  .fluvio-projects-hero :global(h1) {
    max-width: 13ch;
  }

  .fluvio-projects-lede {
    margin-left: auto;
    max-width: 46rem;
  }

  .fluvio-projects-featured {
    padding-bottom: clamp(4rem, 10vw, 9rem);
  }

  .fluvio-projects-section-heading {
    margin-bottom: clamp(3.5rem, 8vw, 7rem);
  }

  .fluvio-projects-list {
    display: grid;
    gap: clamp(5rem, 11vw, 10rem);
  }

  /* Silt is the platforms section's single supporting accent. */
  .fluvio-projects-platforms :global(.fluvio-platform-feature__eyebrow) {
    color: rgb(var(--fluvio-silt-deep));
  }

  .fluvio-platform-grid {
    display: grid;
    gap: 2rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 768px) {
    .fluvio-platform-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(3rem, 8vw, 8rem);
    }
  }
</style>
