---
import Accent from '~/components/fluvio/Accent.astro';
import ArrowLink from '~/components/fluvio/ArrowLink.astro';
import Layout from '~/layouts/PageLayout.astro';
import { getPermalink } from '~/utils/permalinks';

import { getNavigation, getPages, getUi } from '~/data/fluvio/store.ts';
import { defaultLocale } from '~/i18n';

const copy = getUi(defaultLocale).notFound;
const home = getPages(defaultLocale).common.home;
const nav = getNavigation(defaultLocale);
const metadata = { title: copy.title, description: copy.description };
---

<Layout metadata={metadata}>
  <section class="fluvio-not-found">
    <div class="fluvio-not-found__shell">
      <p class="fluvio-not-found__code">404</p>
      <h1><Accent text={copy.heading} /></h1>
      <p class="fluvio-not-found__intro">{copy.intro}</p>
      <nav aria-label={copy.navigation}>
        <ArrowLink href={getPermalink('/')} variant="pill">{home}</ArrowLink>
        <ArrowLink href={getPermalink('/expertise')} variant="ghost">{nav.expertise}</ArrowLink>
        <ArrowLink href={getPermalink('/projects')} variant="ghost">{nav.projects}</ArrowLink>
      </nav>
    </div>
  </section>
</Layout>

<style>
  .fluvio-not-found {
    display: grid;
    padding-block: var(--fluvio-section-wide);
    align-items: center;
  }

  .fluvio-not-found__shell {
    width: min(100% - 2rem, 72rem);
    margin-inline: auto;
  }

  .fluvio-not-found__code {
    margin: 0 0 1.25rem;
    color: rgb(var(--fluvio-river));
    font-family: var(--aw-font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  h1 {
    margin: 0;
    max-width: 14ch;
    color: var(--aw-color-text-heading);
    font-family: var(--aw-font-heading);
    font-size: clamp(2.9rem, 6.6vw, 6rem);
    font-weight: var(--fluvio-section-weight);
    letter-spacing: -0.025em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .fluvio-not-found__intro {
    margin: 1.75rem 0 2.5rem;
    max-width: 38rem;
    color: var(--aw-color-text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }

  @media (min-width: 768px) {
    .fluvio-not-found__shell {
      width: min(100% - 4rem, 72rem);
    }
  }
</style>
