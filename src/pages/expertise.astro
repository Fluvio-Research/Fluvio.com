---
import LargeImage from '~/components/fluvio/LargeImage.astro';
import SectionFrame from '~/components/fluvio/SectionFrame.astro';
import SectionHeading from '~/components/fluvio/SectionHeading.astro';
import { expertiseAreas } from '~/data/fluvio/expertise';
import { projects } from '~/data/fluvio/projects';
import type { Project } from '~/data/fluvio/types';
import Layout from '~/layouts/PageLayout.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Expertise',
  description:
    'Fluvio expertise in hydrological monitoring, water modelling, resource management, carbon assessment and operational data systems.',
};

const reveal = 'intersect-once intersect-quarter motion-safe:intersect:animate-fade';

const relatedProjects = new Map(
  expertiseAreas.map((area) => [
    area.slug,
    area.relatedProjects
      .map((slug) => projects.find((project) => project.slug === slug))
      .filter((project): project is Project => Boolean(project)),
  ])
);
---

<Layout metadata={metadata}>
  <header class="fluvio-expertise-hero">
    <div class="fluvio-shell">
      <p class="fluvio-eyebrow">Expertise</p>
      <h1 class="fluvio-title">Water intelligence built for real conditions.</h1>
      <p class="fluvio-lede">
        Technical depth across monitoring, modelling and environmental assessment, connected to practical delivery.
      </p>
    </div>
  </header>

  <SectionFrame
    tone="paper"
    rule="ink"
    motif="contour"
    labelledby="expertise-intro-heading"
    class="fluvio-expertise-intro"
  >
    <div id="expertise-intro-heading" class={reveal}>
      <SectionHeading
        title="Six capabilities, one connected environmental practice"
        intro="Each capability draws on field science, data and collaboration, with evidence from projects across Australia and Melanesia."
      />
    </div>
  </SectionFrame>

  <SectionFrame
    tone="paper"
    motif="wash-right"
    spacing="flush"
    ariaLabel="Capability areas"
    class="fluvio-expertise-areas"
  >
    <div class="fluvio-expertise-grid">
      {
        expertiseAreas.map((area) => (
          <article class:list={['fluvio-expertise-area', reveal]} id={area.slug}>
            <LargeImage src={area.image} alt={area.imageAlt} aspect="landscape" />
            <div class="fluvio-expertise-area__body">
              <h2>{area.title}</h2>
              <p class="fluvio-expertise-area__summary">{area.summary}</p>
              {area.description.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
              <div class="fluvio-expertise-area__projects">
                <h3>Related projects</h3>
                <ul>
                  {relatedProjects.get(area.slug)?.map((project) => (
                    <li>
                      <a href={getPermalink(`/${project.slug}`)}>
                        <span>{project.title}</span>
                        <span aria-hidden="true">→</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </SectionFrame>

  <SectionFrame tone="water" rule="ink" motif="grid" labelledby="expertise-team-heading">
    <div class="fluvio-expertise-team__grid">
      <h2 id="expertise-team-heading" class:list={['fluvio-display', reveal]}>The capability is multidisciplinary.</h2>
      <div class={reveal}>
        <p>
          Hydrologists, environmental scientists, spatial analysts and data specialists work together from project
          design through field delivery and operational use.
        </p>
        <a class="fluvio-link" href={getPermalink('/team')}>Meet the Fluvio team <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </SectionFrame>
</Layout>

<style>
  .fluvio-expertise-hero {
    padding: clamp(4rem, 9vw, 8rem) 0 clamp(3.5rem, 8vw, 7rem);
  }

  .fluvio-expertise-hero :global(h1) {
    max-width: 13ch;
  }

  .fluvio-expertise-hero :global(.fluvio-lede) {
    max-width: 40rem;
  }

  .fluvio-expertise-areas {
    padding-bottom: clamp(5rem, 12vw, 11rem);
  }

  .fluvio-expertise-grid {
    display: grid;
    gap: clamp(4rem, 9vw, 8rem) 2rem;
  }

  .fluvio-expertise-area {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }

  .fluvio-expertise-area__body {
    max-width: 38rem;
  }

  .fluvio-expertise-area h2 {
    margin: 0 0 1.1rem;
    color: var(--aw-color-text-heading);
    font-family: var(--aw-font-heading);
    font-size: clamp(1.8rem, 3.5vw, 3.15rem);
    font-weight: 520;
    letter-spacing: -0.04em;
    line-height: 1.03;
  }

  .fluvio-expertise-area__body > p {
    margin: 0 0 0.9rem;
    color: var(--aw-color-text-muted);
    line-height: 1.7;
  }

  .fluvio-expertise-area__body > .fluvio-expertise-area__summary {
    color: var(--aw-color-text-default);
    font-size: 1.05rem;
  }

  .fluvio-expertise-area__projects {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(var(--fluvio-ink) / 0.15);
  }

  .fluvio-expertise-area__projects h3 {
    margin: 0 0 0.75rem;
    color: rgb(var(--fluvio-river));
    font-family: var(--aw-font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .fluvio-expertise-area__projects ul {
    display: grid;
    gap: 0.65rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .fluvio-expertise-area__projects a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    color: var(--aw-color-text-heading);
    font-size: 0.9rem;
    line-height: 1.45;
    text-decoration: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .fluvio-expertise-area__projects a {
      transition: color 200ms ease;
    }

    .fluvio-expertise-area__projects a:hover {
      color: rgb(var(--fluvio-river));
    }
  }

  .fluvio-expertise-team__grid {
    display: grid;
    gap: 2.5rem;
  }

  .fluvio-expertise-team__grid h2 {
    max-width: 15ch;
  }

  .fluvio-expertise-team__grid p {
    margin: 0 0 1.5rem;
    max-width: 42rem;
    color: var(--aw-color-text-muted);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  :global(.dark) .fluvio-expertise-area__projects {
    border-color: rgb(var(--fluvio-mist) / 0.16);
  }

  @media (min-width: 768px) {
    .fluvio-expertise-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(2rem, 5vw, 5rem);
    }

    .fluvio-expertise-area {
      grid-column: span 7;
    }

    .fluvio-expertise-area:nth-child(4n + 2),
    .fluvio-expertise-area:nth-child(4n + 3) {
      grid-column: span 5;
    }

    .fluvio-expertise-team__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(24rem, 1.1fr);
      gap: clamp(4rem, 10vw, 10rem);
      align-items: end;
    }
  }
</style>
