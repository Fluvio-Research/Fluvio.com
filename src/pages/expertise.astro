---
import LargeImage from '~/components/fluvio/LargeImage.astro';
import SectionHeading from '~/components/fluvio/SectionHeading.astro';
import { expertiseAreas } from '~/data/fluvio/expertise';
import { projects } from '~/data/fluvio/projects';
import type { Project } from '~/data/fluvio/types';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Expertise',
  description:
    'Fluvio expertise in hydrological monitoring, water modelling, resource management, carbon assessment and operational data systems.',
};

const relatedProjects = new Map(
  expertiseAreas.map((area) => [
    area.slug,
    area.relatedProjects
      .map((slug) => projects.find((project) => project.slug === slug))
      .filter((project): project is Project => Boolean(project)),
  ])
);
---

<Layout metadata={metadata}>
  <header class="fluvio-expertise-hero">
    <div class="fluvio-expertise-shell">
      <p class="fluvio-expertise-eyebrow">Expertise</p>
      <h1>Water intelligence built for real conditions.</h1>
      <p>
        Technical depth across monitoring, modelling and environmental assessment, connected to practical delivery.
      </p>
    </div>
  </header>

  <section class="fluvio-expertise-intro" aria-labelledby="expertise-intro-heading">
    <div class="fluvio-expertise-shell" id="expertise-intro-heading">
      <SectionHeading
        title="Six capabilities, one connected environmental practice"
        intro="Each capability draws on field science, data and collaboration, with evidence from projects across Australia and Melanesia."
      />
    </div>
  </section>

  <section class="fluvio-expertise-areas" aria-label="Capability areas">
    <div class="fluvio-expertise-shell fluvio-expertise-grid">
      {
        expertiseAreas.map((area) => (
          <article class="fluvio-expertise-area" id={area.slug}>
            <LargeImage src={area.image} alt={area.imageAlt} aspect="landscape" />
            <div class="fluvio-expertise-area__body">
              <h2>{area.title}</h2>
              <p class="fluvio-expertise-area__summary">{area.summary}</p>
              {area.description.map((paragraph) => <p>{paragraph}</p>)}
              <div class="fluvio-expertise-area__projects">
                <h3>Related projects</h3>
                <ul>
                  {
                    relatedProjects.get(area.slug)?.map((project) => (
                      <li>
                        <a href={`/${project.slug}`}>
                          <span>{project.title}</span>
                          <span aria-hidden="true">→</span>
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="fluvio-expertise-team" aria-labelledby="expertise-team-heading">
    <div class="fluvio-expertise-shell fluvio-expertise-team__grid">
      <h2 id="expertise-team-heading">The capability is multidisciplinary.</h2>
      <div>
        <p>
          Hydrologists, environmental scientists, spatial analysts and data specialists work together from project
          design through field delivery and operational use.
        </p>
        <a href="/team">Meet the Fluvio team <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .fluvio-expertise-shell {
    width: min(100% - 2rem, 80rem);
    margin-inline: auto;
  }

  .fluvio-expertise-hero {
    padding: clamp(4rem, 9vw, 8rem) 0 clamp(3.5rem, 8vw, 7rem);
  }

  .fluvio-expertise-eyebrow {
    margin: 0 0 1.25rem;
    color: rgb(var(--fluvio-water));
    font-family: var(--aw-font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    max-width: 13ch;
    color: var(--aw-color-text-heading);
    font-family: var(--aw-font-heading);
    font-size: clamp(3.25rem, 7.5vw, 7rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.94;
  }

  .fluvio-expertise-hero .fluvio-expertise-shell > p:last-child {
    margin: clamp(1.75rem, 4vw, 3rem) 0 0;
    max-width: 40rem;
    color: var(--aw-color-text-muted);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.65;
  }

  .fluvio-expertise-intro {
    padding: clamp(3.5rem, 8vw, 7rem) 0 clamp(4rem, 9vw, 8rem);
    border-top: 1px solid rgb(var(--fluvio-ink) / 0.15);
  }

  .fluvio-expertise-areas {
    padding-bottom: clamp(5rem, 12vw, 11rem);
  }

  .fluvio-expertise-grid {
    display: grid;
    gap: clamp(4rem, 9vw, 8rem) 2rem;
  }

  .fluvio-expertise-area {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }

  .fluvio-expertise-area__body {
    max-width: 38rem;
  }

  .fluvio-expertise-area h2 {
    margin: 0 0 1.1rem;
    color: var(--aw-color-text-heading);
    font-family: var(--aw-font-heading);
    font-size: clamp(1.8rem, 3.5vw, 3.15rem);
    font-weight: 520;
    letter-spacing: -0.04em;
    line-height: 1.03;
  }

  .fluvio-expertise-area__body > p {
    margin: 0 0 0.9rem;
    color: var(--aw-color-text-muted);
    line-height: 1.7;
  }

  .fluvio-expertise-area__body > .fluvio-expertise-area__summary {
    color: var(--aw-color-text-default);
    font-size: 1.05rem;
  }

  .fluvio-expertise-area__projects {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(var(--fluvio-ink) / 0.15);
  }

  .fluvio-expertise-area__projects h3 {
    margin: 0 0 0.75rem;
    color: rgb(var(--fluvio-water));
    font-family: var(--aw-font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .fluvio-expertise-area__projects ul {
    display: grid;
    gap: 0.65rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .fluvio-expertise-area__projects a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    color: var(--aw-color-text-heading);
    font-size: 0.9rem;
    line-height: 1.45;
    text-decoration: none;
  }

  .fluvio-expertise-team {
    padding: clamp(5rem, 11vw, 10rem) 0;
    background: rgb(var(--fluvio-aqua) / 0.12);
  }

  .fluvio-expertise-team__grid {
    display: grid;
    gap: 2.5rem;
  }

  .fluvio-expertise-team h2 {
    margin: 0;
    max-width: 15ch;
    color: var(--aw-color-text-heading);
    font-family: var(--aw-font-heading);
    font-size: clamp(2.5rem, 5vw, 4.75rem);
    font-weight: 520;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .fluvio-expertise-team p {
    margin: 0 0 1.5rem;
    max-width: 42rem;
    color: var(--aw-color-text-muted);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .fluvio-expertise-team a {
    display: inline-flex;
    gap: 0.5rem;
    border-bottom: 1px solid currentColor;
    color: rgb(var(--fluvio-water));
    font-weight: 650;
    text-decoration: none;
  }

  a:focus-visible {
    border-radius: 4px;
    outline: 2px solid rgb(var(--fluvio-water));
    outline-offset: 4px;
  }

  :global(.dark) .fluvio-expertise-intro,
  :global(.dark) .fluvio-expertise-area__projects {
    border-color: rgb(var(--fluvio-paper) / 0.16);
  }

  @media (min-width: 768px) {
    .fluvio-expertise-shell {
      width: min(100% - 4rem, 80rem);
    }

    .fluvio-expertise-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(2rem, 5vw, 5rem);
    }

    .fluvio-expertise-area {
      grid-column: span 7;
    }

    .fluvio-expertise-area:nth-child(4n + 2),
    .fluvio-expertise-area:nth-child(4n + 3) {
      grid-column: span 5;
    }

    .fluvio-expertise-team__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(24rem, 1.1fr);
      gap: clamp(4rem, 10vw, 10rem);
      align-items: end;
    }
  }
</style>
